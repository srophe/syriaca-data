            <bibl xml:id="work-827" ana="#syriaca-hagiographic">
        <title xml:id="name827-3" xml:lang="fr" source="#bib827-1">Moines d’Amid (texte)</title>
        <title xml:id="name827-4" xml:lang="en" source="#bib827-1" srophe:tags="#syriaca-headword">Monks of Amida (text)</title>
        <author ref="http://syriaca.org/person/74" source="#bib827-1" xml:lang="en">John of Ephesus — <foreign xml:lang="syr">ܝܘܚܢܢ ܕܐܦܣܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/827</idno>
        <idno type="number" subtype="BHS">618</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib827-1">ܟܕ ܗܟܝܠ ܐܦ ܡܢ ܩܕܡ ܙܒܢܐ ܕܬܠܬܝܢ ܫܢ̈ܝܢ ܒܟܬܒܐ ܐܚܪܢܐ ܕܥܠ ܪܕܘܦܝܐ: ܐܦ ܥܠ ܟܢܘܫܝܐ ܗܢܐ ܩܕܝܫܐ ܡܕܡ ܡܕܡ ܪܫܝܡ ܗܘ ܠܢ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib827-1">Comme il y a trente ans, dans un autre livre sur la persécution, nous avons aussi retracé en partie l’histoire de cette sainte communauté…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib827-1">ܘܗܠܝܢ ܥܠ ܐܓܘ̈ܢܐ ܗܠܝܢ ܚ̈ܠܝܨܐ ܘܬܟ̈ܬܘܫܐ ܪ̈ܘܪܒܐ. ܕܐܦܠܐ ܗܢܘܢ ܪܚܝܩܝܢ ܡܢ ܓܢܒܪܘܬܐ ܪܘܚܢܝܬܐ ܪܫܡܢ. ܕܫܘܪܝܗܘܢ ܗܘ̣ܐ ܡܢ ܫܢܬ ܬܡܢܡܐܐ ܘܬܠܬܝܢ ܘܬܪ̈ܬܝܢ̣. ܥܕܡܐ ܠܗܫܐ ܕܐܝܬܝܗܿ ܫܢܬ ܬܡܢܡܐܐ ܘܫܒܥܝܢ ܘܬܡܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib827-1">Nous avons écrit ces choses sur ces vaillants combats et grandes luttes qui ne sont pas loin de l’héroïsme spirituel; ils commencèrent en l’an 832 jusqu’à maintenant, an 878.</quote>
          </note>
        </noteGrp>
