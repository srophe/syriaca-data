        <author ref="http://syriaca.org/person/650" source="#bib1341-1" xml:lang="en">Narsai — <foreign xml:lang="syr">ܢܪܣܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1341</idno>
