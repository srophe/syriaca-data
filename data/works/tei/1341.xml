        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1341-1">ܢܦܩ ܣܒܐ ܝܥܩܘܒ ܘܚܙܐ: ܥ̈ܓܠܬܐ ܕܫܕܪ ܝܘܣܦ. ܘܗܝܡܢ ܘܚܕܝ ܪܥܝܢܗ: ܕܩܝܡ ܗܘ ܪܚܘܡܗ ܝܘܣܦ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1341-1">Le vieux Jacob est sorti et a vu les chars qu’a envoyés Joseph; il a cru et son esprit s’est réjoui car son ami Joseph a survécu.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1341-1">ܠܐ ܣܦܩܢܐ ܕܐܫܬܥܐ: ܐܒܠܐ ܕܚܙܝܬ ܒܫܚܩܟ. ܘܠܐ ܣܦܩܢܐ ܕܐܘܕܐ ܠܗ: ܠܐܠܗܐ ܥܠ ܥܘܕܪ̈ܢܘܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1341-1">Je ne suis pas capable de raconter la tristesse que j’ai vue dans ton affliction; et je ne suis pas capable de te remercier Dieu pour ses secours.</quote>
          </note>
        </noteGrp>
