        <title xml:id="name555-2" xml:lang="fr-x-bhs" source="#bib555-1">ʾĒšaʿyā</title>
        <title xml:id="name555-3" xml:lang="fr" source="#bib555-1">Isaïe de Palestine (texte)</title>
        <title xml:id="name555-4" xml:lang="en" source="#bib555-1" srophe:tags="#syriaca-headword">Isaiah of Palestine (text)</title>
        <author ref="http://syriaca.org/person/58" source="#bib555-1" xml:lang="en">Zechariah Rhetor — <foreign xml:lang="syr">ܙܟܪܝܐ ܡܠܝܠܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/555</idno>
        <idno type="number" subtype="BHS">335</idno>
        <idno type="number" subtype="BHO">550</idno>
        <noteGrp type="prolog">
          <desc xml:lang="en">Prolog</desc>
          <note xml:lang="fr" type="prolog">
            <quote source="#bib555-1">J’ai joint 
            aux histoires dites 
            auparavant un troisième 
            homme, un deuxième 
            Isaïe le 
            prophète 
            de notre 
            siècle...
        </quote>
          </note>
          <note xml:lang="syr" type="prolog">
            <quote source="#bib555-1">ܬܠܝܬܝܐ ܢܣܒܬ ܠܬܫ̈ܥܝܬܐ ܕܩܕܡ ܐܬܐܡܪ̈ܝܢ̣. ܐܫܥܝܐ ܢܒܝܐ ܬܪܝܢܐ ܕܗܢܐ ܕܪܐ ܕܝܠܢ...</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib555-1">ܗܢܐ ܬܐܘܕܘܪܐ ܐܝܬܘܗܝ ܗܘܐ ܕܝܪܝܐ ܪܒܐ ܒܡܨܪܝܢ. ܓܒܪܐ ܥܒܕ ܬܕܡܪ̈ܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib555-1">Ce Théodore était un grand moine en Égypte, un thaumaturge.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib555-1">ܘܠܘܬ ܗܘܿ ܕܪܚܝܡ ܠܗ ܫܢܝ. ܟܕ ܫܒܩ ܝܪܬܐ ܘܬܪܝܢܐ ܕܝܠܗ̣. ܠܦܛܪܘܣ ܬܠܡܝܕܗ܀ ܐܝܬ ܠܟ ܬܫ̈ܥܝܬܐ ܕܟ̈ܬܝܒܢ ܕܗܠܝܢ ܬܠܬܐ ܢܗܝܪ̈ܐ ܕܗܘ̣ܘ ܒܗܢܐ ܕܪܐ ܕܝܠܢ... ܘܬܫܬܘܐ ܠܩܘܡܐ ܕܡܠܟܘܬܐ ܕܠܥܠ. ܕܐܠܗܐ ܪܒܐ ܘܦܪܘܩܢ ܝܫܘܥ ܡܫܝܚܐ. ܡܠܟܐ ܕܡ̈ܠܟܐ ܘܡܪܐ ܕܡܪ̈ܘܬܐ. ܕܠܗ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib555-1">Et il partit vers celui qui lui était cher, en laissant come son héritier et second son disciple Pierre. Tu as les histoires écrites de ces trois hommes illustres qui furent en notre siècle… Puisses-tu être jugé digne de te tenir dans le royaume d’en-haut du Dieu grand et de notre Sauveur Jésus-Christ, roi des rois et seigneur des seigneurs. À lui… Amen.</quote>
          </note>
        </noteGrp>
