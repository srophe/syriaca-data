        <title xml:id="name644-2" xml:lang="fr-x-bhs" source="#bib644-1">Panbō</title>
        <title xml:id="name644-3" xml:lang="fr" source="#bib644-1">Panbô (texte)</title>
        <title xml:id="name644-4" xml:lang="en" source="#bib644-1" srophe:tags="#syriaca-headword">Panbo (text)</title>
        <author xml:lang="fr" source="#bib644-1" ref="http://syriaca.org/person/474">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">ʿEnanishoʿ</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܥܢܢܝܫܘܥ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Enanicho</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/644</idno>
        <idno type="BHS">428</idno>
        <idno type="BHO">849</idno>
        <idno type="CPG">6036</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit" source="#bib644-1">
                    <quote>ܒܗ ܕܝܢ ܒܗܢܐ ܛܘܪܐ ܐܝܬ ܗܘܐ ܒܗ ܦܡܒܘ ܡܠܦܢܐ ܕܪܘܚܐ̣ ܘܕܝܘܣܩܪܘܣ ܐܦܣܩܘܦܐ...</quote>
                </note>
          <note xml:lang="fr" type="incipit" source="#bib644-1">
                    <quote>Sur cette même montagne il y avait Pambô, docteur de l’Esprit, et l’évêque Dioscore…</quote>
                </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit" source="#bib644-1">
                    <quote>ܗܕܐ ܓܝܪ ܛܝܒܘܬܐ ܡܬܐܡܪܐ ܗܘܬ ܥܠܘܗܝ ܕܐܝܬ ܗܘܐ ܠܗ ܐܦ ܣܓܝ ܝܬܝܪܐܝܬ ܡܢ ܐܢܛܘܢܝܣ̣ ܘܣܓܝ ܛܝܒܘܬܐ ܡܢ ܗܠܝܢ ܕܡܢ ܩܕܝܡ ܐܝܬ ܗܘܐ ܠܗ ܠܘܬ ܐܠܗܐ̣ ܕܗܘܿܐ ܝܕܥ ܚܝܠܗܿ ܕܡܠܬܐ.</quote>
                </note>
          <note xml:lang="fr" type="explicit" source="#bib644-1">
                    <quote>Et on disait de lui qu’il avait cette grâce bien plus qu’Antoine et qu’il avait envers de Dieu bien plus de grâce que les anciens, qu’il connaissait la force de la parole.</quote>
                </note>
        </noteGrp>
