            <bibl xml:id="work-972" ana="#hagiographic">
        <title xml:id="name972-3" xml:lang="fr" source="#bib972-1">Croix (première invention de la) (texte)</title>
        <title xml:id="name972-4" xml:lang="en" source="#bib972-1" srophe:tags="#syriaca-headword">The First Finding of the Cross (text)</title>
        <idno type="URI">http://syriaca.org/work/972</idno>
        <idno type="BHS">780</idno>
        <idno type="BHO">211</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib972-1">ܐܚܝ̈ ܘܚܒܝ̈ܒܝ. ܦܛܪܘܢܝܩܝ ܐܢܬܬܗ ܕܩܠܘܕܝܘܣ ܩܣܪ: ܗܿܘ ܕܥܒܕܗ ܛܝܒܪܝܘܣ ܬܪܝܢܐ ܕܡܠܟܘܬܗ. ܗܕܐ ܟܕ ܐܝܬܘܗܝ ܗܘܐ ܫܡܥܘܢ ܟܐܦܐ ܒܪܘܡܝ. ܘܚܙܬ ܒܗ ܚܝ̈ܠܐ ܘܬܕܡܪ̈ܬܐ ܕܥܒܕ ܒܫܡ ܝܫܘܥ ܡܫܝܚܐ̣. ܟܦܪܬ ܒܦܬܟܪ̈ܐ ܕܐܒܗ̈ܝܗܿ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib972-1">Mes frères et mes bien-aimés, Protonice, la femme du césar Claude, que Tibère avait fait second de son Empire, alors que Simon Pierre était à Rome, vit en lui les miracles et les prodiges qu’il avait réalisés au nom de Jésus-Christ et renia les idoles de ses pères.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib972-1">ܘܐܚܪܝܐ ܕܚܡܫܬܥܣܪ ܐܝܬܘܗܝ ܝܗܘܕܐ. ܗܿܘ ܕܒܝܘ̈ܡܬܗ ܣܠܩ ܨܠܝܒܐ ܕܬܪ̈ܬܝܢ ܙܒܢ̈ܝܢ ܡܢ ܐܪܥܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib972-1">Et le dernier des quinze fut Jude, aux jours duquel la croix fut déterrée pour la deuxième fois.</quote>
          </note>
        </noteGrp>
