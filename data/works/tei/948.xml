        <title xml:id="name948-2" xml:lang="fr-x-bhs" source="#bib948-1">Tōmā</title>
        <title xml:id="name948-3" xml:lang="fr" source="#bib948-1">Thomas apôtre (Dimanche nouveau) (texte)</title>
        <title xml:id="name948-4" xml:lang="en" source="#bib948-1" srophe:tags="#syriaca-headword">Thomas the Apostle (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib948-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/948</idno>
        <idno type="number" subtype="BHS">751</idno>
        <idno type="number" subtype="BHO">1225</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib948-1">ܟܕ ܩܡ ܪܥܝܐ ܡܢ ܒܝܬ ܡܝ̈ܬܐ ܒܚܝܠܐ ܪܒܐ: ܒܐܬܐ ܕܬܗܪܐ ܣܥܪ ܠܫܠܝܚ̈ܐ ܢܫܪܪ ܐܢܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib948-1">Quand le Pasteur est ressuscité d’entre les morts avec grande force, dans un signe admirable, il visita les apôtres pour les affermir.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib948-1">ܟܠܗܝܢ ܕܒܪܐ ܪܡܢ ܐܢܝܢ ܡܢ ܦܘܫܩܐ: ܒܪܝܟ ܗܘ ܣܓܝܕܐ ܕܐܠܐ ܒܚܘܒܐ ܠܐ ܡܬܡܠܠ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib948-1">Toutes les choses du Fils sont au-delà de toute explication; béni soit l’adoré dont on ne peut parler que par l’amour.</quote>
          </note>
        </noteGrp>
