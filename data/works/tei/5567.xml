      <bibl xml:id="work-5567" type="lawd:ConceptualWork">
        <title xml:id="name5567-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Discourse 22</title>
        <title xml:id="name5567-3" xml:lang="en" source="#bib5567-2">On various [experiences] during prayer and on the limits of the power of the mind. And in how far it has the power to move its arbitrary 
          impulses by the various habits of prayer. And what is the limit prescribed to nature during prayer, the limit which prayer is not allowed to surpass. And how when it has passed it and has proceeded farther, it is no longer prayer, 
          even though what happens is called by the name of prayer</title>
        <title xml:id="name5567-2" xml:lang="syr" source="#bib5567-1"><foreign xml:lang="syr">ܥܠ ܦܘܪ̈ܫܢܐ ܣܓܝ̈ܐܐ ܕܒܨܠܘܬܐ܆ ܘܥܠ ܬܚܘ̈ܡܝ ܫܘܠܛܢܗ ܕܗܘܢܐ.
            ܘܥܕܡܐ ܠܐܝܟܐ ܐܝܬ ܠܗ ܫܘܠܛܢܐ ܠܡܙܥܘ ܠܙܘܥܘ̈ܗܝ ܨܒܝܢܝ̈ܐ ܒܫܘܚܠܦ ܐܣܟܡ̈ܐ ܕܨܠܘܬܐ܆ ܘܕܐܝܢܘ ܬܚܘܡܐ ܕܣܝܡ ܠܟܝܢܐ ܒܨܠܘܬܐ܆ ܕܥܕܡܐ ܠܬܡܢ ܫܠܝܛ ܠܗ ܕܢܨܠܐ. ܘܡܐ ܕܥܒܪ ܡܢ ܬܡܢ ܘܠܗܠ܆ ܠܝܬܝܗ̇ ܡܟܝܠ ܨܠܘܬܐ܆ ܐܦܢ ܒܫܡ ܨܠܘܬܐ ܡܬܐܡܪ ܗܘ ܡܐ ܕܗܘܐ ܗܝܕܝܟ</foreign></title>
        <author ref="http://syriaca.org/person/550" source="#bib5567-1" xml:lang="en">Isaac of Nineveh — <foreign xml:lang="syr">ܐܝܣܚܩ
            ܕܢܝܢܘܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5567</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5567-1"><foreign xml:lang="syr">ܫܘܒܚܐ ܠܗܘ ܕܫܦܝܥܐ ܡܘܗܒܬܗ ܥܠ ܒܢܝ̈ܢܫܐ܆ ܕܟܕ ܒܣܪܢܐ ܐܢܘܢ܆</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5567-2">Glory to Him whose gift has been poured out upon mankind, in that He has ordained that they, although of the flesh,</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5567-1"><foreign xml:lang="syr">ܗܘܝ ܕܛܘܒܘܗܝ ܠܡܢ ܕܡܛܐ ܠܠܐ ܝܕܥܬܐ ܕܠܐ ܡܬܥܒܪܐ܆ ܕܒܨܠܘܬܐ܆ ܐܝܟ ܕܐܡܪ ܐܘܓܪܝܣ.</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5567-2">concerning which Evagrius says: Blessed is he who has reached, during prayer, unconsciousness which is not to be surpassed.</quote>
          </note>
        </noteGrp>
