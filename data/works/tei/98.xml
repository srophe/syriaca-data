        <noteGrp type="prolog">
          <desc xml:lang="en">Prolog</desc>
          <note xml:lang="syr-Syrj" type="prolog">
            <quote source="#bib98-5">ܓܶܠܝܳܢܳܐ ܕܰܗܘܳܐ ܥܰܠ ܝܘܽܚܰܢܳܢ ܐܶܘܰܢܓܶܠܺܝܣܛܰܐ ܡܶܢ ܐܰܠܳܗܳܐ ܒܦܰܛܰܐܡܘܽܢ ܓܳܙܰܪܬܳܐ. ܕܶܐܫܬܕܺܝ ܠܳܗ̇ ܡܶܢ ܢܶܐܪܘܽܢ ܩܰܝܣܰܪ܀</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib98-3">ܓܿܠܝܢܐ ܕܿܝܫܘܼܥ ܡܫܝܚܐ܃ ܕܿܝܗ̱ܒܼ ܠܗ ܐܠܗܐ܃ ܠܡܚܘܝܘܼ ܠܥܒܼܕܿܘܗ̱ܝ̈܂ ܡܐ ܕܿܝܗܝܒܼ ܠܡܗܘܐ ܒܿܥܓܼܠ܂ ܘܫܘܕܿܥ ܟܿܕܼ ܫܠܚ ܒܿܝܕܼ ܡܠܐܟܼܗ܂ ܠܥܒܼܕܿܗ ܝܘܼܚܢܢ܃</quote>
          </note>
        </noteGrp>
