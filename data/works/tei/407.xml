        <title xml:id="name407-2" xml:lang="fr-x-bhs" source="#bib407-1">Dōrōṯēʾōs</title>
        <title xml:id="name407-3" xml:lang="fr" source="#bib407-1">Dorothée (texte)</title>
        <title xml:id="name407-4" xml:lang="en" source="#bib407-1" srophe:tags="#syriaca-headword">Dorotheus (text)</title>
        <author ref="http://syriaca.org/person/474" source="#bib407-1" xml:lang="en">ʿEnanishoʿ — <foreign xml:lang="syr">ܥܢܢܝܫܘܥ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/407</idno>
