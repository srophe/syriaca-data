        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib407-1">ܕܘܪܘܬܐܘܣ ܕܡܢ ܬܒܐܝܣ: ܐܝܢܐ ܕܡܝܬܪ ܗܘ̣ܐ ܒܕܘܒܪ̈ܘܗܝ: ܐܝܬ ܗܘ̣ܐ ܠܗ ܕܝܢ ܕܥܡܪ ܒܡܥܪܬܐ ܚܕܐ ܫܢܝ̈ܐ ܫܬܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib407-1">Dorothée de Thébaïde, homme d’une vie excellente, qui demeura soixante ans dans une grotte.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib407-1">ܗܝܿ ܕܫܡܥܗܿ ܗܘ̣ܐ ܡܢ ܛܘܒܢܐ ܐܢܛܘܢܝܣ: ܟܕ ܗܘܐ ܥܡܗ ܒܡܕܒܪܐ:</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib407-1">Ce qu’il avait entendu du bienheureux Antoine quand il était avec lui dans le désert.</quote>
          </note>
        </noteGrp>
