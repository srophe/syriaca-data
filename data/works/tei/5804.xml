        <title xml:id="name5804-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Palm Sunday</title>
        <title xml:id="name5804-2" xml:lang="en" source="#bib5804-2">Hymn 54 on the Reception of Our Saviour Jesus Christ</title>
        <idno type="URI">http://syriaca.org/work/5804</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" source="#bib5804-1 #bib5804-2">A Syriac liturgical hymn for Palm Sunday organized around the proclamation “Blessed is he that comes in the name of the Lord.” It interprets the praise of children through Davidic prophecy and confesses the one Christ as both Son of David and Son of God. It is hymn 54 in Brooks’s Palm Sunday sequence.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5675-2"> ܒܪܝܟ ܗܘ ܕܐܬܐ ܒܫܡܗ ܕܡܪܝܐ ܐܠܗܐ ܗ̇ܘ ܕܢܒ̈ܝܐ</quote> 
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5675-1">Blessed is he that cometh in the name of the Lord - The God of the prophets</quote>
          </note>
          </noteGrp>
          <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5675-2">ܗ̇ܘ ܕܡܢ ܩܘܡܬܐ ܙܥܘܪܬܐ ܘܠܐ ܡ݂ܒܡܠܝܬܐ ܬܫܒܘܚܬܐ ܓܡ݂ܝܪܬܐ ܘܡܫܡܠܝܬܐ ܫܲܪܪܐ ܘܬܩܲܢܬܐ ܫܡ̣ܚܐ ܠܟ</quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5675-1">who from a tender and incomplete age didst confirm and establish perfect and complete praise, praise to thee!</quote>
          </note>
        </noteGrp>
