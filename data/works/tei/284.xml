        <title xml:id="name284-1" xml:lang="syr" source="#bib284-1" srophe:tags="#syriaca-headword">ܒܕܡܐ</title>
        <title xml:id="name284-2" xml:lang="fr-x-bhs" source="#bib284-1">Badmā</title>
        <title xml:id="name284-3" xml:lang="fr" source="#bib284-1">Badma (texte)</title>
        <title xml:id="name284-4" xml:lang="en" source="#bib284-1" srophe:tags="#syriaca-headword">Badma (text)</title>
        <idno type="URI">http://syriaca.org/work/284</idno>
        <idno type="number" subtype="BHS">63</idno>
        <idno type="number" subtype="BHO">131</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib284-1">ܒܗ ܒܙܒܢܐ ܗܢܐ ܐܬܬܚܕ ܗܘ̣ܐ ܘܐܬܐܣܪ: ܒܦܘܩܕܢܐ ܕܡܠܟܐ: ܒܕܡܐ ܪܫܕܝܪܐ ܡܢ ܒܝܬ ܠܦܛ ܡܕܝܢܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib284-1">En ce même temps l’abbé Badmâ de la ville de Beyt-Lapat fut pris et emprisonné sur ordre du roi.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib284-1">ܐܚ̈ܐ ܕܝܢ ܗܢܿܘܢ ܫܒܥܐ ܕܐܣܝܪܝܢ ܗܘ̣ܘ ܥܡܗ: ܗܘܘ ܒܝܬ ܐܣܝܪ̈ܐ ܫܢܝ̈ܐ ܐܪܒܥ ܘܝܬܝܪ ܩܠܝܠ: ܥܕܡܐ ܕܡܝܬ ܫܒܘܪ ܡܠܟܐ: ܘܗܝܕܝܢ ܐܫܬܪܝܘ ܘܢܦܩܘ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib284-1">Mais ces sept frères, qui avaient été emprisonnés avec lui, restèrent en prison pendant un peu plus de quatre ans, jusqu’à la mort du roi Shabour, et alors ils furent relâchés et sortirent.</quote>
          </note>
        </noteGrp>
