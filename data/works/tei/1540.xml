            <bibl xml:id="work-1540" ana="#syriaca-hagiographic">
        <title xml:id="name1540-1" xml:lang="syr" source="#bib1540-1" srophe:tags="#syriaca-headword">ܩܠܡܣ</title>
        <title xml:id="name1540-2" xml:lang="fr-x-bhs" source="#bib1540-1">Qlēmis</title>
        <title xml:id="name1540-3" xml:lang="fr" source="#bib1540-1">Clément (texte)</title>
        <title xml:id="name1540-4" xml:lang="en" source="#bib1540-1" srophe:tags="#syriaca-headword">Clement (text)</title>
        <idno type="URI">http://syriaca.org/work/1540</idno>
        <idno type="number" subtype="BHS">1448</idno>
        <idno type="number" subtype="BHO">198</idno>
        <idno type="number" subtype="CPG">1015 (4) </idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1540-1">ܒܝܘܡܐ ܕܬܠܬܐ ܒܛܪܝܦܘܠܣ ܟܕ ܡܢ ܩܘܕܡܐ ܡܢ ܫܢܬܗ ܩܡ ܦܛܪܘܣ ܘܠܓܢܬܐ ܥܠ ܗܘܐ. ܐܬܪ ܕܡ̈ܝܐ ܣܓܝ̈ܐܐ ܐܡܝܢܐܝܬ ܪ̈ܕܝܢ ܗܘܘ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1540-1">Le troisième jour à Tripoli, Pierre, s’étant levé plutôt de son sommeil, entra dans le jardin, endroit où des eaux abondantes coulaient continuellement.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1540-1">ܘܟܕ ܕܝܢ ܡܟܝܠ ܪܡܫܐ ܩܕܡܢ ܒܒܝܬܐ ܕܒܝܬ ܡܫܪܝܢ ܥܠܢ ܘܥܡܗ ܟܠܢ ܐܟܚܕܐ ܫܟܒܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1540-1">Et après que le soir nous eut précédés, nous entrâmes dans la maison de l’hôtellerie et nous dormîmes tous ensemble avec lui.</quote>
          </note>
        </noteGrp>
