            <bibl xml:id="work-777" ana="#syriaca-hagiographic">
        <title xml:id="name777-1" xml:lang="syr" source="#bib777-1" srophe:tags="#syriaca-headword">ܝܘܚܢܢ ܒܪ ܐܦܬܘܢܝܐ</title>
        <title xml:id="name777-2" xml:lang="fr-x-bhs" source="#bib777-1">Yōḥanān bar ʾAptōnyā</title>
        <title xml:id="name777-3" xml:lang="fr" source="#bib777-1">Jean bar Aphtonia (texte)</title>
        <title xml:id="name777-4" xml:lang="en" source="#bib777-1" srophe:tags="#syriaca-headword">John bar Aphthonia (text)</title>
        <author xml:lang="fr" source="#bib777-1" ref="http://syriaca.org/person/78">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yuḥanon</forename>
                        <addName type="untagged-title" sort="2">the psaltos</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܘܚܢܢ</forename>
                        <addName type="untagged-title" sort="2">ܦܣܐܠܛܘܣ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jean</forename>
                        <addName type="untagged-title">Psaltès</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/777</idno>
        <idno type="number" subtype="BHS">566</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib777-1">ܪܝܫܐ ܪܒܐ ܘܡܕܒܪܢܐ ܓܒܝܐ ܕܟܢܘܫܝܐ ܕܝܠܢ ܝܘܚܢܢ ܚܟܝܡ ܒܐܠܗܐ̣. ܒܕܡܘܬ ܢܒܝܐ ܫܡܘܐܝܠ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib777-1">Le grand chef et administateur choisi de notre communauté, Jean, sage en Dieu, à l’instar du prophète Samuel…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib777-1">ܗܿܘ ܕܒܨܠܘܬܗ ܡܪܐ ܟܠ̣. ܐܦ ܠܢ ܛܢ̈ܢܐ ܠܡܗܘܐ ܕܗܝܡܢܘܬܗ ܐܫܘܐ ܒܛܝܒܘܬܟ̣. ܘܕܢܫܟܚ ܥܘܬܪܐ ܕܪ̈ܚܡܝܟ ܣܓܝ̈ܐܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib777-1">Par sa prière, Seigneur de tout, juge-nous dignes de devenir jaloux de sa foi par ta grâce et de trouver la richesse de ta grande miséricorde.</quote>
          </note>
        </noteGrp>
