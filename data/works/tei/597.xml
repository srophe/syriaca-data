            <bibl xml:id="work-597" ana="#syriaca-hagiographic">
        <title xml:id="name597-1" xml:lang="syr" source="#bib597-1" srophe:tags="#syriaca-headword">ܝܘܠܝܢܐ ܣܒܐ</title>
        <title xml:id="name597-2" xml:lang="fr-x-bhs" source="#bib597-1">Yōlyānā Sāḇā</title>
        <title xml:id="name597-3" xml:lang="fr" source="#bib597-1">Julien Saba (texte)</title>
        <title xml:id="name597-4" xml:lang="en" source="#bib597-1" srophe:tags="#syriaca-headword">Julian Saba (text)</title>
        <author ref="http://syriaca.org/person/13" source="#bib597-1" xml:lang="en">Ephrem — <foreign xml:lang="syr">ܐܦܪܝܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/597</idno>
        <idno type="number" subtype="BHS">378</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib597-1">ܕܥܘ ܕܠܡܿܢ ܐܣܓܝ ܪܚ̣ܡ ܣܒܐ ܕܡܛܠ ܨܘܬܗ ܨܘܬܐ ܣ̣ܢܐ ܕܐܢܫܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib597-1">Sachez qui Sabâ a beaucoup aimé, celui pour la fréquentation duquel il a haï la fréquentation des hommes.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib597-1">ܬܗܘܐ ܡܪܝ ܨܠܘܬܗ ܚܠܦ ܚܐܪܘܬܝ ܕܒܨܒܝܢܝ ܐܫܬܡܥ ܠܨܒܝܢܟ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib597-1">Que sa prière, Seigneur, soit pour ma liberté, pour que de ma volonté j’obéisse à ta volonté.</quote>
          </note>
        </noteGrp>
