        <title xml:id="name1078-1" xml:lang="syr" source="#bib1078-1" srophe:tags="#syriaca-headword">ܡܪܝܡ ܝܠܕܬ ܐܠܗܐ</title>
        <title xml:id="name1078-2" xml:lang="fr-x-bhs" source="#bib1078-1">Maryam yāldaṯ Alāhā</title>
        <title xml:id="name1078-3" xml:lang="fr" source="#bib1078-1">Marie Mère de Dieu (Visitation) (texte)</title>
        <title xml:id="name1078-4" xml:lang="en" source="#bib1078-1" srophe:tags="#syriaca-headword">Mary Mother of God (Visitation) (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib1078-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1078</idno>
        <idno type="number" subtype="BHS">905</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1078-1">ܒܟ ܡܪܐ ܟܠ ܢܬܬܙܝܥ ܟܢܪܝ ܥܠ ܬܫܒܘܚܬܟ: ܕܒܟ ܗܘ ܣܦܿܩ ܐܝܢܐ ܕܚܒܿܨ ܕܢܡܠܠ ܠܟ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1078-1">Par toi, Seigneur de tout, que ma cithare soi mue pour te glorifier, car tu suffis à celui qui se presse à parler de toi.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1078-1">ܒܡܠܬܐ ܘܩܠܐ ܬܗܪܐ ܪܒܐ ܠܕܦܪܘܫܝܢ: ܒܪܝܟ ܗܘ ܡܠܬܐ ܕܐܟܪܙ ܩܠܐ ܥܠ ܓܠܝܢܗ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1078-1">Dans la parole et la voix il y a un grand étonnement pour les sages; béni soit le Verbe pour la révélation duquel je proclame la parole.</quote>
          </note>
        </noteGrp>
