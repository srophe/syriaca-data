            <bibl xml:id="work-1401" ana="#syriaca-hagiographic">
        <title xml:id="name1401-1" xml:lang="syr" source="#bib1401-1" srophe:tags="#syriaca-headword">ܐܫܥܝܐ</title>
        <title xml:id="name1401-2" xml:lang="fr-x-bhs" source="#bib1401-1">ʾĒšaʿyā</title>
        <title xml:id="name1401-3" xml:lang="fr" source="#bib1401-1">Isaïe de Palestine (texte)</title>
        <title xml:id="name1401-4" xml:lang="en" source="#bib1401-1" srophe:tags="#syriaca-headword">Isaiah of Palestine (text)</title>
        <idno type="URI">http://syriaca.org/work/1401</idno>
        <idno type="number" subtype="BHS">1271</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1401-1">ܛܘܒܢܐ ܗܟܝܠ ܐܒܐ ܐܫܥܝܐ ܒܓܢܣܗ ܐܝܬܘܗܝ ܗܘܐ ܡܨܪܝܐ. ܥܡܿܪ ܕܝܢ ܟܠܗ ܙܒܢܐ ܕܚܝ̈ܘܗܝ ܡܢ ܒܬܪ ܕܐܬܩܪܝ ܡܢ ܛܝܒܘܬܐ ܐܡܐ ܕܝܚܝ̈ܕܝܐ ܠܕܘܒܪܐ ܗܢܐ ܪܚܝܡܐ ܒܛܘܪܐ ܡܫܡܗܐ ܕܐܣܩܛܝܣ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1401-1">Donc le bienheureux Père Isaïe était par sa race Égyptien; il habita tout le temps de sa vie, après qu’il eut été appelé à ce mode de vie bien-aimé par la grâce mère des solitaires, dans la montagne fameuse de Scété.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1401-1">ܥܠ ܡܟܝܟܘܬܗ ܗܟܝܠ ܕܩܕܝܫܐ ܘܥܠ ܫܝܛܘܬ ܝܬܗ ܒܙܥܘܪ̈ܝܬܐ ܕܐܬܐܡܪ ܣܦܩܐܝܬ ܐܬܝܕܥ ܠܣܟܘ̈ܠܬܢܐ ܕܘܒܪܗ ܫܒܝܚܐ ܕܩܕܝܫܐ ܐܒܐ ܐܫܥܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1401-1">Par ce qui a été dit brièvement de l’humilité et du mépris de soi du sain, est suffisamment renseigné aux intelligents le mode de vie glorieux du saint Père Isaïe.</quote>
          </note>
        </noteGrp>
