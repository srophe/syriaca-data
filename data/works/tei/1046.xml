        <title xml:id="name1046-1" xml:lang="syr" source="#bib1046-1" srophe:tags="#syriaca-headword">ܡܪܝܡ ܝܠܕܬ ܐܠܗܐ</title>
        <title xml:id="name1046-2" xml:lang="fr-x-bhs" source="#bib1046-1">Maryam yāldaṯ Alāhā</title>
        <title xml:id="name1046-3" xml:lang="fr" source="#bib1046-1">Marie Mère de Dieu (texte)</title>
        <title xml:id="name1046-4" xml:lang="en" source="#bib1046-1" srophe:tags="#syriaca-headword">Mary Mother of God (text)</title>
        <author xml:lang="fr" source="#bib1046-1">Atticus de Constantinople</author>
        <idno type="URI">http://syriaca.org/work/1046</idno>
        <idno type="number" subtype="BHS">867</idno>
        <idno type="number" subtype="CPG">5804</idno>
        <idno type="number" subtype="CPG">5650</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1046-1">ܟܠܗܘܢ ܡܿܢ ܗܟܝܠ ܚ̈ܓܐ ܕܣܗ̈ܕܐ ܒܢܨܝܚܘܬܐ ܬܡܝܗܬܐ ܕܩܕܝ̈ܫܐ ܡܕܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1046-1">Or donc toutes les fêtes des martyrs imitent l’admirable splendeur des saints.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1046-1">ܡܟܝܠ ܟܕ ܐܬܐܣܪܬ ܘܒܛܐܪܛܐܪܘܣ ܐܫܬܕܝܬ. ܟܠܗܘܢ ܐܟܚܕܐ ܠܒܪܬ ܩܠܐ ܕܙܟܘܬܐ ܡܫܒܚܝܢ̣. ܡܪܝܐ ܐܡܠܟ ܬܕܘܨ ܐܪܥܐ. ܠܗ ܬܫܒܘܚܬܐ ܘܐܘܚܕܢܐ̣. ܠܥܠܡ ܥܠܡܝܢ ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1046-1">Alors que j’ai déjà été lié et jeté dans le Tartare, tous chantent ensemble le mot de la victoire: «Le Seigneur a régné, que la terre exulte». À lui la gloire et la puissance pour les siècles des siècles. Amen.</quote>
          </note>
        </noteGrp>
