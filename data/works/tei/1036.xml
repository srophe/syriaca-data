            <bibl xml:id="work-1036" ana="#syriaca-hagiographic">
        <title xml:id="name1036-1" xml:lang="syr" source="#bib1036-1" srophe:tags="#syriaca-headword">ܝܘܚܢܢ</title>
        <title xml:id="name1036-2" xml:lang="fr-x-bhs" source="#bib1036-1">Yōḥanān</title>
        <title xml:id="name1036-3" xml:lang="fr" source="#bib1036-1">Jean, évangéliste (Apocalypse) (texte)</title>
        <title xml:id="name1036-4" xml:lang="en" source="#bib1036-1" srophe:tags="#syriaca-headword">Apocalypse of John, the Evangelist (text)</title>
        <idno type="URI">http://syriaca.org/work/1036</idno>
        <idno type="number" subtype="BHS">852</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1036-1">ܘܗܘܐ ܙܘܥܐ ܪܒܐ ܡܢ ܫܠܝܐ ܘܢܦܠ ܝܘܚܢܢ ܐܚܘܗܝ ܘܒܪ ܪܐܙܗ ܕܡܪܢ ܥܠ ܐܦ̈ܘܗܝ ܥܠ ܐܪܥܐ ܘܒܙܘܥܬܐ ܪܒܬܐ ܣܓܕ ܠܐܠܗܐ ܡܪܐ ܟܠ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1036-1">Et il y eut soudain un grand tremblement de terre, et son frère Jean, l’initié de notre Seigneur, tomba face contre terre et adora Dieu Seigneur de tout avec un grand tremblement.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1036-1">ܘܟܕ ܗܠܝܢ ܡ̈ܠܐ ܘܚܙܘ̈ܐ ܘܓܠܝܢ̈ܐ ܐܡܪ ܒܫܪܪܐ ܝܘܚܢܢ. ܦܪܩ ܡܢܗ ܡܠܐܟܐ. ܕܐܡܪ ܠܘܬܗ. ܘܩܠܐ ܐܡܪ ܫܒܘܩ ܦܨܬܟ ܠܚܒܪ̈ܝܟ ܕܢܡܠܠܘܢ ܥܡܟ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1036-1">Et quand Jean eut dit vraiment ces mots, ces visions et ces révélations, l’ange qui lui avait parlé s’éloigna de lui et une voix dit: «Laisse ton livre à tes compagnons pour qu’ils parlent avec toi.»</quote>
          </note>
        </noteGrp>
