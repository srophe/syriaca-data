            <bibl xml:id="work-1071" ana="#syriaca-hagiographic">
        <title xml:id="name1071-1" xml:lang="syr" source="#bib1071-1" srophe:tags="#syriaca-headword">ܕܝܘܣܩܪܘܣ</title>
        <title xml:id="name1071-2" xml:lang="fr-x-bhs" source="#bib1071-1">Dīyōsqōrōs</title>
        <title xml:id="name1071-3" xml:lang="fr" source="#bib1071-1">Dioscore (texte)</title>
        <title xml:id="name1071-4" xml:lang="en" source="#bib1071-1" srophe:tags="#syriaca-headword">Dioscorus (text)</title>
        <author ref="http://syriaca.org/person/2788" source="#bib1071-1" xml:lang="en">Theopistes — <foreign xml:lang="syr">ܬܐܘܒܝܣܛܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1071</idno>
        <idno type="number" subtype="BHS">897</idno>
        <idno type="number" subtype="BHO">258</idno>
        <noteGrp type="prologue">
          <desc xml:lang="en">Prologue</desc>
          <note xml:lang="fr" type="prologue">
            <quote source="#bib1071-1">Mes bien-aimés, je vous informe des grands combats que nous avons supportés, moi et mon saint Père Dioscore l’archevêque.</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1071-1">ܗܘܬ ܕܝܢ ܒܗܿܘ ܙܒܢܐ ܕܥܢܕ ܬܐܘܕܘܣܝܣܘܣ ܡܠܟܐ ܥܘܪܐ. ܐܫܟܚ ܠܗ ܣܛܢܐ ܦܠܥܐ. ܕܢܥܝܪ ܫܓܘܫܝܐ ܥܠ ܥܕܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1071-1">Il arriva au moment où mourut l’empereur Théodose l’Aveugle, que Satan trouva l’occasion de susciter le trouble contre l’Église.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1071-1">ܕܐܢ ܩܪܝܒ ܐܢܬ ܠܗ ܠܦܪܛܘܪܝܘܣ ܟܕ ܚܙܐ ܐܢܬ ܘܐܢ ܪܚܝܩ ܐܢܬ ܟܕ ܫܡܥ ܐܢܬ ܠܡܦܘܠܬܐ ܕܡܝܬܐ ܥܠܘܗܝ ܐܠܗܐ. ܥܠ ܗܠܝܢ ܕܝܢ ܟܠܗܝܢ ܚܒ̈ܝܒܝ ܢܫܒܚ ܘܢܒܪܟ ܠܐܠܗܐ ܐܒܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1071-1">Si tu t’approches de Prétorius tu verras et si tu t’en éloignes tu entendras la chute que Dieu lui enverra. Pour tout cela louons et bénissons Dieu le Père… Amen.</quote>
          </note>
        </noteGrp>
