        <title xml:lang="syr" type="final-rubric" xml:id="name89-7" source="#bib89-20">ܫܠܡܬ ܐܓܪܬܐ ܕܠܘܬ ܦܝܠܡܘܢ ܘܐܦܝܐ ܡܪ̈ܘܗܝ ܕܐܢܣܝܡܘܣ̣ ܘܠܘܬ ܐܪܟܝܦܘܣ ܡܫܡܫܢܐ ܕܥܕܬܐ ܕܒܩܘܠܣܘܣ. ܕܐܬܟ̣ܬܒܬ݂ ܡܢ ܪܗܘܡܐ. ܒܝܕ ܐܢܣܝܡܘܣ ܥܒ̣ܕܐ. ܕܐܝܬ ܒܗ̇ ܦܬ̈ܓܡܐ ܚܡܫܝ̣ܢ ܘܫܒܥܐ.ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name89-8" source="#bib89-22 #bib89-38">The Epistle of Philemon, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name89-9" source="#bib89-26">ܫܠܡܬ. ܐܓܪܬܐ. ܕܠܘܬ܀ ܦܝܠܡܘܢ. ܕܐܬܟܬܒܬ܀ ܡܢ. ܪܗܘܡܐ. ܘܗܘܝܐ. ܚܡܫܝܢ. ܘܐܪܒܥܐ. ܦܬܓ̈ܡܝܢ. ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name89-10" source="#bib89-34">Philemon, according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name89-11" source="#bib89-44">The Epistle of Philemon</title>
        <title xml:lang="syr" xml:id="name89-12" source="#bib89-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܦ݂ܝܠܡܘܢ</title>
        <title xml:lang="syr-Syrj" xml:id="name89-13" source="#bib89-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܦ݂ܺܝܠܳܡܳܘܢ</title>
        <title xml:lang="en" xml:id="name89-14">The Epistle to Philemon</title>
        <idno type="URI">http://syriaca.org/work/89</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Epistle_to_Philemon</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q131104</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/89">Philemon (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib89-3">ܦܿܘܠܘܣ ܐܣܝܪܗ ܕܿܝܫܘܼܥ ܡܫܝܚܐ܂ ܘܛܝܡܬܼܐܘܣ ܐܚܐ܃ ܠܦܼܝܠܡܘܢ ܚܒܿܝܒܼܐ ܘܦܼܠܚܐ ܕܿܥܡܢ܂</quote>
          </note>
        </noteGrp>
