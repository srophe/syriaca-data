            <bibl xml:id="work-1681" ana="#syriaca-hagiographic">
        <title xml:id="name1681-3" xml:lang="fr" source="#bib1681-1">Docteurs grecs (texte)</title>
        <title xml:id="name1681-4" xml:lang="en" source="#bib1681-1" srophe:tags="#syriaca-headword">Greek Doctors (text)</title>
        <author xml:lang="fr" source="#bib1681-1" ref="http://syriaca.org/person/734">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Shalliṭa</forename>
                        <addName type="untagged-title" sort="2">of Reshʿayna</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܫܠܝܛܐ</forename>
                        <addName type="untagged-title" sort="2">ܕܪܫܥܝܢܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Shallita</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1681</idno>
        <idno type="number" subtype="BHS">1609</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1681-1">ܐܠܗܐ ܡܪܟܠ ܕܐܩܝܡ ܒܗܿ ܒܥܕܬܗ ܫܠܝ̈ܚܐ ܘܢܒ̈ܝܐ ܘܡܠܦܢ̈ܐ ܘܟܗܢ̈ܐ ܘܪ̈ܥܘܬܐ ܘܡܥܕܪ̈ܢܐ ܘܡܕܒܪ̈ܢܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1681-1">Dieu Seigneur de tout qui as établi dans ton Église les apôtres, les prophètes, les docteurs, les prêtres, les pasteurs, les aides et les administrateurs…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1681-1">ܘܠܗܠ ܡܐ ܕܓܡܪ ܙܒܢܗ ܕܥܠܡܐ ܗܢܐ ܢܩܒܠܘܢܢ ܒܡܛܠܠܝ̈ܗܘܢ ܕܠܥܠܡ. ܘܢܫܬܘܐ ܕܢܡܢܥ ܒܛܝܒܘ ܠܐܘܢܝ̈ܗܘܢ. ܘܥܡܗܘܢ ܘܒܝܢܬܗܘܢ ܢܣܩ ܠܟ ܬܫܒܘܚܬܐ ܘܐܝܩܪܐ ܘܬܘܕܝܬܐ ܘܣܓܕܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1681-1">Et quand sera achevé le temps de ce monde, qu’ils nous reçoivent dans leurs tentes pour l’éternité, et puissions-nous être jugés dignes de parvenir dans leurs demeures par grâce et qu’avec eux et parmi eux nous fassions monter vers toi la louange, l’honneur, l’action de grâce et l’adoration.</quote>
          </note>
        </noteGrp>
