            <bibl xml:id="work-296" ana="#syriaca-hagiographic">
        <title xml:id="name296-1" xml:lang="syr" source="#bib296-1" srophe:tags="#syriaca-headword">ܫܡܥܘܢ ܟܐܦܐ</title>
        <title xml:id="name296-2" xml:lang="fr-x-bhs" source="#bib296-1">Šemʿōn Kēpā</title>
        <title xml:id="name296-3" xml:lang="fr" source="#bib296-1">Pierre, apôtre (texte)</title>
        <title xml:id="name296-4" xml:lang="en" source="#bib296-1" srophe:tags="#syriaca-headword">Peter the Apostle (text)</title>
        <idno type="URI">http://syriaca.org/work/296</idno>
        <idno type="number" subtype="BHS">75</idno>
        <idno type="number" subtype="BHO">937</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib296-1">ܒܝܡܐ ܫܓܝܫܐ ܚܪܬ ܚܙܝܬ: ܐܠܦ̈ܐ ܬܪܥܣܪ ܟܕ ܪ̈ܕܝܢ. ܕܙܩܝܦ ܗܘ̣ܐ ܝܡܐ ܠܩܘܒܠܗܝܢ: ܘܥܒܪ ܒܓܘܗ ܘܫܝܢܝܗܝ܀</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib296-1">J’ai regardé et j’ai vu dans une mer tumultueuse douze bateaux naviguant, contre lesquels la mer était soulevée, et ils la traversèrent et l’apaisèrent.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib296-1">ܬܘܕܝ ܠܛܒܐ ܩܥܘ ܡܗܝܡ̈ܢܐ: ܕܫܡܟ ܐܙܕܪܥ ܒܝܬ ܡܥܡܪܢ. ܘܐܦ ܓܪ̈ܡܝܗܘܢ ܕܫܠܝܚܝ̈ܟ: ܢܗܘܘܢ ܣܢܐܓܪܐ ܠܡܗܝܡܢܝ̈ܟ܀</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib296-1">«Rendons grâces au bien» ont crié les fidèles, car ton nom a été semé dans notre demeure. Et que les os de tes apôtres soient aussi le défenseur de tes fidèles.</quote>
          </note>
        </noteGrp>
