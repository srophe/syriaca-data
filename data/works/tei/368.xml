        <title xml:id="name368-1" xml:lang="syr" source="#bib368-1" srophe:tags="#syriaca-headword">ܩܠܡܝܣ</title>
        <title xml:id="name368-2" xml:lang="fr-x-bhs" source="#bib368-1">Qlēmīs</title>
        <title xml:id="name368-3" xml:lang="fr" source="#bib368-1">Clément (texte)</title>
        <title xml:id="name368-4" xml:lang="en" source="#bib368-1" srophe:tags="#syriaca-headword">Clement (text)</title>
        <idno type="URI">http://syriaca.org/work/368</idno>
        <idno type="number" subtype="BHS">148</idno>
        <idno type="number" subtype="BHO">204</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib368-1">ܓܒܪܐ ܚܕ ܥܬܝܪܐ ܐܝܬ ܗܘ̣ܐ ܒܪܗܘܡܝ ܡܕܝܢܬܐ: ܘܫܡܗ ܦܘܣܛܝܢܝܐܢܘܣ: ܘܫܡܐ ܕܐܢܬܬܗ ܡܝܛܪܘܕܘܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib368-1">Il y avait dans la ville de Rome un homme riche appelé Faustinianus et le nom de sa femme était Métrodora.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib368-1">ܘܐܦ ܐܬܡܛܝܘ ܠܡܫܘܚܬܐ ܡܥܠܝܬܐ: ܘܒܩܕܝܫܘܬܐ ܛܒ ܐܬܢܨܚܐ. ܘܟܠܢ ܢܣܩ ܫܘܒܚܐ ܠܐܠܗܐ ܕܡܒܝܐ ܠܐܒܝ̈ܠܐ: ܘܡܥܒܪ ܥܩ̈ܬܐ ܕܟܠܗܘܢ ܐܝܠܝܢ ܕܡܣܒܪܝܢ ܒܗ: ܕܠܗ ܫܘܒܚܐ ܠܥܠܡܝܢ: ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib368-1">Et il parvinrent aussi à un âge avancé et ils brillèrent bien dans la sainteté. Et nous tous, rendons gloire à Dieu qui console les affligés et fait cesser la tristesse de ceux qui espèrent en lui; à lui la gloire pour les siècles. Amen.</quote>
          </note>
        </noteGrp>
