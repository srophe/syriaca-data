        <title xml:id="name78-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">1 Corinthians (Peshitta version)</title>
        <title xml:id="name78-2" xml:lang="syr" srophe:tags="#syriaca-headword" source="#bib78-1">ܐܓܪܬܐ ܕܦܘܠܘܣ ܕܠܘܬ ܩܘܪ̈ܝܢܬܝܐ ܩܕܡܝܬܐ</title>
        <title xml:id="name78-3" xml:lang="syr" source="#bib78-1">ܐܓܪܬܐ ܕܠܘܬ ܩܘܪ̈ܢܬܝܐ ܩܕܡܝܬܐ</title>
        <title xml:id="name78-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib78-5">1 Cor</title>
        <title xml:id="name78-5" xml:lang="en" source="#bib78-5 #bib78-23 #bib78-27 #bib78-29 #bib78-31 #bib78-33 #bib78-35 #bib78-37 #bib78-41 #bib78-43 #bib78-47 #bib78-49 #bib78-53 #bib78-55">1 Corinthians</title>
        <title xml:id="name78-6" xml:lang="syr-Syrj" source="#bib78-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܩܘܽܪܺܝܢܬܳܝܶ̈ܐ ܩܰܕܡܳܝܬܳܐ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name78-7" source="#bib78-23">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܩܘܪ̈ܢܬܝܐ ܩܕܡܝܬܐ ܕܐܬܟܬܒܬ ܡܢ ܦܝܠܝܦܘܣ ܡܕܝܢܬܐ. ܒܝܕ ܐܣܛܦܢܘܣ ܘܦܪܛܘܢܛܘܣ ܘܐܟܐܝܩܘܣ ܘܛܝܡܬܐܘܣ. ܕܐܝܬ ܒܗ̇ ܦܬ̈ܓܡܐ̇ ܐܠܦܐ ܘܡܐܬܝ̣ܢ ܘܫܒܥܐ.</title>
        <title xml:lang="en" xml:id="name78-8" source="#bib78-25 #bib78-45">The Epistle of 1 Corinthians, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name78-9" source="#bib78-29">ܫܠܡܬ܀ ܕܠܘܬ. ܩܘܪ̈ܢܬܝܐ: ܩܕܡܝܬܐ. ܕܐܬܟܬܒܬ܀ ܡܢ. ܦܝܠܝܦܘܣ: ܕܡܩܕܘܢܝܐ. ܕܗܘܝܐ: ܬܫܥܡܐܐ. ܘܐܪ̈ܒܥܝܢ: ܘܫܬܐ. ܦ̈ܬܓܡܝܢ. . ܘ:ܘ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name78-10" source="#bib78-35">ܫܠ̣ܡܬ ܐܓܪܬܐ ܕܠܘܬ ܩܘܪ̈ܢܬܝܐ ܩܕܡܝܬܐ ܕܐܬܟ̣ܬܒܬ ܡܢ ܦܝܠܝܦܘܣ ܕܡܩܕܘܢܝܐ ܘܐܫܬܕܪܬ ܒܝܕ ܛܝܡܬܐܘܣ</title>
        <title xml:lang="en" xml:id="name78-11" source="#bib78-39">1 Corinthians, according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name78-12" source="#bib78-51">The Epistle of 1 Corinthians</title>
        <title xml:lang="syr" xml:id="name78-13" source="#bib78-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܩܘܪ̈ܢܬ݂ܝܐ ܩܕ݂ܡܝܬ݁ܐ</title>
        <title xml:lang="syr-Syrj" xml:id="name78-14" source="#bib78-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܩܘܪ̈ܢܬ݂ܳܝܶܐ ܩܰܕ݂ܡܳܝܬ݁ܳܐ</title>
        <title xml:lang="en" xml:id="name78-15" resp="http://syriaca.org">The First Epistle to the Corinthians</title>
        <idno type="URI">http://syriaca.org/work/78</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/First_Epistle_to_the_Corinthians</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q80355</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
            An early Syriac translation of the Pauline epistle of <title ref="http://syriaca.org/work/9595">1 Corinthians</title>. This common Syriac translation of a <title ref="http://syriaca.org/work/9587">New Testament</title> book was extant as early as the 5th-6th century. In Syriac tradition, <title ref="http://syriaca.org/work/78">1 Corinthians</title> consistently circulates as part ofthe <title xml:lang="en" ref="http://syriaca.org/work/9643">Pauline Epistles</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib78-3">ܦܿܘܠܘܣ ܩܪܝܐ ܘܫܠܝܚܐ ܕܿܝܫܘܼܥ ܡܫܝܚܐ܂ ܒܿܨܒܼܝܢܗ ܕܿܐܠܗܐ܂ ܘܣܘܣܬܼܢܣ ܐܚܐ܃</quote>
          </note>
        </noteGrp>
