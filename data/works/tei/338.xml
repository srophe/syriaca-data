        <title xml:id="name338-1" xml:lang="syr" source="#bib338-1" srophe:tags="#syriaca-headword">ܕܕܘ</title>
        <title xml:id="name338-2" xml:lang="fr-x-bhs" source="#bib338-1">Dāḏū</title>
        <title xml:id="name338-3" xml:lang="fr" source="#bib338-1">Dadou (texte)</title>
        <title xml:id="name338-4" xml:lang="en" source="#bib338-1" srophe:tags="#syriaca-headword">Dodo (text)</title>
        <author ref="http://syriaca.org/person/2815" xml:lang="fr" source="#bib338-1">Jean le Préfet</author>
        <idno type="URI">http://syriaca.org/work/338</idno>
        <idno type="number" subtype="BHS">118</idno>
        <idno type="number" subtype="BHO">240</idno>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib338-1">ܘܡܢ ܒܬܪ ܕܫܢܝܘ ܡܢܗ ܩܛܘܠܘ̈ܗܝ: ܗܝܕܝܢ ܐܬܝܬ ܐܢܐ ܝܘܚܢܢ ܦܛܟܫܐ ܘܐܒܓܪܗܢ ܪܒ ܚܝܠܐ: ܘܐܫܬܘܝܢܢ ܒܛܢܢܐ ܕܕܚܠܬ ܐܠܗܐ: ܘܓܒܝܢ ܚܢܢ ܓܪ̈ܡܐ ܗܠܝܢ: ܘܩܦܣܢ ܘܩܒܪܢ ܐܢܘܢ ܒܬܡܢܘܢ ܩܪܝܬܐ: ܐܝܟܐ ܕܐܣܗܕ ܣܗܕܐ ܙܟܝܐ ܘܫܪܝܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib338-1">Et après que ses meurtriers se furent éloignés de lui, alors je vins moi, Jean le préfet, avec le commandant Abgarhan, et nous fûmes jugés dignes de l’ardeur de la crainte de Dieu et nous recueillîmes ces os, nous les rassemblâmes et les enterrâmes dans le village de Témanôn, là où le martyr victorieux et vrai avait subi le martyre.</quote>
          </note>
        </noteGrp>
