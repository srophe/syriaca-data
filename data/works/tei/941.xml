            <bibl xml:id="work-941" ana="#syriaca-hagiographic">
        <title xml:id="name941-1" xml:lang="syr" source="#bib941-1" srophe:tags="#syriaca-headword">ܫܡܥܘܢ</title>
        <title xml:id="name941-2" xml:lang="fr-x-bhs" source="#bib941-1">Šemʿōn</title>
        <title xml:id="name941-3" xml:lang="fr" source="#bib941-1">Pierre, apôtre (texte)</title>
        <title xml:id="name941-4" xml:lang="en" source="#bib941-1" srophe:tags="#syriaca-headword">Peter the Apostle (text)</title>
        <author xml:lang="fr" source="#bib941-1" ref="http://syriaca.org/person/42">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yaʿqub</forename>
                        <addName type="untagged-title" sort="2">of Serugh</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܥܩܘܒ</forename>
                        <addName type="untagged-title" sort="2">ܕܣܪܘܓ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jacques</forename>
                        <addName type="untagged-title">de Serugh</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/941</idno>
        <idno type="number" subtype="BHS">740</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib941-1">ܐܒܐ ܪܚܡܢܐ ܕܦܪܩܢ ܒܕܡܗ ܕܝܚܝܕܝܗ: ܡܢܟ ܐܣܒ ܚܝܠܐ ܠܡܐܡܪܗ ܕܝܚܝܕܝܟ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib941-1">Père miséricordieux, toi qui nous as sauvé par le sang de ton Fils unique, puissé-je prendre de toi la force pour parler de ton Fils unique.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib941-1">ܫܠܛܗܿ ܠܚܐܪܬܐ ܕܬܚܬܘܡ ܓܙ̈ܐ ܘܬܫܪܐ ܛܒ̈ܥܐ: ܒܪܝܟ ܥܬܝܪܐ ܕܒܡܐܬܝܬܗ ܥܬܪܘ ܡܣܟܢ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib941-1">Il a dominé la libre pour qu’elle scelle les trésors et qu’elle défasse les sceaux; béni soit le riche qui a enrichi les pauvres par sa venue.</quote>
          </note>
        </noteGrp>
