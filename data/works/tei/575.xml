            <bibl xml:id="work-575" ana="#syriaca-hagiographic">
        <title xml:id="name575-1" xml:lang="syr" source="#bib575-1" srophe:tags="#syriaca-headword">ܐܒܪܗܡ ܩܝܕܘܢܝܐ</title>
        <title xml:id="name575-2" xml:lang="fr-x-bhs" source="#bib575-1">ʾAḇrāhām Qīdūnāyā</title>
        <title xml:id="name575-3" xml:lang="fr" source="#bib575-1">Abraham Qidounaya (texte)</title>
        <title xml:id="name575-4" xml:lang="en" source="#bib575-1" srophe:tags="#syriaca-headword">Abraham Quidounaya (text)</title>
        <author xml:lang="fr" source="#bib575-1" ref="http://syriaca.org/person/13">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Ephrem</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܐܦܪܝܡ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Éphrem</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/575</idno>
        <idno type="number" subtype="BHS">356</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib575-1">ܠܥܘܒܗ ܕܐܒܪܗܡ ܢܐܙܠ ܐܒܪܗܡ ܕܕܡܐ ܠܗ ܒܬܪ̈ܬܝܢ ܒܫܡܐ ܘܒ̈ܥܒܕܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib575-1">Qu’Abraham aille dans le sein d’Abraham, car il lui ressembla en deux choses: le nom et les actes.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib575-1">ܡܢ ܪܝܫ ܬܟܬܘܫܗ ܪܓܬܐ ܩܢܛܬ ܗܘܬ ܕܫܩܠܬ ܢܣܝܢܗ ܕܙܗܐ ܗܘ ܬܟܬܘܫܗ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib575-1">Depuis le début de sa lutte, le désir eut peur car elle avait fait son examen et vu que sa lutte était splendide.</quote>
          </note>
        </noteGrp>
