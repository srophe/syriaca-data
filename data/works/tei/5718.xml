        <title xml:id="name5718-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Of the Mother of God</title>
        <title xml:id="name5718-2" xml:lang="en" source="#bib5718-1">Hymn on the Blessed Virgin</title>
        <author ref="http://syriaca.org/person/26" source="#bib5718-1" xml:lang="en">Rabbula of Edessa — <foreign xml:lang="syr">ܪܒܘܠܐ ܕܐܘܪܗܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5718</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" source="#bib5718-1 #bib5718-2 #bib5718-3 #bib5718-4">A Syriac Marian supplication attributed to Rabbula of Edessa. The hymn belongs to the larger liturgical poetic corpus transmitted under Rabbula’s name, invoking Mary as the Mother of God.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5675-2">ܫܠܡ ܠܟܝ ܡܢ ܟܠ ܩܕܝܫܬܐ</quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5675-8">Peace be with you, most holy one</quote>
          </note>
          </noteGrp>
          <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5675-2">ܗܘ ܕܝܫܩܐ ܠܚܜܝܬܗ ܕܥܠܡܐ ܘܦܪܩ ܠܗ</quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5675-8">The one who takes away the sin of the world and saves it.</quote>
          </note>
        </noteGrp>
