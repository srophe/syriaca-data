        <title xml:id="name1105-4" xml:lang="en" source="#bib1105-1" srophe:tags="#syriaca-headword">Steven (text)</title>
        <author ref="http://syriaca.org/person/650" source="#bib1105-1" xml:lang="en">Narsai — <foreign xml:lang="syr">ܢܪܣܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1105</idno>
        <idno type="number" subtype="BHS">935</idno>
        <idno type="number" subtype="BHO">1097</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1105-1">ܡܠܟܐ ܕܪܘܡܐ ܕܙܟܐ ܒܩܝܣܐ ܠܒܝܫܐ ܘܡܘܬܐ: ܓܒܐ ܠܗ ܦܠܚܐ ܘܫܕܪ ܒܩܕܡܐ ܩܕܡ ܡܫܪܝܬܗ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1105-1">Le roi d’en-haut qui a vaincu le mal et la mort par le bois s’est choisi un serviteur et l’a envoyé d’abord devant son armée.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1105-1">ܬܘ ܢܬܚܦܛ ܒܨ̈ܠܘܬܐ ܒܝܘܡ ܥܕܥܕܗ: ܕܢܗܘܐ ܥܡܗ ܒܡܠܟܘܬ ܪܘܡܐ ܒܛܘܒ̈ܐ ܡܠܝܟ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1105-1">Venez, soyons actifs dans les prières au jour de sa fête, pour être avec lui dans le royaume d’en-haut dans la béatitude promise.</quote>
          </note>
        </noteGrp>
