            <bibl xml:id="work-1378" ana="#syriaca-hagiographic">
        <title xml:id="name1378-1" xml:lang="syr" source="#bib1378-1" srophe:tags="#syriaca-headword">ܓܝܘܪܓܝܣ</title>
        <title xml:id="name1378-2" xml:lang="fr-x-bhs" source="#bib1378-1">Gīwargīs</title>
        <title xml:id="name1378-3" xml:lang="fr" source="#bib1378-1">Georges (texte)</title>
        <title xml:id="name1378-4" xml:lang="en" source="#bib1378-1" srophe:tags="#syriaca-headword">George (text)</title>
        <author xml:lang="fr" source="#bib1378-1" ref="http://syriaca.org/person/551">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Isḥaq</forename>
                        <addName type="family" sort="2">Shbadnaya</addName>
                    </persName> —   (<persName xml:lang="fr">
                        <forename>Isaac</forename>
                        <addName type="untagged-title">Qardahé</addName>
                        <addName type="untagged-title">Shbadnaya</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1378</idno>
        <idno type="number" subtype="BHS">1243</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1378-1">ܨܡܚܐ ܫܒܝܚܐ ܕܐܝܬܘܬܐ. ܕܨܡܚ ܒܐܣܦܝܪ ܐܢܫܘܬܐ. ܝܫܘܥ ܣܒܪܐ ܕܟܠܗܘܢ ܡ̈ܠܠܐ. ܘܡܒܘܥ ܚܝ̈ܐ ܘܣܘ̈ܟܠܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1378-1">Splendeur glorieuse de l’Être, qui a resplendi parmi les hommes, Jésus espoir de tous les êtres rationnels et source de vie et d’intelligence.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1378-1">ܡܫܝܚܐ ܕܢܨܚܟ ܒܐܪ̈ܒܥܦܢܝ̈ܬܐ. ܢܫܘܝܢ ܕܥܡܟ ܢܬܒܣܡ ܒܓܢܘܢ ܢܘܗܪܐ ܐܡܝܢ ܘܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1378-1">Que le Christ qui t’a fait triompher aux quatre coins du monde nous juge dignes de jouir avec toi de la chambre nuptiale de la lumière. Amen et amen.</quote>
          </note>
        </noteGrp>
