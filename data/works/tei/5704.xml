      <bibl xml:id="work-5704" type="lawd:ConceptualWork">
        <title xml:id="name5704-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Commentaries on the Gospels</title>
        <author ref="http://syriaca.org/person/555" source="#bib5704-1" xml:lang="en">Ishoʿdad of Merv — <foreign xml:lang="syr">ܝܫܘܥܕܕ ܡܪܘܙܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5704</idno>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note xml:lang="en" type="abstract" corresp="http://syriaca.org/nhsl" source="#bib5704-1 bib5704-3 bib5704-4">
            A commentary on the Gospels written by Ishoʿdad of Merv, bishop of Ḥadatha, in the middle of the ninth century. It survives in at least three manuscripts. The commentary follows the Old Syriac Gospels, and contains quotations from Tatian's Diatessaron, Ephrem's commentary on the Diatessaron, and Theodore of Mopsuestia.
          </note>
        </noteGrp>
