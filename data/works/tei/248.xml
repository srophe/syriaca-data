        <title xml:id="name248-1" xml:lang="syr" source="#bib248-1" srophe:tags="#syriaca-headword">ܣܠܘܢܘܣ ܘܗܢܿܘܢ ܕܥܡܗ</title>
        <title xml:id="name248-2" xml:lang="fr-x-bhs" source="#bib248-1">Silwānōs w-hānōn d-ʿamēh</title>
        <title xml:id="name248-3" xml:lang="fr" source="#bib248-1">Silvain et ses compagnons (texte)</title>
        <title xml:id="name248-4" xml:lang="en" source="#bib248-1" srophe:tags="#syriaca-headword">Silvanus and His Companions (text)</title>
        <author xml:lang="fr" source="#bib248-1" ref="http://syriaca.org/person/480">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Eusebius</forename>
                        <addName type="untagged-title" sort="2">of Caesarea</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܐܘܣܒܝܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܩܣܪܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Eusèbe</forename>
                        <addName type="untagged-title">de Césarée</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/248</idno>
        <idno type="number" subtype="BHS">27</idno>
        <idno type="number" subtype="BHO">1065</idno>
        <idno type="number" subtype="CPG">3490</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib248-1">ܡܢ ܓܙܐ ܕܝܢ ܢܦܩ ܗܘ̣ܐ ܗܘ ܗܢܐ ܣܠܘܢܘܣ ܛܘܒܢܐ: ܘܐܝܬܘܗܝ ܗܘ̣ܐ ܕܝܢ ܚܕ ܡܢ ܦܠܚ̈ܐ ܥܬܝ̈ܩܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib248-1">Ce bienheureux Silvain était venu de Gaza, et il était un des soldats vétérans.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib248-1">ܥܝܢܐ ܓܝܪ ܠܐ ܚܙܬ: ܘܐܕܢܐ ܠܐ ܫܡܥܬ: ܘܥܠ ܠܒܐ ܕܒܪ ܐܢܫܐ ܠܐ ܣܠܩ ܡܕܡ ܕܛܝܒ ܐܠܗܐ ܠܗܢܿܘܢ ܕܪܚܡܘܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib248-1">Car ce que Dieu a préparé pour ceux qui l’aiment, nul oeil ne l’a vu, nulle oreille ne l’a entendu, ce n’est pas monté au coeur de l’homme.</quote>
          </note>
        </noteGrp>
