        <title xml:id="name1425-1" xml:lang="syr" source="#bib1425-1" srophe:tags="#syriaca-headword">ܓܪܝܓܘܪܝܘܣ</title>
        <title xml:id="name1425-2" xml:lang="fr-x-bhs" source="#bib1425-1">Grīǥōrīyōs</title>
        <title xml:id="name1425-3" xml:lang="fr" source="#bib1425-1">Grégoire (père de G. de Nazianze) (texte)</title>
        <title xml:id="name1425-4" xml:lang="en" source="#bib1425-1" srophe:tags="#syriaca-headword">Gregory (text)</title>
        <author ref="http://syriaca.org/person/511" source="#bib1425-1" xml:lang="en">Gregory Nazianzen — <foreign xml:lang="syr">ܓܪܝܓܘܪܝܘܣ ܕܐܢܙܝܢܙܘ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1425</idno>
        <idno type="number" subtype="BHS">1298</idno>
        <idno type="number" subtype="CPG">3010</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1425-1">ܒܪܢܫܐ ܕܐܠܗܐ ܘܥܒܕܐ ܡܗܝܡܢܐ ܘܪܒܝܬܐ ܕܪ̈ܐܙܐ ܕܐܠܗܐ ܘܓܒܪܐ ܕܪ̈ܓܝܓܬܐ ܗܠܝܢ ܕܪܘܚܐ ܗܟܢܐ ܓܝܪ ܟܬܒܐ ܩܿܪܐ ܠܗܠܝܢ ܡ̈ܥܠܝܐ ܘܪ̈ܡܐ ܘܕܠܥܠ ܡܢ ܗܠܝܢ ܕܡ̈ܬܚܙܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1425-1">Homme de Dieu, serviteur fidèle, économe des mystères de Dieu et homme des désirs de l’Esprit, car ainsi l’Écriture appelle les gens sublimes et élevés qui sont au-dessus des choses visibles.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1425-1">ܘܠܐ ܡܕܡ ܡܐܡܪܐ ܠܘܬܟܝ ܗܿܝ ܕܝܬܝܪ ܡܢ ܟܠܢܫ ܚܟܝܡܐ ܢܗܘܐ ܣܡܐ ܓܘܢܝܐ ܕܒܘܝܐܐ ܠܗܿܢܘܢ ܕܐܒܝܠܝܢ ܐܝܟܢܐ ܕܢܚܙܘܢܝܗܝ ܒ̈ܢܝܢܫܐ ܟܕ ܡܠܘܝܢ ܠܒ̈ܢܝܢܫܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1425-1">Ce discours n’est rien pour toi, plus sage que tout le monde; qu’il soit un remède commun de consolation pour ceux qui pleurent afin qu’hommes il voient qu’ils escortent des hommes.</quote>
          </note>
        </noteGrp>
