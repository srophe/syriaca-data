        <title xml:id="name1195-1" xml:lang="syr" source="#bib1195-1" srophe:tags="#syriaca-headword">ܓܝܘܪܓܝܣ</title>
        <title xml:id="name1195-2" xml:lang="fr-x-bhs" source="#bib1195-1">Gīwargīs</title>
        <title xml:id="name1195-3" xml:lang="fr" source="#bib1195-1">Georges (texte)</title>
        <title xml:id="name1195-4" xml:lang="en" source="#bib1195-1" srophe:tags="#syriaca-headword">George (text)</title>
        <author ref="http://syriaca.org/person/504" source="#bib1195-1" xml:lang="en">George Warda</author>
        <idno type="URI">http://syriaca.org/work/1195</idno>
        <idno type="number" subtype="BHS">1035</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1195-1">ܠܐܓܘܢܐ ܕܣܗ̈ܕܐ ܥܠܬ ܘܒܦܘܪܬܟܐ ܪܒܐ ܩܡܬ ܘܡܢ ܫܢܕ̈ܝܗܘܢ ܐܬܡܚܠܬ ܘܒܩ̈ܠܝܗܘܢ ܐܬܚܝܠܬ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1195-1">Je suis entré dans le combat des martyrs, je me suis tenu dans une grande incertitude, j’ai été affaibli par leurs supplices et renforcé par leurs voix.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1195-1">ܘܠܟܠ ܟܢ̈ܫܝܢ ܕܝܘܡܢ ܟܢܝܫܝܢ ܘܠܕܘܟܪܢܗ ܗܐ ܡܙܝܚܝܢ ܒܛܠ ܡܢܗܘܢ ܟܠ ܢܟܝܢ̈ܝܢ ܘܠܟ ܬܫܒܘܚܬܐ ܡܢ ܟܠ ܦܘܡܝܢ ܠܥܠܡ ܥܠܡܝܢ ܐܡܝܢ ܘܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1195-1">Pour toutes les foules rassemblées aujourd’hui et qui célèbrent sa mémoire, éloigne d’eux tout dommage; à toi la louange de toutes les bouches pour les siècles des siècles. Amen et amen.</quote>
          </note>
        </noteGrp>
