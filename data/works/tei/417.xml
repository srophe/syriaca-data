        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib417-1">ܬܘܒ ܕܝܢ ܒܛܘܪܐ ܗܢܐ ܕܢܛܝܪܐ ܗܘܐ ܓܒܪܐ ܚܕ ܕܬܕܡܘܪܬܐ: ܕܫܡܗ ܗܘ̣ܐ ܒܢܝܡܝܢ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib417-1">Il y avait encore sur cette montagne de Nitrie un homme admirable qui s’appelait Benjamin…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib417-1">ܟܕ ܕܝܢ ܐܬܬܢܝܚ ܗܘ ܗܢܐ ܛܘܒܢܐ: ܟܠܗ ܡܠܒܢܐ ܕܬܪܥܐ ܐܬܬܪܝܡ: ܐܝܟ ܕܢܫܟܚܘܢ ܢܦܩܘܢܝܗܝ ܠܦܓܪܗ ܡܢ ܩܠܝܬܗ: ܡܛܠ ܕܣܓܝ ܪܒ ܗܘ̣ܐ ܦܓܪܗ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib417-1">Quand ce bienheureux mourut, tout le briquetage de la porte fut enlevé pour que l’on puisse sortir son corps de sa cellule, parce que son corps était très grand.</quote>
          </note>
        </noteGrp>
