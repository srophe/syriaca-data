    <body>
      <bibl xml:id="work-5527" type="lawd:ConceptualWork">
        <title xml:id="name5527-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Didascalia Apostolorum</title>
        <title xml:id="name5527-2" xml:lang="syr" srophe:tags="#syriaca-headword" source="#bib5527-2">ܕܝܕܣܩܠܝܐ ܕܬܪ̈ܥܣܪ ܫܠܝ̈ܚܐ</title>
        <title xml:id="name5527-3" xml:lang="fr" source="#bib5527-6">La Didascalie, c’est-à-dire l’enseignement catholique des douze apôtres et des saints disciples de notre Sauveur</title>
        <idno type="URI">http://syriaca.org/work/5527</idno>
        <!-- The date is from Gibson (bib5527-1), p. v. -->
        <date notBefore="0200" notAfter="0300" source="#bib5527-1">3rd century</date>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note xml:lang="en" type="abstract" corresp="http://syriaca.org/nhsl" source="#bib5527-1">The Didascalia Apostolorum, originally Greek, was an early Christian treatise on church law and doctrine and a potent instrument whereby clergy in the early centuries obtained unquestioning obedience from Christians. It covers bishops, widows, deacons, penance, and relations with Judaism. Its most salient features include its exaltation of the authority of the bishops and multitude of scriptural quotations. Understood by some to originate from the sect of the Audaeans, it carried the supposed authority of the Lord’s apostles. A century later, the first six books of the Apostolical Constitutions were an amplification of this work.</note>
        </noteGrp>
        <noteGrp type="disambiguation">
          <desc xml:lang="en">Disambiguation</desc>
          <note xml:lang="en" type="disambiguation" resp="http://syriaca.org">This work should not be confused with the Didache (the "Teaching of the Twelve Apostles").</note>
        </noteGrp>
        <listBibl type="editions">
          <head>Editions</head>
          <desc xml:lang="en">This is not a comprehensive list of editions related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <!-- Gibson's base text is the Mesopotamian MS (codex Harrisianus; J. J. C. Cox, "Prolegomena ... Part I", p. 253), copied by J. Rendel Harris; no library or shelfmark is known, so it is not listed under Manuscripts. Gibson also collated a MS in the Museo Borgia (collation furnished by F. Nau); no shelfmark is given, so it is not listed either. -->
          <bibl xml:id="bib5527-2" type="lawd:Edition">
            <title xml:lang="en">The Didascalia Apostolorum in Syriac, Edited from a Mesopotamian Manuscript with Various Readings and Collations of Other Mss</title>
            <editor>Margaret Dunlop Gibson</editor>
            <ptr target="http://syriaca.org/cbss/KJM2DALK"/>
          </bibl>
          <bibl xml:id="bib5527-3" type="lawd:Edition">
            <title xml:lang="la">Didascalia Apostolorum Syriace</title>
            <editor>Paul A. de Lagarde</editor>
            <ptr target="http://syriaca.org/cbss/EVY6DHTR"/>
          </bibl>
          <bibl xml:id="bib5527-4" type="lawd:Edition">
            <title xml:lang="en">The Didascalia Apostolorum in Syriac</title>
            <editor>Arthur Vööbus</editor>
            <ptr target="http://syriaca.org/cbss/GPRQ257X"/>
            <citedRange unit="vol">1-4</citedRange>
          </bibl>
        </listBibl>
        <listBibl type="manuscripts">
          <head>Manuscripts</head>
          <desc xml:lang="en">This is not a comprehensive list of manuscripts related to this work.</desc>
          <!-- Gibson (bib5527-2) cites this as "Paris Codex (Codex Sangermanensis) MS. No. 60, ff. 1-90"; shelfmark and folios here follow J. J. C. Cox, "Prolegomena ... Part I", p. 250 ("Ms. Syr 62, fols. 1-89"). Cox Part I is not in CBSS. -->
          <bibl xml:id="bib5527-7" type="syriaca:Manuscript">
            <label>Paris, Bibliothèque nationale <idno type="shelfmark" subtype="BNF">syr. 62</idno>
            </label>
            <citedRange unit="fol">1-89</citedRange>
          </bibl>
          <!-- W. Wright, A Catalogue of the Syriac Manuscripts Preserved in the Library of the University of Cambridge (1901), p. 616, item 17: extracts from the Didascalia Apostolorum beginning f. 169a; part of f. 170b and all of f. 171a left blank by the scribe; the last extract, from ch. 21, is imperfect, five leaves having been cut out after f. 204. -->
          <bibl xml:id="bib5527-8" type="syriaca:Manuscript">
            <label>Cambridge, University Library <idno type="shelfmark" subtype="Cambridge">Add. 2023</idno>
            </label>
            <citedRange unit="fol">169-294</citedRange>
          </bibl>
          <!-- The "Malabar MS"; a portion was deciphered and published by J. P. Arendzen in the Journal of Theological Studies (October 1901). Gibson gives no folios. -->
          <bibl xml:id="bib5527-9" type="syriaca:Manuscript">
            <label>Cambridge, University Library <idno type="shelfmark" subtype="Cambridge">Oo. i. 2</idno>
            </label>
          </bibl>
        </listBibl>
        <listBibl type="modernTranslations">
          <head>Modern Translations</head>
          <desc xml:lang="en">This is not a comprehensive list of modern translations related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <bibl xml:id="bib5527-1" type="syriaca:ModernTranslation">
            <title xml:lang="en">The Didascalia Apostolorum in English, Translated from the Syriac</title>
            <editor>Margaret Dunlop Gibson</editor>
            <ptr target="http://syriaca.org/cbss/W8URTNT3"/>
            <citedRange unit="p">1-112</citedRange>
            <textLang mainLang="en"/>
            <listRelation>
              <relation active="#bib5527-1" ref="dcterms:source" passive="#bib5527-2">
                <desc xml:lang="en">
                  <title ref="http://syriaca.org/cbss/KJM2DALK">The Didascalia Apostolorum in Syriac, Edited from a Mesopotamian Manuscript with Various Readings and Collations of Other Mss</title>
                </desc>
              </relation>
            </listRelation>
          </bibl>
          <bibl xml:id="bib5527-5" type="syriaca:ModernTranslation">
            <title xml:lang="en">The Didascalia Apostolorum: An English Version, Edited, Introduced and Annotated</title>
            <editor>Alistair Stewart-Sykes</editor>
            <ptr target="http://syriaca.org/cbss/6XYQGIC7"/>
            <textLang mainLang="en"/>
          </bibl>
          <bibl xml:id="bib5527-6" type="syriaca:ModernTranslation">
            <title xml:lang="fr">La Didascalie, c’est-à-dire l’enseignement catholique des douze apôtres et des saints disciples de notre Sauveur</title>
            <editor>François Nau</editor>
            <ptr target="http://syriaca.org/cbss/DV9YB8QZ"/>
            <textLang mainLang="fr"/>
          </bibl>
          <bibl xml:id="bib5527-10" type="syriaca:ModernTranslation">
            <title xml:lang="fr">La Didascalie, c’est-à-dire l’enseignement catholique des douze apôtres et des saints disciples de notre Sauveur, traduite pour la première fois</title>
            <editor>François Nau</editor>
            <ptr target="http://syriaca.org/cbss/JLBUZ5LL"/>
            <textLang mainLang="fr"/>
          </bibl>
        </listBibl>
      </bibl>
    </body>
