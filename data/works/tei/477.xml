        <title xml:id="name477-3" xml:lang="fr" source="#bib477-1">Disciple d’un vieillard solitaire (texte)</title>
        <title xml:id="name477-4" xml:lang="en" source="#bib477-1" srophe:tags="#syriaca-headword">Disciple of a Solitary Elder (text)</title>
        <author ref="http://syriaca.org/person/668" source="#bib477-1" xml:lang="en">Palladius of Aspuna — <foreign xml:lang="syr">ܦܠܕܝܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/477</idno>
        <idno type="number" subtype="BHS">257</idno>
        <idno type="number" subtype="BHO">854</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib477-1">ܐܡܪ ܐܢܫ ܡܢ ܣܒ̈ܐ: ܕܫܡܥܬ ܡܢ ܐܢܫܐ ܩܕܝ̈ܫܐ: ܕܐܝܬ ܛܠܝ̈ܐ ܕܗܢܘܢ ܢܓܕܝܢ ܘܡܫܒܠܝܢ ܠܣܒ̈ܐ ܠܘܬ ܚܝ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib477-1">J’ai entendu un des vieillards dire: «J’ai entendu un des saints dire qu’il y a des jeunes gens qui mènent et conduisent des vieillards vers la vie.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib477-1">ܘܡܢ ܗܝܕܝܢ ܣܒܐ ܗܘܿ ܐܬܢܟܦ: ܘܗܘܐ ܕܝܪܝܐ ܒܚܝܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib477-1">Depuis lors ce vieillard se montra réservé et devint un moine éprouvé.</quote>
          </note>
        </noteGrp>
