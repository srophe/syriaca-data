         <bibl xml:id="work-5525" type="lawd:ConceptualWork">
            <title xml:id="name5525-1" xml:lang="en" srophe:tags="#syriaca-headword"> </title>
            <author ref="http://syriaca.org/person/430" xml:lang="en"> — <foreign xml:lang="syr">ܩܘܪܝܠܠܘܣ ܕܐܠܟܣܢܕܪܝܐ</foreign>
            </author>
                       <idno type="URI">http://syriaca.org/work/5525</idno>
            <textLang mainLang="syr"/>
                        <noteGrp type="abstract">
               <desc xml:lang="en">Abstract</desc>
               <note corresp="http://syriaca.org/nhsl" xml:id="bib5525-01" xml:lang="en" type="abstract" resp="http://syriaca.org">
                  Cyril of Alexandria composed 156 Homilies on Luke in Greek, which in Syriac are known together as a commentary. The Syriac translation is incomplete and the textual history of the work in Greek and Syriac is complex. Cyril’s homilies also have their own reception across Syriac florilegia and collections.
               </note>
            </noteGrp>
