        <title xml:id="name270-3" xml:lang="fr" source="#bib270-1">Milès, Aboursam et Sinay (texte)</title>
        <title xml:id="name270-4" xml:lang="en" source="#bib270-1" srophe:tags="#syriaca-headword">Miles, Aboursam and Sinay (text)</title>
        <idno type="URI">http://syriaca.org/work/270</idno>
