            <bibl xml:id="work-1338" ana="#syriaca-hagiographic">
        <title xml:id="name1338-3" xml:lang="fr" source="#bib1338-1">Larron (texte)</title>
        <title xml:id="name1338-4" xml:lang="en" source="#bib1338-1" srophe:tags="#syriaca-headword">The Thief (text)</title>
        <author ref="http://syriaca.org/person/650" source="#bib1338-1" xml:lang="en">Narsai — <foreign xml:lang="syr">ܢܪܣܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1338</idno>
        <idno type="number" subtype="BHS">1202</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1338-1">ܒܪܝܬܐ ܚܕܬܐ ܒܪܐ ܒܪܘܝܐ ܒܪܫ ܓܓܘܠܬܐ: ܘܚܘܝ ܚܝܠܐ ܕܐܘܡܢܘܬܗ ܒܓܒܪܐ ܙܩܝܦܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1338-1">Le créateur a créé une nouvelle création au sommet du Golgotha et il a montré la puissance de son art dans l’homme crucifié.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1338-1">ܚܟܝܡܐܝܬ ܨܪܗ ܠܫܪܒܟ ܒܕܦܐ ܕܚܫܘ̈ܗܝ: ܕܢܐܠܦ ܟܠܢܫ ܠܡܪܕܐ ܒܚ̈ܫܐ ܠܘܬ ܕܥܬܝ̈ܕܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1338-1">Avec sagesse il a dépeint ton histoire sur le tableau de ses passions pour enseigner à tout le monde à marcher à travers les passions vers les choses à venir.</quote>
          </note>
        </noteGrp>
