        <title xml:id="name955-1" xml:lang="syr" source="#bib955-1" srophe:tags="#syriaca-headword">ܬܐܘܡܐ</title>
        <title xml:id="name955-2" xml:lang="fr-x-bhs" source="#bib955-1">Tōmā</title>
        <title xml:id="name955-3" xml:lang="fr" source="#bib955-1">Thomas, apôtre (texte)</title>
        <title xml:id="name955-4" xml:lang="en" source="#bib955-1" srophe:tags="#syriaca-headword">Thomas the Apostle (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib955-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/955</idno>
        <idno type="number" subtype="BHS">758</idno>
        <idno type="number" subtype="BHO">1223</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib955-1">ܒܪܐ ܕܐܙܕܒܢ ܘܐܬܚܪܪ ܒܗ ܓܢܣܐ ܕܐܢܫܐ: ܗܒ ܠܝ ܕܐܡܪ ܥܠ ܬܠܡܝܕܐ ܡܙܒܢܐ ܕܡܢܟ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib955-1">Fils en qui le genre humain a été racheté et affranchi, donne-moi de parler du disciple, le vendeur envoyé par toi.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib955-1">ܠܟ ܢܫܬܥܒܕ ܪܘܡܐ ܘܥܘܡܩܐ ܘܟܠ ܕܐܝܬ ܒܗܘܢ: ܕܐܢܬ ܗܘ ܒܘܟܪܗܿ ܕܐܠܗܘܬܐ ܒܪܝܟ ܫܠܚܟ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib955-1">Que te soient soumises les hauteurs, les profondeurs, et tout ce qui est en elles, toi qui es les prémices de la divinité, béni soit celui qui t’a envoyé.</quote>
          </note>
        </noteGrp>
