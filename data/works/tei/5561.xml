      <bibl xml:id="work-5561" type="lawd:ConceptualWork">
        <title xml:id="name5561-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Discourse 16</title>
        <title xml:id="name5561-3" xml:lang="en" source="#bib5561-2">How profitable it is for the soul while in solitude to be free from works and how intercourse harms the mind of the novice which has but lately begun 
          to have insight for itself and how it is clear that bodily works necessarily bring about in the solitary a deficiency in divine works</title>
        <title xml:id="name5561-2" xml:lang="syr" source="#bib5561-1"><foreign xml:lang="syr">ܥܠ ܕܟܡܐ ܡܥܕܪܐ ܒܓܘ ܫܠܝܐ ܣܦܝܩܘܬܐ ܕܡܢ ܥܒܕ̈ܐ ܠܢܦܫܐ܆ ܘܡܚܣܪܝܢ ܡܥܠܐ ܘܡܦܩܐ ܠܗܘܢܐ ܫܪܘܝܐ܆ ܕܚܕܬܐܝܬ ܫܪܝ ܚܐܪ ܒܩܢܘܡܗ.
            ܘܕܢܗܝܪܐܝܬ ܥܒܕ̈ܐ ܦܓܪ̈ܢܝܐ ܠܝܚܝܕܝܐ܆ ܚܣܝܪܘܬܐ ܒܥܒܕܘ̈ܗܝ ܕܐܠܗܐ ܕܢܥܒܕ܆ ܐܠܨܐ ܠܗ</foreign></title>
        <author ref="http://syriaca.org/person/550" source="#bib5561-1" xml:lang="en">Isaac of Nineveh — <foreign xml:lang="syr">ܐܝܣܚܩ
            ܕܢܝܢܘܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5561</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5561-1"><foreign xml:lang="syr">ܒܪܢܫܐ ܣܓܝ ܨܦܬܐ܆ ܕܢܗܘܐ ܢܝܚܐ ܘܡܫܝܢܐ܆ ܠܐ ܡܫܟܚ.</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5561-2">That a man who is beset with care, should be quiet and in a state of peace, is impossible.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5561-1"><foreign xml:lang="syr">ܡܛܠ ܕܐܘܪܚܐ ܕܡܟܝ̈ܟܐ܆ ܠܐ ܪܚܡܬ݀ ܠܡܐܙܠ ܒܗ̇.</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5561-2">because it does not like to go in the way of the humble.</quote>
          </note>
        </noteGrp>
