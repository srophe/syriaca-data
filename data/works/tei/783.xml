            <bibl xml:id="work-783" ana="#syriaca-hagiographic">
        <title xml:id="name783-1" xml:lang="syr" source="#bib783-1" srophe:tags="#syriaca-headword">ܫܡܥܘܢ</title>
        <title xml:id="name783-2" xml:lang="fr-x-bhs" source="#bib783-1">Šemʿōn</title>
        <title xml:id="name783-3" xml:lang="fr" source="#bib783-1">Syméon le Vieillard (texte)</title>
        <title xml:id="name783-4" xml:lang="en" source="#bib783-1" srophe:tags="#syriaca-headword">Simeon the Elder (text)</title>
        <idno type="URI">http://syriaca.org/work/783</idno>
        <idno type="number" subtype="BHS">573</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib783-1">ܡܪܝܐ ܗܿܘ ܕܠܐ ܡܬܕܪܟ ܥܒܕܐ ܕܬܡ̈ܝܗܬܟ: ܘܠܐ ܡܬܩܕܡ ܥܘܬܪܐ ܕܪ̈ܚܡܝܟ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib783-1">Seigneur, l’action de tes merveilles est incompréhensible et la richesse de ta miséricorde est insaisissable…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib783-1">ܐܫܬܪܝ ܒܥܓܠ ܡܢ ܐܣܘܪ̈ܘܗܝ ܕܒܣܪܐ ܡܪܐ ܟܠ ܫܘܒܚܐ ܠܟ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib783-1">Aussitôt il fut délié de ses liens charnels; Seigneur de tout, gloire à toi.</quote>
          </note>
        </noteGrp>
        <listRelation>
