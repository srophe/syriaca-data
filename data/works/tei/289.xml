        <title xml:id="name289-2" xml:lang="fr-x-bhs" source="#bib289-1">Sāhdē d-Bēṯ Slōk</title>
        <title xml:id="name289-3" xml:lang="fr" source="#bib289-1">Martyrs de Karka de Beth-Selok (texte)</title>
        <title xml:id="name289-4" xml:lang="en" source="#bib289-1" srophe:tags="#syriaca-headword">The Martyrs of Karka d-Beth Slokh (text)</title>
        <idno type="URI">http://syriaca.org/work/289</idno>
        <idno type="number" subtype="BHS">68</idno>
        <idno type="number" subtype="BHO">705</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib289-1">ܗܢܐ ܟܪܟܐ ܪܒܐ: ܣܡ ܫܬܐܣܘ̈ܗܝ ܡܠܟܐ ܕܐܬܘܪ: ܗܘܿ ܕܒܣܘܪܝܝܐ ܣܪܕܢܐ ܫܡܗ ܗܘ̣ܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib289-1">Les fondations de cette place forte furent posées par un roi d’Assyrie dont le nom syriaque était Sardanâ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib289-1">ܘܒܬܪ ܗܠܝܢ ܟܠܗܘܢ ܚܫ̈ܐ ܘܬܫܢܝ̈ܕܐ ܥܙܝ̈ܙܐ ܘܩ̈ܫܝܐ: ܪ̈ܫܝܗܘܢ ܒܣܝܦܐ ܫܩܠܝܢ ܗܘ̣ܘ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib289-1">Et après toutes ces souffrances et ces supplices violents et cruels, ils furent décapités à l’épée.</quote>
          </note>
        </noteGrp>
