        <title xml:id="name318-1" xml:lang="syr" source="#bib318-1" srophe:tags="#syriaca-headword">ܒܝܩܛܘܪܝܢܘܣ ܘܒܝܩܛܘܪ ܘܢܝܩܦܘܪܘܣ ܘܩܠܘܕܝܢܘܣ ܘܕܝܕܘܪܘܣ ܘܣܪܦܝܘܢ ܘܦܦܝܘܣ</title>
        <title xml:id="name318-2" xml:lang="fr-x-bhs" source="#bib318-1">Vīqṭōrīnōs w-Vīqṭōr w-Nīqāpōrōs wa-Qlawdyānōs w-Dīyādōrōs wa-Srāpīyōn w-Pāpīyōs</title>
        <title xml:id="name318-3" xml:lang="fr" source="#bib318-1">Victorin, Victor, Nicéphore, Claudien, Diodore, Sérapion et Papius (texte)</title>
        <title xml:id="name318-4" xml:lang="en" source="#bib318-1" srophe:tags="#syriaca-headword">Victorinus, Victor, Nicephorus, Diodore, Serapion, Papias (text)</title>
        <idno type="URI">http://syriaca.org/work/318</idno>
        <idno type="number" subtype="BHS">98</idno>
        <idno type="number" subtype="BHO">1245</idno>
        <noteGrp type="prologue">
          <desc xml:lang="en">Prologue</desc>
          <note xml:lang="fr" type="prologue">
            <quote source="#bib318-1">Qui n’admirerait pas la vaillance et l’endurance de ces glorieux martyrs, mes frères, et qui n’oublierait pas sa nature en entendant l’histoire de leurs souffrances?</quote>
          </note>
          <note xml:lang="syr" type="prologue">
            <quote source="#bib318-1">ܒܚܠܝܨܘܬܐ ܘܒܡܣܝܒܪܢܘܬܐ ܕܗܠܝܢ ܣܗ̈ܕܐ ܢܨܝ̈ܚܐ ܡܢܘ ܕܠܐ ܢܬܡܗ: ܐܚܝ̈: ܘܢܛܥܐ ܟܝܢܗ ܒܬܫܥܝܬܐ ܕܚܫܝ̈ܗܘܢ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib318-1">ܘܥܠ ܡܢܐ ܗܠܝܢ ܐܡܪܢ: ܐܠܐ ܡܛܠ ܡܣܝܒܪܢܘܬܗܘܢ ܕܒܝܬ ܒܝܩܛܘܪܝܢܘܣ ܘܚܒܪ̈ܘܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib318-1">Pourquoi avons-nous dit cela, sinon à propos de l’endurance de Victorin et de ses compagnons.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib318-1">ܘܟܕ ܗܟܢܐ ܒܫܢ̈ܕܐ ܦܪ̈ܝܫܐ ܐܫܬܢܕ ܒܗܘܢ: ܒܗܝܡܢܘܬܗܘܢ ܕܠܘܬ ܐܠܗܐ ܙܕܝ̈ܩܐ ܠܐ ܐܬܚܣܢܘ: ܐܠܐ ܒܚܕܘܬܐ ܕܠܒܗܘܢ ܡܘ̈ܬܐ ܦܪ̈ܝܫܐ ܘܕܚܝ̈ܠܐ ܐܝܟ ܦܘܩܕܢܗ ܩܒܠܘ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib318-1">Et alors qu’ils subissaient ainsi divers tourments, les justes ne furent pas vaincus dans leur foi en Dieu; mais dans la joie de leur coeur ils accueillirent leurs morts variées et terribles comme son commandement.</quote>
          </note>
        </noteGrp>
