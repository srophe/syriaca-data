        <title xml:id="name1080-4" xml:lang="en" source="#bib1080-1" srophe:tags="#syriaca-headword">Mary Mother of God (Death) (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib1080-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
