        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1080-1">ܒܪܐ ܕܒܚܘܒܗ ܐܪܟܢ ܪܘܡܐ ܘܢܚܬ ܠܐܪܥܐ: ܘܠܒܫ ܦܓܪܐ ܘܗܘܐ ܐܢܫܐ ܡܢ ܒܪܬ ܕܘܝܕ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1080-1">Fils qui dans ton amour as incliné la hauteur et es descendu sur terre, as revêtu un corps et es devenu homme par l’intermédiaire de la fille de David.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1080-1">ܚܬܢܐ ܡܫܝܚܐ ܠܟ ܬܫܒܘܚܬܐ ܡܢ ܟܠ ܦܘ̈ܡܝܢ: ܘܥܠܝܢ ܪ̈ܚܡܐ ܒܟܠܥܕܢ̈ܝܢ ܐܡܝܢ ܘܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1080-1">Christ époux, à toi la gloire de toutes les bouches et sur nous miséricorde en tous temps. Amen et amen.</quote>
          </note>
        </noteGrp>
