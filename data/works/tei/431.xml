        <title xml:id="name431-2" xml:lang="fr-x-bhs" source="#bib431-1">ʾAḇrāhām</title>
        <title xml:id="name431-3" xml:lang="fr" source="#bib431-1">Abraham l’Égyptien (texte)</title>
        <title xml:id="name431-4" xml:lang="en" source="#bib431-1" srophe:tags="#syriaca-headword">Abraham the Egyptian (text)</title>
        <author xml:lang="fr" source="#bib431-1" ref="http://syriaca.org/person/474">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">ʿEnanishoʿ</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܥܢܢܝܫܘܥ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Enanicho</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/431</idno>
        <idno type="BHS">211</idno>
        <idno type="BHO">849</idno>
        <idno type="CPG">6036</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib431-1">ܐܝܬ ܗܘ̣ܐ ܕܝܢ ܬܘܒ ܐܢܫ ܡܨܪܝܐ: ܕܫܡܗ ܗܘ̣ܐ ܐܒܪܗܡ: ܗܘܿ ܕܐܬܕܒܪ ܗܘ̣ܐ ܕܘܒܪܐ ܩܫܝܐ ܘܥܓܪܐ ܒܡܕܒܪܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib431-1">Il y avait (encore) un Égyptien qui s’appelait Abraham, qui menait une vie dure et rude au désert…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib431-1">ܘܗܟܢܐ ܐܣܝܘܗܝ ܡܢ ܪܘܡܬܗ: ܘܐܝܬܝܘܗܝ ܠܗܝܿ ܕܢܪܓܫ ܒܡܚܝܠܘܬܗ ܘܕܢܕܥ ܬܘܒ ܟܪܝܗܘܬܗ: ܗܝܿ ܕܒܗܿ ܐܬܓܚܟ ܡܢ ܫܐܕ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib431-1">Et ainsi ils le gurérirent de son orgueil et l’amenèrent à sentir sa faiblesse et à connaître son infirmité pour laquelle les démons s’étaient moqués de lui.</quote>
          </note>
        </noteGrp>
