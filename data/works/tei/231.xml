        <title xml:id="name231-3" xml:lang="fr" source="#bib231-1">Martyrs de Palestine (texte)</title>
        <title xml:id="name231-4" xml:lang="en" source="#bib231-1" srophe:tags="#syriaca-headword">Martyrs of Palestine (text)</title>
        <author ref="http://syriaca.org/person/480" source="#bib231-1" xml:lang="en">Eusebius of Caesarea — <foreign xml:lang="syr">ܐܘܣܒܝܣ ܕܩܣܪܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/231</idno>
        <idno type="number" subtype="BHS">10</idno>
