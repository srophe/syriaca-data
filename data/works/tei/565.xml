        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib565-1">ܗܐ ܒܢܝܢܘܐ ܝܘܢܢ ܐܟܪܙ ܝܘܕܝܐ ܒܝܢܬ ܥܘܪ̈ܠܐ ܠܟܪܟܐ ܥܠ ܗܘܐ ܥܙܝܙܐ ܘܒܩ̈ܠܐ ܕܚܝ̈ܠܐ ܕܠܚܗܿ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib565-1">Voilà qu’à Ninive Jonas le juif a prêché parmi les incirconcis; il était entré dans la ville forte et l’a agitée par des paroles terribles.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib565-1">ܡܢ ܥܘܪ̈ܠܐ ܕܚܕܝܘ ܠܐܒܐ ܘܓܙܝܪ̈ܐ ܕܐܚܫܘ ܠܒܪܐ ܠܐܒܐ ܘܒܪܐ ܘܪܘܚ ܩܘܕܫܐ ܬܫܒܘܚܬܐ ܐܡܝܢ ܘܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib565-1">Des incirconcis qui ont réjoui le le Père et des circoncis qui ont fait souffrir le Fils, gloire au Père et au Fils et au Saint Esprit amen et amen.</quote>
          </note>
        </noteGrp>
