        <title xml:id="name914-2" xml:lang="fr-x-bhs" source="#bib914-1">Tēʾōdāsyā</title>
        <title xml:id="name914-3" xml:lang="fr" source="#bib914-1">Théodosie (texte)</title>
        <title xml:id="name914-4" xml:lang="en" source="#bib914-1" srophe:tags="#syriaca-headword">Theodosia (text)</title>
        <author ref="http://syriaca.org/person/480" source="#bib914-1" xml:lang="en">Eusebius of Caesarea — <foreign xml:lang="syr">ܐܘܣܒܝܣ ܕܩܣܪܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/914</idno>
        <idno type="number" subtype="BHS">710</idno>
        <idno type="number" subtype="BHO">1177</idno>
        <idno type="number" subtype="CPG">3490</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib914-1">ܒܫܢܬ ܚ̈ܡܫ ܕܪܕܘܦܝܐ ܕܒܝܘ̈ܡܬܢ ܐܬܡܬܚ ܗܘܐ: ܘܝܪܚܐ ܐܝܬܘܗܝ ܢܝܣܢ ܘܒܬܪܝܢ ܒܗ ܒܝܪܚܐ ܗܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib914-1">La persécution de nos jours s’était étendue jusqu’à la cinquième année, et c’était le mois de Nîsan, le deux de ce mois.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib914-1">ܝܘܡܐ ܕܝܢ ܚܕ ܒܫܒܐ ܗܘܐ ܟܕ ܗܠܝܢ ܒܩܣܪܝܐ ܡܕܝܢܬܢ ܐܣܬܥܪܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib914-1">Ce fut un dimanche que cela se passa dans notre ville de Césarée</quote>
          </note>
        </noteGrp>
