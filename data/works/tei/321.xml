            <bibl xml:id="work-321" ana="#syriaca-hagiographic">
        <title xml:id="name321-1" xml:lang="syr" source="#bib321-1" srophe:tags="#syriaca-headword">ܗܓܢܐ</title>
        <title xml:id="name321-2" xml:lang="fr-x-bhs" source="#bib321-1">Hagnē</title>
        <title xml:id="name321-3" xml:lang="fr" source="#bib321-1">Agnès (texte)</title>
        <title xml:id="name321-4" xml:lang="en" source="#bib321-1" srophe:tags="#syriaca-headword">Agnes (text)</title>
        <idno type="URI">http://syriaca.org/work/321</idno>
        <idno type="order" subtype="BHS">101</idno>
        <idno type="order" subtype="BHO">34</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib321-1">ܐܝܠܝܢ ܕܣܒܠܬ ܗܓܢܐ ܒܪܬ ܩܝܡܐ ܒܬܘܠܬܗ ܕܡܫܝܚܐ ܒܚܕ ܘܥܣܪܝܢ ܒܐܝܪܚ ܟܢܘܢ ܐܚܪܝ: ܠܐ ܗܘ̣ܐ ܒܡܕܝܢ̈ܬܐ ܫܚܝ̈ܡܬܐ ܘܠܐ ܡܫܡ̈ܗܬܐ ܣܒܠܬ: ܕܒܫܬܩܐ ܢܩܘ̈ܝܢ ܘܠܛܘܥ ܢܫ̈ܬܠܡܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib321-1">Ce qu’a supporté Agnès, bat-qyamâ et vierge du Christ le 21 Kanôn II ne s’est pas passé dans des villes ordinaires et non renommées pour rester dans le silence et être livré à l’oubli.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib321-1">ܘܐܫܘܝܗܿ ܕܐܝܟ ܩܘܪܒܢܐ ܕܟܝܐ ܒܢܘܪܐ ܬܬܩܪܒ ܠܐܠܗܐ: ܘܒܗܝܡܢܘܬܐ ܕܫܪܪܐ ܬܬܚܬܡ: ܘܒܟܠܝܠܐ ܕܣܗܕܘܬܐ ܬܬܟܠܠ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib321-1">Et il l’a jugée digne d’être offerte par le feu comme une offrande pure à Dieu, et d’être marquée par la foi de la vérité et de recevoir la couronne du martyre.</quote>
          </note>
        </noteGrp>
