        <title xml:id="name282-1" xml:lang="syr" source="#bib282-1" srophe:tags="#syriaca-headword">ܒܢܝ̈ ܫܒܝܐ ܕܒܝܬ ܙܒܕܝ</title>
        <title xml:id="name282-2" xml:lang="fr-x-bhs" source="#bib282-1">Bnay šeḇyā d-Bēṯ Zabday</title>
        <title xml:id="name282-3" xml:lang="fr" source="#bib282-1">Martyrs captifs de Bet-Zabday (texte)</title>
        <title xml:id="name282-4" xml:lang="en" source="#bib282-1" srophe:tags="#syriaca-headword">The Imprisoned Martyrs of Beth Zabdai (text)</title>
        <idno type="URI">http://syriaca.org/work/282</idno>
        <idno type="number" subtype="BHS">61</idno>
        <idno type="number" subtype="BHO">375</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib282-1">ܒܫܢܬ ܚܡܫܝܢ ܘܬܠܬ ܕܫܒܘܪ ܡܠܟܐ ܕܦܪ̈ܣܝܐ: ܣܠܩ ܗܘ̣ܐ ܥܠ ܬܚܘ̈ܡܐ ܘܚܣ̈ܢܐ ܕܪ̈ܗܘܡܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib282-1">En l’an cinquante-trois de Shabour roi de Perse, il était monté contre les frontières et les fortreresses des Romains.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib282-1">ܘܫܩܠ ܐܢܘܢ ܠܓܪ̈ܡܐ ܗܢܿܘܢ ܡܢ ܡܥܪܬܐ ܗܝܿ: ܘܣܡ ܐܢܘܢ ܒܗ ܒܒܝܬܐ ܕܒܢܐ. ܘܗܐ ܡܬܥܒܕ ܬܡܢ ܟܢܫܐ ܥܕܡܐ ܠܝܘܡܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib282-1">Et il prit ces ossements de cette grotte, et il les plaça dans une maison qu’il avait construite. Et voilà qu’une communauté a été établie là jusqu’aujourd’jui.</quote>
          </note>
        </noteGrp>
