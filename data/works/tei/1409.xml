            <bibl xml:id="work-1409" ana="#syriaca-hagiographic">
        <title xml:id="name1409-1" xml:lang="syr" source="#bib1409-1" srophe:tags="#syriaca-headword">ܓܪܝܓܘܪܝܘܣ</title>
        <title xml:id="name1409-2" xml:lang="fr-x-bhs" source="#bib1409-1">Grīǥōryōs</title>
        <title xml:id="name1409-3" xml:lang="fr" source="#bib1409-1">Grégoire l’Illuminateur (texte)</title>
        <title xml:id="name1409-4" xml:lang="en" source="#bib1409-1" srophe:tags="#syriaca-headword">Gregory the Illuminator (text)</title>
        <author xml:lang="fr" source="#bib1409-1">Agathange (résumé)</author>
        <idno type="URI">http://syriaca.org/work/1409</idno>
        <idno type="number" subtype="BHS">1279</idno>
        <idno type="number" subtype="CPG">7547</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1409-1">ܐܝܬ ܗܘܐ ܒܐܪܡܐܢܝܐ ܡܠܟܐ ܚܕ ܕܡܬܩܪܐ ܣܢܛܪܘܓ. ܒܪ ܚܬܗ ܕܐܒܓܪ ܡܠܟܐ ܕܐܘܪܗܝ. ܗܕܐ ܗܘ ܕܟܬܒ ܐܓܪܬܐ ܠܡܫܝܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1409-1">Il y avait en Arménie un roi appelé Sanatroug, fils de la soeur du roi d’Édesse Abgar, celui qui écrivit une lettre au Christ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1409-1">ܘܒܙܒ̈ܢܝ ܐܪܩܠܐܝ ܡܠܟܐ̣. ܫܕܪ ܫܩܠܗ ܠܡܕܝܢܬܐ ܘܒܢܐ ܥܠܘܗܝ ܗܝܟܠܐ ܫܒܝܚܐ. ܗܘ ܕܒܨ̈ܠܘܬܗ ܕܩܕܝܫܐ ܓܪܝܓܘܪܝܘܣ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1409-1">Et au temps de l’empereur Héraclius, il envoya prendre la ville et construisit sur lui un temple magnifique. Aux prières de saint Grégoire… Amen.</quote>
          </note>
        </noteGrp>
