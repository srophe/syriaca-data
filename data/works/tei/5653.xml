    <body>
      <bibl xml:id="work-5653" type="lawd:ConceptualWork">
        <title xml:id="name5653-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Edict of Constantine against the Arians</title>
        <title xml:id="name5653-2" xml:lang="syr" srophe:tags="#syriaca-headword" source="#bib5653-4">ܣܐܩܪܐ ܕܝܠܗ ܕܩܘܣܛܢܛܝܢܘܣ ܕܠܘܩܒܠ ܐܪ̈ܝܢܘ</title>
        <title xml:id="name5653-3" xml:lang="en" source="#bib5653-1">Injunction of the Same Constantine, against the Arians</title>
        <title xml:id="name5653-4" xml:lang="en" source="#bib5653-2">Letter of the same Constantine against the Arians</title>
        <author ref="http://syriaca.org/person/1655" source="#bib5653-1" xml:lang="en">Constantine the Great — <foreign xml:lang="syr">ܩܘܣܛܢܛܝܢܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5653</idno>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note xml:lang="en" type="abstract" corresp="http://syriaca.org/nhsl" source="#bib5653-2">This edict by Constantine I rebukes and rejects Arius and his followers, calling them "Porphyrians" after the name of a Neoplatonic philosopher well known for his anti-Christian polemics, Porphyry, and his followers. And just as Porphyry's writings were destroyed, Arius's writings are ordered to likewise be destroyed. In this way, the memory of both Arius and his doctrine is to be blotted out, and anyone found to be concealing his writings is to suffer capital punishment.</note>
        </noteGrp>
        <!-- A critical Syriac edition exists but is not in CBSS, so it could not be encoded under Editions: Friedrich Schulthess, Die syrischen Kanones der Synoden von Nicaea bis Chalcedon nebst einigen zugehörigen Dokumenten (Abhandlungen der Königlichen Gesellschaft der Wissenschaften zu Göttingen, Phil.-hist. Kl., N.F. 10.2; Berlin, 1908; repr. Gorgias Press, Syriac Studies Library 17, 2010). -->
        <listBibl type="manuscripts">
          <head>Manuscripts</head>
          <desc xml:lang="en">This is not a comprehensive list of manuscripts related to this work.</desc>
          <!-- ff. 25v-36v cover the whole Nicene dossier (letter of Constantine summoning the bishops, this edict, Nicene Creed, Creed of Constantinople, canons, subscriptions). The folios of the edict alone could not be determined: the digital images are currently unavailable on the British Library's Archives and Manuscripts Catalogue, which is an interim version while the Library recovers from a cyber-attack (https://searcharchives.bl.uk/catalog/040-002086194). -->
          <!-- Per the BL catalogue, the colophon on f. 151r states that the canons were translated from Greek into Syriac at Mabbug in AG 812 (501 CE), possibly also the year of copying. The Syriac translator is anonymous. -->
          <bibl xml:id="bib5653-3" type="syriaca:Manuscript">
            <label>London, British Library <idno type="shelfmark" subtype="BL">Add. 14528</idno>
            </label>
            <citedRange unit="fol">25v-36v</citedRange>
          </bibl>
        </listBibl>
        <listBibl type="modernTranslations">
          <head>Modern Translations</head>
          <desc xml:lang="en">This is not a comprehensive list of modern translations related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <!-- Cowper, Analecta Nicaena, p. iii, n. 1, identifies his manuscript as "Add. MSS. in the British Museum, No. 14528". -->
          <bibl xml:id="bib5653-1" type="syriaca:ModernTranslation">
            <title xml:lang="en">Analecta Nicæna: Fragments Relating to the Council of Nice. The Syriac Text, from an Ancient Ms. in the British Museum</title>
            <editor>Benjamin Harris Cowper</editor>
            <ptr target="http://syriaca.org/cbss/6QTR6IKU"/>
            <citedRange unit="p">21-22</citedRange>
            <textLang mainLang="en"/>
            <listRelation>
              <relation active="#bib5653-1" ref="dcterms:source" passive="#bib5653-3">
                <desc xml:lang="en">
                  <label>London, British Library <idno type="shelfmark">Add. 14528</idno>
                  </label>
                </desc>
              </relation>
            </listRelation>
          </bibl>
          <bibl xml:id="bib5653-2" type="syriaca:ModernTranslation">
            <title xml:lang="en">Syriac Miscellanies; or, Extracts Relating to the First and Second General Councils, and Various Other Quotations, Theological, Historical, and Classical</title>
            <editor>Benjamin Harris Cowper</editor>
            <ptr target="http://syriaca.org/cbss/3I5KZ334"/>
            <citedRange unit="p">6-7</citedRange>
            <textLang mainLang="en"/>
            <listRelation>
              <relation active="#bib5653-2" ref="dcterms:source" passive="#bib5653-3">
                <desc xml:lang="en">
                  <label>London, British Library <idno type="shelfmark">Add. 14528</idno>
                  </label>
                </desc>
              </relation>
            </listRelation>
          </bibl>
        </listBibl>
        <listBibl type="secondaryLiterature">
          <head>Secondary Literature</head>
          <desc xml:lang="en">This is not a comprehensive list of secondary literature related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <bibl xml:id="bib5653-4" type="lawd:Citation">
            <title xml:lang="en">Catalogue of Syriac Manuscripts in the British Museum, Acquired since the Year 1838</title>
            <author>William Wright</author>
            <ptr target="http://syriaca.org/cbss/9HGARXCQ"/>
            <citedRange unit="vol">2</citedRange>
            <citedRange unit="p">1030</citedRange>
          </bibl>
        </listBibl>
      </bibl>
