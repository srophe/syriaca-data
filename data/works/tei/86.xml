        <title xml:id="name86-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib86-5">1 Tim</title>
        <title xml:id="name86-5" xml:lang="en" source="#bib86-5 #bib86-21 #bib86-25 #bib86-27 #bib86-29 #bib86-31 #bib86-33 #bib86-35 #bib86-37 #bib86-43 #bib86-45 #bib86-49">1 Timothy</title>
        <title xml:id="name86-6" xml:lang="syr-Syrj" source="#bib86-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܛܺܝܡܳܬܶܐܳܘܣ ܩܰܕܡܳܝܬܳܐ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name86-7" source="#bib86-21">ܫܠܡܬ ܐܓܪܬܐ ܕܠܘܬ ܛܝܡܬܐܘܣ ܩܕܡܝܬܐ ܕܐܬܟܬܒܬ ܐܬܢܘܣ ܒܝܕ ܠܘܩܐ ܬܠܡܝܕܗ. ܕܐܝܬ ܒܗ̇ ܦܬ̈ܓܡܐ ܬܠܬܡܐܐ ܘܬܠܬܝܢ ܘܬܡܢܝܐ .ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name86-8" source="#bib86-23 #bib86-39">The Epistle of 1 Timothy, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name86-9" source="#bib86-27">ܫܠܡܬ. ܐܓܪܬܐ. ܕܠܘܬ. ܛܝܡܬܐܘܣ. ܩܕܡܢܬܐ . ܕܐܬܟܬܒܬ. ܡܢ ܠܕܝܩܝܐ. ܘܗܘܝܐ. ܡܐܬܝܢ܀ ܘܥܣܪܝܢ. ܘܫܬܐ܀ ܦܬܓ̈ܡܝܢ:.</title>
        <title xml:lang="en" xml:id="name86-10" source="#bib86-41">1 Timothy according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name86-11" source="#bib86-47">The Epistle of 1 Timothy</title>
        <title xml:lang="syr" xml:id="name86-12" source="#bib86-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܛܝܡܬ݂ܐܘܣ ܩܕ݂ܡܝܬ݁ܐ</title>
        <title xml:lang="syr-Syrj" xml:id="name86-13" source="#bib86-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܛܺܝܡܳܬ݂ܶܐܘܳܣ ܩܰܕ݂ܡܳܝܬ݁ܳܐ</title>
        <title xml:lang="en" xml:id="name86-14" resp="http://syriaca.org">The First Epistle to Timothy</title>
        <idno type="URI">http://syriaca.org/work/86</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/First_Epistle_to_Timothy</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q131180</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/86">1 Timothy (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
