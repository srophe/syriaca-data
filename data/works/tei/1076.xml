        <title xml:id="name1076-3" xml:lang="fr" source="#bib1076-1">Marie Mère de Dieu (texte)</title>
        <title xml:id="name1076-4" xml:lang="en" source="#bib1076-1" srophe:tags="#syriaca-headword">Mary Mother of God (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib1076-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
