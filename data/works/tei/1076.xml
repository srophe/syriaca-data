        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1076-1">ܛܒܐ ܕܦܬܝܚ ܬܪܥܗ ܠܒܝ̈ܫܐ ܘܠܚܛܝ̈ܐ: ܗܒ ܠܝ ܐܥܘܠ ܐܚܙܐ ܫܘܦܪܟ ܟܕ ܬܗܪ ܐܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1076-1">Toi le bon dont la porte est ouverte aux mauvais et aux pécheurs, donne-moi d’entrer et de voir ta beauté avec étonnement.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1076-1">ܛܘܒܝܗܿ ܕܒܪܗܿ ܝܗܒ ܛܘܒܐ ܠܟܠ ܛܘ̈ܒܢܐ: ܒܪܝܟ ܕܕܢܚ ܠܢ ܡܢ ܕܟܝܘܬܗܿ ܩܕܝܫܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1076-1">Bienheureuse celle dont le fils déclare bienheureux tous les bienheureux; béni soit celui qui est apparu venant saintement de sa pureté.</quote>
          </note>
        </noteGrp>
