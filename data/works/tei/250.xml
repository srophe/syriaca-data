        <title xml:id="name250-4" xml:lang="en" source="#bib250-1" srophe:tags="#syriaca-headword">The Children or Sleepers of Ephesus (text)</title>
        <idno type="URI">http://syriaca.org/work/250</idno>
        <idno type="number" subtype="BHS">29</idno>
        <idno type="number" subtype="BHO">1013</idno>
