        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib250-1">ܟܕ ܕܝܢ ܕܩܝܘܣ ܥܘܠܐ ܐܡܠܟ ܗܘ̣ܐ: ܘܢܚܬ ܗܘ̣ܐ ܠܒܘܙܢܛܝܐ ܡܕܝܢܬܐ ܡܢ ܓܪܬܓܢܐ ܡܕܝܢܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib250-1">Sous le règne de l’impie Dèce, il était descendu dans la ville de Byzance en venant de la ville de Carthagène.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib250-1">ܘܒܚܕܘܬܐ ܕܗܝܡܢܘܬܗ ܐܙܠܘ ܥܡܗ ܐܦܣ̈ܩܘܦܐ ܠܩܘܣܛܢܛܝܢܘܦܘܠܝܣ ܟܕ ܡܫܒܚܝܢ ܠܐܠܗܐ. ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib250-1">Et dans la joie de sa foi les évêques allèrent avec lui à Constantinople en louant Dieu. Amen.</quote>
          </note>
        </noteGrp>
