            <bibl xml:id="work-966" ana="#syriaca-hagiographic">
        <title xml:id="name966-1" xml:lang="syr" source="#bib966-1" srophe:tags="#syriaca-headword">ܡܩܒ̈ܝܐ</title>
        <title xml:id="name966-2" xml:lang="fr-x-bhs" source="#bib966-1">Maqbāyē</title>
        <title xml:id="name966-3" xml:lang="fr" source="#bib966-1">Macchabées (texte)</title>
        <title xml:id="name966-4" xml:lang="en" source="#bib966-1" srophe:tags="#syriaca-headword">The Maccabees (text)</title>
        <author xml:lang="fr" source="#bib966-1" ref="http://syriaca.org/person/51">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Severus</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/10">Antioch</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܣܘܝܪܝܘܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܢܛܝܘܟܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Sévère</forename>
                        <addName type="untagged-title">d’Antioche</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/966</idno>
        <idno type="number" subtype="BHS">773</idno>
        <idno type="number" subtype="BHO">app</idno>
        <idno type="number" subtype="CPG">7035</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib966-1">ܩܘܠܣܗܘܢ ܡܿܢ ܕܛ̈ܠܝܐ ܡܩ̈ܒܝܐ̣. ܕܡܛܠ ܫܒܝܚܘܬܐ ܕܬܟܬ̈ܘܫܝܗܘܢ̣. ܡܣ̣ܬܒܪ ܡܿܢ̣. ܕܗ̈ܘܠܣ ܥܬܝܪ̈ܬܐ ܕܗܘ̈ܢܐ ܝܗܿܒ ܠܗܿܢܘܢ ܕܐܡܪܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib966-1">L’éloge de jeunes Macchabées, à cause de la gloire de leurs combats, semble donner à ceux qui en parleront d’abondantes matières à penser.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib966-1">ܡܛܠ ܕܠܐ ܚܝܪܝܢ ܠܘܬ ܣܒܪܐ ܗܿܘ ܫܒܝܚܐ. ܗܿܘ ܕܚܢܢ ܡܢ ܙܠܝܩܗ ܢܗ̣ܪܢܢ. ܒܛܝܒܘܬܐ ܘܒܡܪܚܡܢܘܬܗ ܕܗܿܘ ܕܠܗܕܐ ܩ̣ܪܢ. ܕܠܗ ܫܘܒܚܐ ܠܥܠܡܝܢ ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib966-1">Car ils ne regardent pas le glorieux espoir de l’éclat duquel nous avons brillé, par la grâce et la miséricorde qui nous a appelés à cet espoir; à lui la gloire dans les siècles. Amen.</quote>
          </note>
        </noteGrp>
