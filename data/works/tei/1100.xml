            <bibl xml:id="work-1100" ana="#syriaca-hagiographic">
        <title xml:id="name1100-1" xml:lang="syr" source="#bib1100-1" srophe:tags="#syriaca-headword">ܪܚܝܡܐ</title>
        <title xml:id="name1100-2" xml:lang="fr-x-bhs" source="#bib1100-1">Rḥīmā</title>
        <title xml:id="name1100-3" xml:lang="fr" source="#bib1100-1">Rehima d’Adiabène (texte)</title>
        <title xml:id="name1100-4" xml:lang="en" source="#bib1100-1" srophe:tags="#syriaca-headword">Reḥima of Adiabene (text)</title>
        <author ref="http://syriaca.org/person/901" source="#bib1100-1" xml:lang="en">Mshihazka — <foreign xml:lang="syr">ܡܫܝܚܐܙܟܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1100</idno>
        <idno type="number" subtype="BHS">930</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1100-1">ܡܪܝ ܪܚܝܡܐ: ܗܢܐ ܐܒܐ ܡܢ ܐܪܒܝܠ ܡܕܝܢܬܐ ܐܝܬܘܗܝ ܗܘܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1100-1">Mar Rehîmâ: ce Père était originaire de la ville d’Arbèles.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1100-1">Et dans ce travail spirituel il acheva sa vie et il partit vers son Seigneur en l’an douze de Yezdegerd.</quote>
          </note>
        </noteGrp>
        <listRelation>
          <relation ref="syriaca:commemorates" active="http://syriaca.org/work/1100" source="#bib1100-1" passive="http://syriaca.org/person/2036">
