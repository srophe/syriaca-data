        <title xml:id="name662-2" xml:lang="fr-x-bhs" source="#bib662-1">Pākōm</title>
        <title xml:id="name662-3" xml:lang="fr" source="#bib662-1">Pachôme (texte)</title>
        <title xml:id="name662-4" xml:lang="en" source="#bib662-1" srophe:tags="#syriaca-headword">Pachomius (text)</title>
        <author xml:lang="fr" source="#bib662-1" ref="http://syriaca.org/person/474">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">ʿEnanishoʿ</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܥܢܢܝܫܘܥ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Enanicho</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/662</idno>
        <idno type="BHS">446</idno>
        <idno type="BHO">849</idno>
        <idno type="CPG">6036</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib662-1">ܐܢܫ ܬܘܒ ܐܚܪܢܐ ܕܫܡܗ ܦܟܘܡ̣ ܒܪ ܫܒ̈ܥܝܢ ܫܢܝܢ̣ ܝܿܬܿܒ ܗܘܐ ܒܛܘܪܐ ܕܫܡܗ ܣܩܝܛܝܩܣ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib662-1">Un autre, du nom de Pachôme, âgé de soixante-dix ans, vivait sur une montagne appelée Scété.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib662-1">ܘܟܕ ܚ̣ܙܐ ܕܝܘܐ ܕܪܓܬܐ ܕܠܐ ܪܢܿܐ ܐܢܐ ܒܗܿ ܒܥܒܝܕܬܐ̣ ܬܘܒ ܠܐ ܩ̣ܪܒ ܨܐܕܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib662-1">Et quand le démon du désir vit que je ne pensais plus à l’affaire, il ne s’approcha plus de moi.</quote>
          </note>
        </noteGrp>
