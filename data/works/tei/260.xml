        <title xml:id="name260-3" xml:lang="fr" source="#bib260-1">Zébinas, Lazare, Maroutha, Narsès, Élie, Mahri, Ḥabib, Saba, Berikhicho, Jonas and Chembaiteh (texte)</title>
        <title xml:id="name260-4" xml:lang="en" source="#bib260-1" srophe:tags="#syriaca-headword">Zebinas, Lazarus, Maroutha, Narses, Elijah, Mahri, Habib, Saba, Berikhicho, Jonah and Chembaiteh (text)</title>
              <author ref="http://syriaca.org/person/2814" source="#bib260-1" xml:lang="en">Isaiah of Arzun — <foreign xml:lang="syr">ܐܫܥܝܐ ܐܪܙܢܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/260</idno>
        <idno type="number" subtype="BHS">39</idno>
        <idno type="number" subtype="BHO">531</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib260-1">ܒܫܢܬ ܬܡܢܥܣܪ̈ܐ ܕܡܠܟܘܬܗ ܕܫܒܘܪ ܡܠܟܐ ܕܦܪ̈ܣܝܐ: ܥܒܕ ܪܕܘܦܝܐ ܪܒܐ ܠܥܕܬܗ ܕܡܫܝܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib260-1">En la dix-huitième année du règne de Shahpour roi de Perse, il fit une grande persécution contre l’Église du Christ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib260-1">ܐܬܟܠܠܘ ܕܝܢ ܣܗ̈ܕܐ ܗܠܝܢ ܩܕܝ̈ܫܐ ܡܢ ܪܫܗܘܢ ܥܕܡܐ ܠܫܘܠܡܗܘܢ ܒܥܣܪܝܢ ܘܬܫܥܐ ܒܝܪܚ ܟܢܘܢ ܩܕܡ ܒܕܣܗܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib260-1">Ces saints martyrs furent couronnés du premier au dernier le 29 du mois lunaire de Kanôn I.</quote>
          </note>
        </noteGrp>
