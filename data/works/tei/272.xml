        <title xml:id="name272-1" xml:lang="syr" source="#bib272-1" srophe:tags="#syriaca-headword">ܒܪܫܒܝܐ</title>
        <title xml:id="name272-2" xml:lang="fr-x-bhs" source="#bib272-1">Baršeḇyā</title>
        <title xml:id="name272-3" xml:lang="fr" source="#bib272-1">Barshebya (texte)</title>
        <title xml:id="name272-4" xml:lang="en" source="#bib272-1" srophe:tags="#syriaca-headword">Barshebya (text)</title>
        <idno type="URI">http://syriaca.org/work/272</idno>
        <idno type="number" subtype="BHS">51</idno>
        <idno type="number" subtype="BHO">146</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib272-1">ܒܗ ܒܙܒܢܐ ܗܢܐ ܕܡܝܠܣ ܛܘܒܢܐ ܐܬܟܠܠ: ܪܫܕܝܪܐ ܚܕ ܐܝܬ ܗܘ̣ܐ ܒܐܬܪܐ ܕܦܪܣ: ܕܫܡܗ ܗܘ̣ܐ ܒܪܫܒܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib272-1">Au même temps où fut couronné le bienheureux Mîlès, il y avait au pays de Perse un abbé dont le nom était Barshebyâ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib272-1">ܘܐܦ ܐܢܬܬܗ ܘܒܢܘ̈ܗܝ ܘܒ̈ܢܝ ܒܝܬܗ ܒܥܠܬܗ ܡܗܝܡ̈ܢܐ ܫܪܝܪ̈ܐ ܗܘܘ: ܘܒܕܚܠܬ ܐܠܗܐ ܟܠܗܘܢ ܝܘ̈ܡܬܐ ܕܚܝܝ̈ܗܘܢ ܐܬܕܒܪܘ. ܐܬܟܠܠܘ ܕܝܢ ܩܕܝ̈ܫܐ ܒܫܒܥܣܪܐ ܒܝܪܚ ܚܙܝܪܢ ܒܕܣܗܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib272-1">Et sa femme, ses fils et ses domestiques devinrent aussi de vrais croyants à cause de lui et ils vécurent dans la crainte de Dieu tous les jours de leur vie. Les saints furent couronnés le 17 du mois lunaire de Hazîran.</quote>
          </note>
        </noteGrp>
