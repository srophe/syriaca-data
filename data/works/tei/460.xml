        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib460-1">ܕܘܪܘܬܐܐ ܩܫܝܫܐ ܐܝܬ ܗܘ̣ܐ ܕܥܡܿܪ ܗܘ̣ܐ ܒܡܥܪܬܐ ܚܕܐ: ܘܩܢܐ ܗܘ̣ܐ ܛܒܘܬܐ ܝܬܝܪ ܡܢ ܣܓܝ̈ܐܐ: ܘܚܝܿܐ ܗܘ̣ܐ ܚܝ̈ܐ ܡܥܠܝ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib460-1">Le prêtre Dorothée, qui demeurait dans une grotte, avait acquis plus de bonté que beaucoup de gens et il vivait une vie élevée.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib460-1">ܘܟܕ ܢܣܿܒ ܐܢܘܢ ܡܨܐ ܠܡܦܪܢܣܘ ܐܢܘܢ ܫܦܝܪ ܥܠ ܐܝܠܝܢ ܕܚܬܝܬܐܝܬ ܡܦܣ ܕܣܢܝܩܝܢ: ܐܢܐ ܓܝܪ ܠܐ ܣܦܿܩ ܐܢܐ ܠܗܠܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib460-1">Et quand il les recevait il pouvait les distribuer bien à ceux dont il savait précisément qu’ils en avaient besoin.Car moi j’en suis incapable.</quote>
          </note>
        </noteGrp>
