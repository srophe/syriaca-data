        <title xml:id="name460-2" xml:lang="fr-x-bhs" source="#bib460-1">Dōrōṯēʾā</title>
        <title xml:id="name460-3" xml:lang="fr" source="#bib460-1">Dorothée (texte)</title>
        <title xml:id="name460-4" xml:lang="en" source="#bib460-1" srophe:tags="#syriaca-headword">Dorotheos (text)</title>
        <author ref="http://syriaca.org/person/474" source="#bib460-1" xml:lang="en">ʿEnanishoʿ — <foreign xml:lang="syr">ܥܢܢܝܫܘܥ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/460</idno>
