        <title xml:id="name668-4" xml:lang="en" source="#bib668-1" srophe:tags="#syriaca-headword">Valens the Palestinian (text)</title>
        <author xml:lang="fr" source="#bib668-1" ref="http://syriaca.org/person/474">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">ʿEnanishoʿ</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܥܢܢܝܫܘܥ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Enanicho</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/668</idno>
        <idno type="number" subtype="BHS">452</idno>
        <idno type="number" subtype="BHO">849</idno>
