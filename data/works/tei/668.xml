        <noteGrp type="prolog">
          <desc xml:lang="en">Prolog</desc>
          <note xml:lang="fr" type="prolog">
            <quote source="#bib668-1">C’est une nécessité, mes frères, de rappeler  aussi les histoires concernant la vie de ceux qui ont dévié et sont tombés…</quote>
          </note>
          <note xml:lang="syr" type="prolog">
            <quote source="#bib668-1">ܡܢ ܐܠܝ̈ܨܬܐ ܕܝܢ ܐܝܬܝܗܿ ܐܚܝ̈ ܕܢܥܗܕ ܬܘܒ ܐܦ ܬܫ̈ܥܝܬܐ ܕܥܠ ܕܘܒܪܐ ܕܐܝܠܝܢ ܕܐܫܬܪܥܘ ܘܢܦܠܘ...</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib668-1">ܐܢܫ ܐܝܬ ܗܘܐ ܕܫܡܗ ܘܠܝܣ. ܒܓܢܣܗ ܡܿܢ ܐܝܬܘܗܝ ܗܘܐ ܦܠܣܛܝܢܝܐ̣ ܒܪܥܝܢܗ ܕܝܢ ܩܘܪܢܬܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib668-1">Il y avait quelqu’un qui s’appelait Valens; il était Palestinien par sa race, mais Corinthien par sa pensée.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib668-1">ܕܟܐ̈ܒܐ ܣܩ̈ܘܒܠܝܐ ܒܣܡ̈ܡܢܐ ܕܠܩܘܒܠܐ ܡܬܐܣܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib668-1">Les maladies contraires sont soignées par des médicaments opposés.</quote>
          </note>
        </noteGrp>
