        <title xml:id="name278-3" xml:lang="fr" source="#bib278-1">Martyrs de Perse (texte)</title>
        <title xml:id="name278-4" xml:lang="en" source="#bib278-1" srophe:tags="#syriaca-headword">Martyrs of Persia (text)</title>
        <idno type="URI">http://syriaca.org/work/278</idno>
