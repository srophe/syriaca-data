        <idno type="number" subtype="BHO">711</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib278-1">ܒܗ ܒܙܒܢܐ ܗܢܐ ܕܐܬܟܠܠ ܩܕܝܫܐ ܒܪܒܥܫܡܝܢ: ܙܩܦ ܗܘ̣ܐ ܡܚܫܘܠܐ ܩܫܝܐ ܥܠ ܐܬܪܢ: ܘܐܘܠܨܢܐ ܪܒܐ ܥܠ ܥܡܢ: ܘܥܩܘܪܝܐ ܠܥ̈ܕܬܢ: ܘܦܘܪܣܝܐ ܠܬܫܡܫܬܢ. ܘܫܪܝܘ ܚܝ̈ܠܬܢܐ ܒܝܘܬܪ̈ܢܐ: ܘܪ̈ܦܝܐ ܒܚܘܣܪ̈ܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib278-1">À l’époque même où fut couronné saint Barba‘shmîn, se souleva une tempête violente contre notre région, une grande affliction contre notre peuple, une destruction contre nos Églises, la profanation contre nos rites; les forts commencèrent à croître, et les mous à diminuer.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib278-1">ܕܠܗܠ ܣܒܪܟ: ܘܗܪܟܐ ܣܘܟܝܟ. ܘܗܪܟܐ ܠܥܠܡ: ܘܬܡܢ ܠܥܠܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib278-1">Car ton espoir est là-haut et ici-bas ton attente; ce qui est ici est temporaire, ce qui est là-bas éternel.</quote>
          </note>
        </noteGrp>
