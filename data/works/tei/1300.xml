        <title xml:id="name1300-2" xml:lang="fr-x-bhs" source="#bib1300-1">Yawsef</title>
        <title xml:id="name1300-3" xml:lang="fr" source="#bib1300-1">Joseph (texte)</title>
        <title xml:id="name1300-4" xml:lang="en" source="#bib1300-1" srophe:tags="#syriaca-headword">Joseph (text)</title>
        <author ref="http://syriaca.org/person/650" source="#bib1300-1" xml:lang="en">Narsai — <foreign xml:lang="syr">ܢܪܣܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1300</idno>
        <idno type="number" subtype="BHS">1150</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1300-1">ܬܐ ܠܟ ܡܘܫܐ ܪܫܐ ܘܒܘܟܪܐ ܕܟܠܗܘܢ ܢܒ̈ܝܐ: ܡܠܠ ܥܡܢ ܒܢܒܝܘܬܐ ܡܛܠ ܝܘܣܦ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1300-1">Viens Moïse, chef et prémices de tous les prophètes, parle avec nous en prophétie de Joseph.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1300-1">ܐܠܗܗ ܕܐܒܝ ܢܗܘܐ ܥܡܟܘܢ ܘܢܢܛܪܟܘܢ. ܘܗܘ ܢܥܬܪܟܘܢ ܘܢܒܪܟܟܘܢ ܒܟܠ ܚܝܝ̈ܟܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1300-1">Que le Dieu de mon père soit avec vous et vous garde, qu’il vous fasse prospérer et vous bénisse pendant toute votre vie.</quote>
          </note>
        </noteGrp>
