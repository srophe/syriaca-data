    <body>
      <bibl xml:id="work-5654" type="lawd:ConceptualWork">
        <title xml:id="name5654-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Nicene Creed</title>
        <title xml:id="name5654-2" xml:lang="syr" srophe:tags="#syriaca-headword" source="#bib5654-4">ܣܝܡܐ ܕܗܝܡܢܘܬܐ</title>
        <title xml:id="name5654-3" xml:lang="en" source="#bib5654-1">Confession of Faith Which Was Made at Nicea</title>
        <title xml:id="name5654-4" xml:lang="en" source="#bib5654-4">The Nicene Creed</title>
        <idno type="URI">http://syriaca.org/work/5654</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note xml:lang="en" type="abstract" corresp="http://syriaca.org/nhsl" source="#bib5654-1 #bib5654-2">This is the creed of the First Council of Nicaea (325) in a Syriac conciliar collection. Cowper's translation begins "I believe in one God" and ends with anathemas against those who say that the Son once did not exist or is mutable. The collection places a separate "Confession of Faith of 150 Bishops who were at Constantinople" immediately following.</note>
        </noteGrp>
        <listRelation>
          <relation type="disambiguation" ref="syriaca:different-from" active="http://syriaca.org/work/5654" passive="http://syriaca.org/work/5655">
            <desc xml:lang="en">
              <title ref="http://syriaca.org/work/5655">Confession of Faith of 150 Bishops Who Were at Constantinople</title>
            </desc>
          </relation>
        </listRelation>
        <listBibl type="editions">
          <head>Editions</head>
          <desc xml:lang="en">This is not a comprehensive list of editions related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <!-- Syriac text, with Schulthess's introduction and critical notes in German. Reprinted by Gorgias Press (Syriac Studies Library 17, 2010). -->
          <bibl xml:id="bib5654-5" type="lawd:Edition">
            <title xml:lang="de">Die syrischen Kanones der Synoden von Nicaea bis Chalcedon nebst einigen zugehörigen Dokumenten</title>
            <editor>Friedrich Schulthess</editor>
            <ptr target="http://syriaca.org/cbss/UPB7QVNB"/>
            <textLang mainLang="syr" otherLangs="de"/>
          </bibl>
        </listBibl>
        <listBibl type="manuscripts">
          <head>Manuscripts</head>
          <desc xml:lang="en">This is not a comprehensive list of manuscripts related to this work.</desc>
          <!-- ff. 25v-36v cover the whole Nicene dossier (letter of Constantine summoning the bishops, the edict against the Arians, this creed, the Creed of Constantinople, canons, subscriptions). The folios of the creed alone could not be determined: the digital images are currently unavailable on the British Library's Archives and Manuscripts Catalogue, which is an interim version while the Library recovers from a cyber-attack (https://searcharchives.bl.uk/catalog/040-002086194). -->
          <!-- Per the BL catalogue, the colophon on f. 151r states that the canons were translated from Greek into Syriac at Mabbug in AG 812 (501 CE), possibly also the year of copying. The Syriac translator is anonymous. -->
          <bibl xml:id="bib5654-3" type="syriaca:Manuscript">
            <label>London, British Library <idno type="shelfmark" subtype="BL">Add. 14528</idno>
            </label>
            <citedRange unit="fol">25v-36v</citedRange>
          </bibl>
        </listBibl>
        <listBibl type="modernTranslations">
          <head>Modern Translations</head>
          <desc xml:lang="en">This is not a comprehensive list of modern translations related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <!-- Cowper, Analecta Nicaena, p. iii, n. 1, identifies his manuscript as "Add. MSS. in the British Museum, No. 14528". -->
          <!-- Cowper's Analecta Nicaena prints the Syriac text of the manuscript as well as the English translation. It is an edition of one manuscript, not a modern critical edition based on a collation of all witnesses. The CBSS identifier 6QTR6IKU denotes Cowper's book, not this creed. -->
          <bibl xml:id="bib5654-1" type="syriaca:ModernTranslation">
            <title xml:lang="en">Analecta Nicæna: Fragments Relating to the Council of Nice. The Syriac Text, from an Ancient Ms. in the British Museum</title>
            <editor>Benjamin Harris Cowper</editor>
            <ptr target="http://syriaca.org/cbss/6QTR6IKU"/>
            <citedRange unit="p">22</citedRange>
            <textLang mainLang="en" otherLangs="syr"/>
            <listRelation>
              <relation active="#bib5654-1" ref="dcterms:source" passive="#bib5654-3">
                <desc xml:lang="en">
                  <label>London, British Library <idno type="shelfmark">Add. 14528</idno>
                  </label>
                </desc>
              </relation>
            </listRelation>
          </bibl>
          <bibl xml:id="bib5654-2" type="syriaca:ModernTranslation">
            <title xml:lang="en">Syriac Miscellanies; or, Extracts Relating to the First and Second General Councils, and Various Other Quotations, Theological, Historical, and Classical</title>
            <editor>Benjamin Harris Cowper</editor>
            <ptr target="http://syriaca.org/cbss/3I5KZ334"/>
            <citedRange unit="p">7</citedRange>
            <textLang mainLang="en"/>
            <listRelation>
              <relation active="#bib5654-2" ref="dcterms:source" passive="#bib5654-3">
                <desc xml:lang="en">
                  <label>London, British Library <idno type="shelfmark">Add. 14528</idno>
                  </label>
                </desc>
              </relation>
            </listRelation>
          </bibl>
        </listBibl>
        <listBibl type="secondaryLiterature">
          <head>Secondary Literature</head>
          <desc xml:lang="en">This is not a comprehensive list of secondary literature related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <bibl xml:id="bib5654-4" type="lawd:Citation">
            <title xml:lang="en">Catalogue of Syriac Manuscripts in the British Museum, Acquired since the Year 1838</title>
            <author>William Wright</author>
            <ptr target="http://syriaca.org/cbss/9HGARXCQ"/>
            <citedRange unit="vol">2</citedRange>
            <citedRange unit="p">1030</citedRange>
          </bibl>
        </listBibl>
      </bibl>
    </body>
