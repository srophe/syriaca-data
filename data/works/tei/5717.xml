    <body>
      <bibl xml:id="work-5717" type="lawd:ConceptualWork">
        <title xml:id="name5717-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Of the Resurrection</title>
        <title xml:id="name5717-2" xml:lang="en" source="#bib5717-1">Hymn on the Resurrection</title>
        <author ref="http://syriaca.org/person/27" source="#bib5717-1" xml:lang="en">Balai, bishop of Balsh — <foreign xml:lang="syr">ܒܠܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5717</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" source="#bib5717-1 #bib5717-3">A Syriac liturgical hymn attributed to Balai on resurrection and Christian hope for the dead. As with the related liturgical intercessions, the traditional attribution is retained without treating it as certain.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5675-2">ܕܩܝܡܬܐ ܒܗ ܝܘܡܢ ܚܕܘܬܐ ܐܓܒܐ ܕܝܡܝܢܐ</quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5675-1">Today will I choose (to celebrate) The joy of the right hand;</quote>
          </note>
          </noteGrp>
          <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5675-2">ܘܦܨܝܚܐ ܘܚܕܝܐ ܘܙܡܪܐ ܬܫܒܘܚܬܐ</quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5675-1">And she is glad and joyous, And singeth praises.</quote>
          </note>
        </noteGrp>
        <listBibl type="editions">
          <head>Editions</head>
          <desc xml:lang="en">This is not a comprehensive list of editions related to this work.</desc>
          <bibl xml:id="bib5717-2" type="lawd:Edition">
            <title level="a" xml:lang="en">Some Early Syriac Hymns</title>
            <ptr target="http://syriaca.org/cbss/FG5E62RI"/>
            <textLang mainLang="syr"/>
          </bibl>
        <bibl xml:id="bib5717-5" type="lawd:Edition">
          <title level="m" xml:lang="la">S. Ephraemi Syri, Rabulae episcopi Edesseni, Balaei aliorumque opera selecta e codicibus syriacis manuscriptis in museo Britannico et bibliotheca Bodleiana asservatis primus edidit</title>
          <ptr target="http://syriaca.org/cbss/P8WPZV2Z"/>
          <citedRange unit="p">335</citedRange>
          <textLang mainLang="syr"/>
        </bibl>
      </listBibl>
        <listBibl type="manuscripts">
          <head>Manuscripts</head>
          <desc xml:lang="en">Collection-level manuscript witnesses to the Balai rogations translated by Connolly; exact item-to-witness correspondence for this individual hymn remains to be established.</desc>
          <bibl xml:id="bib5717-6" type="syriaca:Manuscript" source="#bib5717-5 #bib5717-8">
            <label>Oxford, Bodleian Library, Marsh 479</label>
            <biblScope unit="fol">f. 195</biblScope>
          </bibl>
          <bibl xml:id="bib5717-7" type="syriaca:Manuscript" source="#bib5717-5 #bib5717-8">
            <label>Oxford, Bodleian Library, Hunt. 594</label>
            <biblScope unit="fol">f. 293</biblScope>
          </bibl>
        </listBibl>
        <listBibl type="modernTranslations">
          <head>Modern Translations</head>
          <desc xml:lang="en">This is not a comprehensive list of modern translations related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <bibl xml:id="bib5717-1" type="syriaca:ModernTranslation">
            <title xml:lang="en">Some Early Syriac Hymns</title>
            <ptr target="http://syriaca.org/cbss/FG5E62RI"/>
            <citedRange unit="p">145-146</citedRange>
            <textLang mainLang="en"/>
          </bibl>
        </listBibl>
        <listBibl type="secondaryLiterature">
          <head>Secondary Literature</head>
          <desc xml:lang="en">This is not a comprehensive list of secondary literature related to this work.</desc>
          <bibl xml:id="bib5717-3" type="lawd:Citation">
            <title level="a" xml:lang="en">Approaching Penitential Poetry: Rhetoric and Exegesis in the Liturgical Hymns Attributed to Balai of Qenneshrin and the Supplications Attributed to Rabbula of Edessa</title>
            <ptr target="http://syriaca.org/cbss/HW55L5NA"/>
            <citedRange unit="p">315-328</citedRange>
          </bibl>
          <bibl xml:id="bib5717-4" type="lawd:Citation">
            <title level="m" xml:lang="de">Beiträge zur Kenntnis der religiösen Dichtung Balai’s nach den syrischen Handschriften des Britischen Museums, der Bibliothèque Nationale zu Paris und der Königlichen Bibliothek zu Berlin</title>
