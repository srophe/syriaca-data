        <title xml:id="name549-3" xml:lang="fr" source="#bib549-1">Pères (texte)</title>
        <title xml:id="name549-4" xml:lang="en" source="#bib549-1" srophe:tags="#syriaca-headword">Fathers (text)</title>
        <author xml:lang="fr" source="#bib549-1" ref="http://syriaca.org/person/668">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Palladius</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܦܠܕܝܣ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Pallade</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/549</idno>
        <idno type="BHS">329</idno>
        <idno type="BHO">864</idno>
        <idno type="CPG">5577</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib549-1">ܐܒܐ ܐܪܣܢܝܣ ܟܕ ܐܝܬܘܗܝ ܗܘ̣ܐ ܒܦܠܛܝܢ: ܨܠܝ ܠܘܬ ܐܠܗܐ ܘܐܡܪ: ܡܪܝܐ ܕܒܪܝܢܝ ܠܡܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib549-1">Quand Abbâ Arsène était au palais, il pria Dieu et dit: «Seigneur, conduis-moi pour que je vive.»</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib549-1">ܐܚܪܢܐ ܗܘ ܓܝܪ ܦܘܠܚܢܐ ܕܗܢܐ: ܘܐܚܪܢܐ ܕܗܘܿ. ܐܠܐ ܚܕ ܗܘ ܪܘܚܐ ܕܡܥܒܕ ܘܣܥܪ ܒܟܠܗܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib549-1">Le travail de l’un et de l’autre est différent, mais un seul Esprit agit et opère en tous.</quote>
          </note>
        </noteGrp>
