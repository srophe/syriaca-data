            <bibl xml:id="work-1471" ana="#syriaca-hagiographic">
        <title xml:id="name1471-1" xml:lang="syr" source="#bib1471-1" srophe:tags="#syriaca-headword">ܝܘܚܢܢ ܡܥܡܕܢܐ</title>
        <title xml:id="name1471-2" xml:lang="fr-x-bhs" source="#bib1471-1">Yōḥanān maʿməḏānā</title>
        <title xml:id="name1471-3" xml:lang="fr" source="#bib1471-1">Jean Baptiste (Naissance) (texte)</title>
        <title xml:id="name1471-4" xml:lang="en" source="#bib1471-1" srophe:tags="#syriaca-headword">John the Baptist (the birth of) (text)</title>
        <author ref="http://syriaca.org/person/173" source="#bib1471-1" xml:lang="en">Moses bar Kipho — <foreign xml:lang="syr">ܡܘܫܐ ܒܪ ܟܐܦܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1471</idno>
        <idno type="number" subtype="BHS">1350</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1471-1">ܡܫܐܠ ܕܡܢܐ ܗܝ ܦܢܩܝܬܐ ܕܐܡܪ. ܘܐܢܫ̈ܝܢ ܡܢ ܐܡܪܝܢ ܕܠܘ̈ܚܐ ܙܥܘܪ̈ܝܬܐ ܗܠܝܢ ܐܘܟܡ̈ܬܐ ܕܟܬܒܝܢ ܒܗܝܢ ܒܨܝܪ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1471-1">Question: qu’est ce que cette tablette ? Certains disent que ce sont de petites tables noires où écrivent les enfants.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1471-1">ܢܬܠ ܠܟܘܢ ܡܪܝܐ ܡܕܡ ܕܡܝܬܪ ܡܢ ܒܢ̈ܝܐ ܘܒ̈ܢܬܐ ܚܘܒܐ ܠܐ ܡܬܚܒܠܢܐ ܕܠܘܬ ܚ̈ܕܕܐ ܘܫܘܒܚܐ ܗܿܘ ܪܒܐ ܕܡܠܟܘܬܗ ܕܠܥܠܡ ܥܠܡܝܢ ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1471-1">Que le Seigneur vous donne quelque chose de plus précieux que des fils et des filles, l’amour mutuel impérissable et la grande gloire de son Royaume pour les siècles des siècles. Amen.</quote>
          </note>
        </noteGrp>
