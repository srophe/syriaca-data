        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib9724-1">ܫ̈ܘܝܝ ܫܡܐ ܡܬܐܡܪܝܢ܆ ܕܕܝܠܗܘܢ ܫܡܐ ܒܠܚܘܕ ܓܘܐ܆ ܡܠܬܐ ܕܝܢ ܕܐܘܣܝܐ ܗܿܝ ܕܐܝܟ ܫܡܐ ܐܚܪܬܐ</quote>
          </note>
          <note xml:lang="grc" type="incipit">
            <quote source="#bib9724-3">Ὁμώνυμα λέγεται ὧν ὄνομα μόνον κοινόν, ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib9724-1">ܟܒܪ ܕܝܢ ܘܙ̈ܢܝܐ ܡܕܡ ܐܚܪ̈ܢܐ ܕܗܿܝ ܕܐܝܬ ܠܗ ܢܬܚܙܘܢ. ܗܠܝܢ ܕܝܢ ܕܡܥܕܝܢ ܕܢܬܐܡܪܘܢ܆ ܒܨܝܪ ܩܠܝܠ ܟܠܗܘܢ ܐܬܡܢܝܘ</quote>
          </note>
          <note xml:lang="grc" type="explicit">
            <quote source="#bib9724-3">ἴσως δ’ ἂν καὶ ἄλλοι τινὲς φανείησαν τοῦ ἔχειν τρόποι, οἱ δὲ εἰωθότες λέγεσθαι σχεδὸν ἅπαντες κατηρίθμηνται.</quote>
          </note>
        </noteGrp>
