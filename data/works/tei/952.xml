        <title xml:id="name952-2" xml:lang="fr-x-bhs" source="#bib952-1">Yōḥanān maʿməḏānā</title>
        <title xml:id="name952-3" xml:lang="fr" source="#bib952-1">Jean Baptiste (décapitation) (texte)</title>
        <title xml:id="name952-4" xml:lang="en" source="#bib952-1" srophe:tags="#syriaca-headword">John the Baptist (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib952-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/952</idno>
        <idno type="number" subtype="BHS">755</idno>
        <idno type="number" subtype="BHO">489</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib952-1">ܡܪܝ ܐܦܩ ܠܝ ܥܘܬܪ̈ܐ ܟܣܝ̈ܐ ܡܢ ܒܝܬ ܓܙܟ: ܐܬܠ ܐܢܘܢ ܠܐܝܢܐ ܕܣܢܝܩ ܥܠ ܡܘܗܒܬܟ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib952-1">Seigneur, envoie-moi les richesses cachées de ton trésor, que je les donne à celui qui a besoin de ta grâce.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib952-1">ܕܕܪܒ ܡܢܗ ܐܚܪܢܐ ܠܐ ܐܝܬ ܒܟܠ ܝܠܝ̈ܕܐ: ܒܪܝܟ ܗܘ ܡܠܬܐ ܕܥܒܕܗ ܩܠܐ ܘܫܕܪܗ ܩܘܕܡܘܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib952-1">Car il n’y a pas de plus grand que lui parmi tous les enfants des hommes; béni soit le Verbe qui a fait la voix et l’a envoyée devant lui.</quote>
          </note>
        </noteGrp>
