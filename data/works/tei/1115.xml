            <bibl xml:id="work-1115" ana="#syriaca-hagiographic">
        <title xml:id="name1115-1" xml:lang="syr" source="#bib1115-1" srophe:tags="#syriaca-headword">ܦܘܠܘܣ</title>
        <title xml:id="name1115-2" xml:lang="fr-x-bhs" source="#bib1115-1">Pawlōs</title>
        <title xml:id="name1115-3" xml:lang="fr" source="#bib1115-1">Paul, apôtre (texte)</title>
        <title xml:id="name1115-4" xml:lang="en" source="#bib1115-1" srophe:tags="#syriaca-headword">Paul, the Apostle (text)</title>
        <idno type="URI">http://syriaca.org/work/1115</idno>
        <idno type="number" subtype="BHS">945</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1115-1">ܚ̈ܒܝܒܝ̣ ܥܡܪܝܢ ܗܘܘ ܕܝܢ ܒܗܿ ܒܪܗܘܡܐ ܠܘܩܐ ܕܡܢ ܒܝܘܕܝܐ. ܘܛܝܛܘܣ ܕܡܢ ܛܠܡܕܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1115-1">Bien-aimés, habitaient dans cette même Rome, Luc de Judée et Tite de Dalmatie.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1115-1">Et cela eut lieu le 5 du mois copte d’Abîb, le 29 du mois syrien de Hazîran, le même jour et le même mois où saint Pierre, chef des apôtres, subit le martyre, ??? ans après sa sortie du monde ??? roi notre Seigneur, notre Dieu et notre Sauveur Jésus-Christ, à qui… Amen.</quote>
          </note>
        </noteGrp>
        <listRelation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/1115" passive="http://syriaca.org/person/1983" source="#bib1115-1"/>
                </listRelation>
