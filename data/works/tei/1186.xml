        <title xml:id="name1186-1" xml:lang="syr" source="#bib1186-1" srophe:tags="#syriaca-headword">ܛܗܡܙܓܪܕ</title>
        <title xml:id="name1186-2" xml:lang="fr-x-bhs" source="#bib1186-1">Ṭahmazgerd</title>
        <title xml:id="name1186-3" xml:lang="fr" source="#bib1186-1">Tahmazgerd (texte)</title>
        <title xml:id="name1186-4" xml:lang="en" source="#bib1186-1" srophe:tags="#syriaca-headword">Tahmazgerd (text)</title>
        <author ref="http://syriaca.org/person/504" source="#bib1186-1" xml:lang="en">George Warda</author>
        <idno type="URI">http://syriaca.org/work/1186</idno>
        <idno type="number" subtype="BHS">1026</idno>
        <idno type="number" subtype="BHO">1136</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1186-1">ܫܪܒܐ ܕܣܗ̈ܕܐ ܫܡܥܬ ܗܘܝܬ ܘܕܚܠܬ ܘܙܥܬ. ܘܐܬܪܗܒܬ ܗܘܝܬ ܕܫܡܥܬ ܫܡ̈ܥܐ ܡܕܠܚܢ̈ܐ ܘܛܒ̈ܐ ܕܚܝ̈ܠܐ. ܘܡܡܪܡܪ̈ܢܐ ܕܕܠܚܝܢ ܠܢܦܫܐ ܘܠܦܓܪܐ ܘܡܡܚܠܝܢ ܠܓܪ̈ܡܐ ܘܠܒܣܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1186-1">J’ai entendu l’histoire des martyrs, j’ai craint et tremblé, je me suis effrayé, car j’ai entendu des récits troublants et des nouvelles effrayantes et douloureuses qui troublent l’âme et le corps et affaiblissent les os et la chair.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1186-1">ܘܥܠ ܟܬܘܒܐ. ܘܥܠ ܐܡܘܪܐ ܘܥܠ ܟܢܫܐ ܕܓܒܪ̈ܐ ܘܢܫ̈ܐ ܕܡܥܗܕܝܢ ܠܗܘܢ. ܒܗܝܡܢܘܬܐ ܘܫܐܠܝܢ ܡܢܗܘܢ ܨ̈ܠܘܬܐ ܕܣ̈ܗܕܐ ܟ̈ܐܢܐ. ܕܐܬܕܒܚܘ ܚܠܦܝܟ ܗܒܠܢ ܥܡܗܘܢ. ܡܢܬܐ ܒܪ̈ܚܡܝܟ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1186-1">Et sur l’auteur et sur le lecteur et sur toute l’assemblée des hommes et des femmes qui se font mémoire d’eux dans la foi et leur demandent des prières, à eux, justes martyrs qui ont été offert pour toi; donne-nous avec eux part à ta miséricorde.</quote>
          </note>
        </noteGrp>
