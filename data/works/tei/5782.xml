      <bibl xml:id="work-5782" type="lawd:ConceptualWork">
        <title xml:id="name5782-1" xml:lang="en" srophe:tags="#syriaca-headword" source="#bib5782-2">On the Holy Fast of Lent</title>
        <title xml:id="name5782-2" xml:lang="syr" source="#bib5782-1"><foreign xml:lang="syr">ܥܠ ܨܘܡܐ ܩܕܝܫܐ ܕܐܪ̈ܒܥܝܢ</foreign></title>
        <author ref="http://syriaca.org/person/51" source="#bib5782-1" xml:lang="en">Severus of Antioch — <foreign xml:lang="syr">ܣܘܝܪܝܘܣ ܕܐܢܛܝܘܟܝܐ</foreign></author>
        <author ref="http://syriaca.org/person/113" source="#bib5782-1" xml:lang="en">Jacob of Edessa — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܐܘܪܗܝ</foreign></author>
        <idno type="URI">http://syriaca.org/work/5782</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5782-1"><foreign xml:lang="syr">ܐܝܠܝܢ ܕܛܥܡܬܘܢ ܠܨܘܡܐ ܒܝܕ ܓܠܝܙܘܬܐ ܕܡܢ ܣܝܟܪ̈ܬܐ܆ ܒܝܕ ܗܕܐ ܛܥܡܬܘܢ ܘܚܙܝܬܘܢ ܠܗ̇ܝ ܕܟܬܝܒܐ ܕܛܒ ܗܘ ܡܪܝܐ.</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5782-1">Ye that have tasted the fast by privation of food have thereby tasted and seen that which is written that the Lord is good.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5782-1"><foreign xml:lang="syr">ܕܠܗ ܟܠܢ ܢܣܩ ܫܘܒܚܐ ܒܟܠ ܥܕܢ ܘܠܪ̈ܚܡܘܗܝ ܣܓܝ̈ܐܐ ܀</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5782-2">to whom let us all offer praise at all times and to his great mercy.</quote>
          </note>
        </noteGrp>
