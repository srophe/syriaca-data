            <author ref="http://syriaca.org/person/13" source="#bib5630-6" xml:lang="en" ana="disputed"> Ephrem — <foreign xml:lang="syr">ܐܦܪܝܡ</foreign></author>
            <idno type="URI">http://syriaca.org/work/5630</idno>
            <textLang mainLang="syr"/>
            <noteGrp type="abstract">
               <desc xml:lang="en">Abstract</desc>
               <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" source="#bib5630-6">
                  A collection of fifteen hymns on the feast of the Epiphany. Modern scholarship questions the authenticity of many of these hymns, since they presuppose a liturgical distinction between the Nativity and Epiphany not otherwise attested in <persName ref="http://syriaca.org/person/13">Ephrem's</persName> works.
               </note>
            </noteGrp>
            
