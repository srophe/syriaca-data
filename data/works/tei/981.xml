            <bibl xml:id="work-981" ana="#syriaca-hagiographic">
        <title xml:id="name981-1" xml:lang="syr" source="#bib981-1" srophe:tags="#syriaca-headword">ܝܥܩܘܒ ܕܒܛܢܢ ܕܣܪܘܓ</title>
        <title xml:id="name981-2" xml:lang="fr-x-bhs" source="#bib981-1">Yaʿqōḇ d-Ḇatnān da-Srūǥ</title>
        <title xml:id="name981-3" xml:lang="fr" source="#bib981-1">Jacques de Serugh (texte)</title>
        <title xml:id="name981-4" xml:lang="en" source="#bib981-1" srophe:tags="#syriaca-headword">Jacob of Serugh (text)</title>
        <idno type="URI">http://syriaca.org/work/981</idno>
        <idno type="order" subtype="BHS">791</idno>
        <idno type="order" subtype="BHO">414</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib981-1">ܩܕܝܫܐ ܡܪܝ ܝܥܩܘܒ ܡܠܦܢܐ ܐܒܘܒܐ ܕܪܘܚܐ ܕܩܘܕܫܐ ܘܟܢܪܐ ܕܥܕܬܐ ܡܗܝܡܢܬܐ ܐܝܬܘܗܝ ܡܢ ܟܘܪܬܡ ܩܪܝܬܐ ܕܥܠ ܦܪܬ ܢܗܪܐ ܒܪ ܢܕܪ̈ܐ ܕܐܒ̈ܗܐ ܡܗ̈ܝܡܢܐ ܘܥܩܪ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib981-1">Le docteur saint Mâr Jacques, flûte de l’Esprit Saint et harpe de la fidèle Église, était du village de Kourtam sur le fleuve Euphrate, fils de parents croyants et stériles qui l’avaient obtenu par un voeu.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib981-1">ܟܠܗܝܢ ܫ̈ܢܝܐ ܕܚܝܐ ܫܒܥܝܢ. ܫܬܝܢ ܘܫܒ̈ܥ ܘܦܠܓܗ ܩܕܡ ܕܢܗܘܐ ܐܦܝܣܩܘܦܐ. ܘܬܪ̈ܬܝܢ ܫܢ̈ܝܢ ܘܦܠܓܗ ܟܕ ܐܝܬܘܗܝ ܐܦܝܣܩܘܦܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib981-1">Toutes les années de sa vie furent soixante-dix: soixante-sept et demi avant qu’il ne fût évêque et deux ans et demi étant évêque.</quote>
          </note>
        </noteGrp>
