            <bibl xml:id="work-1556" ana="#syriaca-hagiographic">
        <title xml:id="name1556-3" xml:lang="fr" source="#bib1556-1">Pères (texte)</title>
        <title xml:id="name1556-4" xml:lang="en" source="#bib1556-1" srophe:tags="#syriaca-headword">Fathers (text)</title>
        <author source="#bib1556-1" ref="http://syriaca.org/person/548" role="attributed">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Isaiah</forename>
                        <addName type="untagged-title" sort="2">of Scetis</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܐܒܐ</forename>
                        <addName type="untagged-title" sort="2">ܐܫܥܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Isaïe</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1556</idno>
        <idno type="number" subtype="BHS">1471</idno>
        <idno type="number" subtype="CPG">5563</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1556-1">ܐܢܐ ܐܚ̈ܝ ܟܕ ܠܟܠ ܙܩܦܬ ܐܢܐ ܠܝ ܠܣܘܥܪ̈ܢܐ ܕܠܒܪ. ܘܒܕܡܘܬ ܫܘܪܐ ܥܒܕܬ ܒܝܢܬ ܠܝ ܠܣܘܥܪ̈ܢܐ ܦܓܪ̈ܢܝܐ̣. ܐܡܿܪ ܗܘܝܬ ܠܢܦܫܝ: ܕܚܘܪܝ ܐܢܬܝ ܒܟܝ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1556-1">Moi mes frères, quand je me fus crucifié aux affaires du dehors et que j’eu fais comme un mur entre moi et les affaires corporelles, je disais à mon âme: «Regarde en toi.»</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1556-1">ܒܗܠܝܢ ܐܚܿܕ ܐܢܐ ܐܢܐ ܬܪܥܝܬܝ ܘܕܐܿܢ ܐܢܐ ܢܦܫܝ ܕܠܐ ܫܘܿܐ ܐܢܐ ܠܐ ܠܫܡܝܐ ܘܠܐ ܠܐܪܥܐ. ܟܕ ܡܫܠܡ ܐܢܐ ܗܿܝ ܕܟܬܝܒܐ: ܕܗ̈ܘܝ ܠܝ ܕܡ̈ܥܝ ܠܚܡܐ ܒܐܝܡܡܐ ܘܒܠܠܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1556-1">C’est dans ces choses que je tiens mon esprit et je ne me juge digne ni du ciel ni de la terre, alors que j’accomplis ceci de l’Écriture: «Mes larmes sont devenues pour moi du pain jour et nuit.»</quote>
          </note>
        </noteGrp>
