        <title xml:lang="syr" type="final-rubric" xml:id="name88-7" source="#bib88-22">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܛܛܘܣ ܕܗ̣ܘ ܩܕܡܝܐ ܗܘ̣ܐ ܐܦܣܩܦܐ ܕܥܕܬܐ ܕܩܪܛܐ. ܕܐܬܟܬܒܬ݂ ܡܢ ܢܝܩܦܘܠܝܣ. ܒܝܕ ܐܪܛܡܐ ܬܠܡܝܕܗ. ܕܐܝܬ ܒܗ̇ ܦܬ̈ܓܡܐ ܡܐܐ ܘܐܪܒܥܝ̣ܢ ܘܬܫܥܐ .ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name88-8" source="#bib88-24 #bib88-44">The Epistle of Titus, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name88-9" source="#bib88-28">ܫܠܡܬ. ܐܓܪܬܐ. ܕܠܘܬ܀ ܛܛܘܣ. ܕܐܬܟܬܒܬ܀ ܡܢ. ܢܝܩܦܘܠܣ. ܘܗܘܝܐ. ܡܐܐ. ܘܬܫܬܥܣܪ. ܦܬ̈ܓܡܝܢ.</title>
        <title xml:lang="en" xml:id="name88-11" source="#bib88-38">Titus, according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name88-12" source="#bib88-50">The Epistle of Titus</title>
        <title xml:lang="syr" xml:id="name88-13" source="#bib88-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܛܛܘܣ</title>
        <title xml:lang="syr-Syrj" xml:id="name88-14" source="#bib88-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܛܺܛܳܘܣ</title>
        <title xml:lang="en" xml:id="name88-15">The Epistle to Titus</title>
        <idno type="URI">http://syriaca.org/work/88</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Epistle_to_Titus</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q131493</idno>
