        <title xml:id="name84-1" xml:lang="en" srophe:tags="#syriaca-headword">1 Thessalonians (Peshitta version)</title>
        <title xml:id="name84-2" xml:lang="syr" srophe:tags="#syriaca-headword" source="#bib84-1">ܐܓܪܬܐ ܕܦܘܠܘܣ ܕܠܘܬ ܬܣܠ̈ܘܢܝܩܝܐ ܩܕܡܝܬܐ</title>
        <title xml:id="name84-3" xml:lang="syr" source="#bib84-1">ܐܓܪܬܐ ܕܠܘܬ ܬܣܠܘܢܝ̈ܩܝܐ ܩܕܡܝܬܐ</title>
        <title xml:id="name84-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib84-5">1 Thess</title>
        <title xml:id="name84-5" xml:lang="en" source="#bib84-5 #bib84-20 #bib84-24 #bib84-26 #bib84-28 #bib84-30 #bib84-32 #bib84-34 #bib84-36 #bib84-40 #bib84-42 #bib84-46">1 Thessalonians</title>
        <title xml:id="name84-6" xml:lang="syr-Syrj" source="#bib84-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܬܶܣܰܠܳܘܢܺܝ̈ܩܳܝܶܐ ܩܰܕܡܳܝܬܳܐ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name84-7" source="#bib84-20">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܬܣ̈ܠܘܢܝܩܝܐ ܩܕܡܝܬܐ ܕܐܬܟܬܒܬ ܡܢ ܐܬܐܢܘܣ. ܘܐܫ̣ܬܕܪܬ ܒܝܕ ܛܝܡܬܘܘܣ. ܕܐܝܬ ܒܗ̇ ܦܬܓܡܐ ܡܐܬܝܢ ܘܬܠܬܝܢ. ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name84-8" source="#bib84-22 #bib84-38">The Epistle of 1 Thessalonians, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name84-9" source="#bib84-26">ܫܠܡܬ: ܐܓܪܬܐ܀ ܕܠܘܬ. ܬܣܠܘ̈ܢܝܩܝܐ܀ ܩܕܡܝܬܐ. ܕܐܬܟܬܒܬ܀ ܡܢ. ܐܬܢܣ: ܘܗܘܝܐ܀ ܐܪܒܥܡܐܐ: ܘܫܬܬܥܣܪ܀ ܦܬܓ̈ܡܝܢ:</title>
        <title xml:lang="en" xml:id="name84-10" source="#bib84-44">The Epistle of 1 Thessalonians</title>
        <title xml:lang="syr" xml:id="name84-11" source="#bib84-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܬ݂ܣܠܘܢܝ̈ܩܝܐ ܩܕ݂ܡܝܬ݁ܐ</title>
        <title xml:lang="syr-Syrj" xml:id="name84-12" source="#bib84-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܬ݂ܶܣܰܠܳܘܢܺܝ̈ܩܳܝܶܐ ܩܰܕ݂ܡܳܝܬ݁ܳܐ</title>
        <title xml:lang="en" xml:id="name84-13">The First Epistle to the Thessalonians</title>
        <idno type="URI">http://syriaca.org/work/84</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/First_Epistle_to_the_Thessalonians</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q131115</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/84">1 Thessalonians (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib84-3">ܦܿܘܠܘܣ ܘܣܠܘܢܘܣ ܘܛܝܡܬܼܐܣ܃ ܠܥܕ̱ܿܬܿܐ ܕܿܬܼܣܠܘܢܝܩܝܐ̈ ܕܿܒܼܐܠܗܐ ܐܒܼܐ܂ ܘܒܼܡܪܢ ܝܫܘܼܥ ܡܫܝܚܐ܂ ܛܝܒܿܘܼܬܼܐ ܥܡܟܼܘܼܢ ܘܫܠܡܐ܀</quote>
          </note>
        </noteGrp>
