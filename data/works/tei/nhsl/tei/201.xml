            <bibl xml:id="work-201" type="lawd:ConceptualWork">
        <title xml:lang="en" srophe:tags="#syriaca-headword" xml:id="name201-1">The Synoptic Gospels (Peshitta version)</title>
        <title xml:lang="en" source="#bib201-1" xml:id="name201-2">The first three Gospels, according to the Peshitta version</title>
        <idno type="URI">http://syriaca.org/work/201</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note xml:lang="en" type="abstract" resp="http://syriaca.org">The Synoptic Gospels (Peshitta version), comprising 
                    <title ref="http://syriaca.org/work/72">Matthew (Peshitta version)</title>, 
                    <title ref="http://syriaca.org/work/73">Mark (Peshitta version)</title>
                    and <title ref="http://syriaca.org/work/74">Luke (Peshitta version)</title>, are sometimes 
                    grouped together in the Peshitta version.</note>
        </noteGrp>
        <listRelation>
                    <relation ref="skos:broader" active="http://syriaca.org/work/201" passive="http://syriaca.org/work/9685"/>
                </listRelation>
        <listBibl type="manuscripts">
          <head>Manuscripts</head>
          <desc xml:lang="en">This is not a comprehensive list of manuscripts related to this work. Further citations maybe available through Syriac.Nexus.</desc>
          <bibl type="syriaca:Manuscript" xml:id="bib201-3" source="#bib201-1 #bib201-2">
                    <title type="shelfmark">London, British Library, Add MS 14454</title>
                    <biblScope unit="folio" from="1b" to="131">Foll. 1b-131</biblScope>
                    <ptr target="http://syriaca.org/manuscript/127"/>
                    <date notBefore="0500" notAfter="0700">6th or 7th century</date>
                    <note xml:lang="en" resp="http://syriaca.org">defective</note>
                    
                </bibl>
        </listBibl>
