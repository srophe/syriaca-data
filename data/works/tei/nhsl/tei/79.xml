        <title xml:id="name79-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib79-5">2 Cor</title>
        <title xml:id="name79-5" xml:lang="en" source="#bib79-5 #bib79-27 #bib79-31 #bib79-33 #bib79-35 #bib79-37 #bib79-39 #bib79-41 #bib79-43 #bib79-47 #bib79-49 #bib79-55 #bib79-57 #bib79-61">2 Corinthians</title>
        <title xml:id="name79-6" xml:lang="syr-Syrj" source="#bib79-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܩܘܽܪ̈ܺܝܢܬܳܝܶܐ ܕܬܰܪܬܶܝܢ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name79-8" source="#bib79-27">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܩܘܪ̈ܢܬܝܐ ܕܬܪܬܝܢ ܕܐܬܟܬܒܬ ܐܦ ܗ̣ܝ ܡܢ ܦܝܠܝܦܘܣ ܡܕܝܢܬܐ. ܘܐܫܬܕܪܬ݂ ܒܝܕ ܛܛܘܣ ܘܠܘܩܐ. ܕܐܝܬ ܒܗ̇ ܦܬܓܡ̈ܐ̇ ܫܒܥܡܐܐ̣ ܘܫܒܥܝܢ. ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name79-9" source="#bib79-29 #bib79-51">The Epistle of 2 Corinthians, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name79-10" source="#bib79-33">ܫܠ̣ܡܬ݀ ܐܓܪܬܐ ܕܠܘܬ ܩܘܪ̈ܢܬܝܐ ܕܬܪ̈ܬܝܢ ܕܐܬܟ̣ܬܒܬ݀ ܡܢ ܦܝܠ̣ܝܦܘܣ ܕܡܩܕ̈ܘܢܝܐ.</title>
        <title xml:lang="en" xml:id="name79-11" source="#bib79-45 #bib79-53">2 Corinthians, according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name79-12" source="#bib79-59">The Epistle of 2 Corinthians</title>
        <title xml:lang="syr" xml:id="name79-13" source="#bib79-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܩܘܪ̈ܢܬ݂ܝܐ ܕ݂ܬ݂ܪ̈ܬ݁ܝܢ</title>
        <title xml:lang="syr-Syrj" xml:id="name79-14" source="#bib79-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܩܘܪ̈ܢܬ݂ܳܝܶܐ ܕ݂ܬ݂ܰܪ̈ܬ݁ܶܝܢ</title>
        <title xml:lang="en" xml:id="name79-15">The Second Epistle to the Corinthians</title>
        <idno type="URI">http://syriaca.org/work/79</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Second_Epistle_to_the_Corinthians</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q123808</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/79">2 Corinthians (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib79-3">ܦܿܘܠܘܣ ܫܠܝܚܐ ܕܿܝܫܘܼܥ ܡܫܝܚܐ ܒܿܨܒܼܝܢܗ ܕܿܐܠܗܐ܂ ܘܛܝܡܬܼܐܘܣ ܐܚܐ܃ ܠܥܕ̱ܿܬܿܐ ܕܿܐܠܗܐ ܕܿܐܝܬܼ ܒܿܩܘܪܢܬܼܘܣ܃ ܘܠܟܼܠܗܘܼܢ ܩܕܿܝܫܐ̈ ܕܿܐܝܬܼ ܒܿܐܟܼܐܝܐ ܟܿܠܗ܂</quote>
          </note>
        </noteGrp>
