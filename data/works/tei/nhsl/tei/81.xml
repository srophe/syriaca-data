        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title ref="http://syriaca.org/work/81">Ephesians (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib81-3">ܦܿܘܠܘܣ ܫܠܝܚܐ ܕܿܝܫܘܼܥ ܡܫܝܚܐ܂ ܒܿܨܒܼܝܢܗ ܕܿܐܠܗܐ܃ ܠܐܝܠܝܢ ܕܿܐܝܬܼܝܗܘܼܢ ܒܿܐܦܼܣܘܣ܂ ܩܕܿܝܫܐ̈ ܘܡܗܝܡܢܐ̈ ܒܿܝܫܘܼܥ ܡܫܝܚܐ܂</quote>
          </note>
        </noteGrp>
