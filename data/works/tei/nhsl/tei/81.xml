        <title xml:lang="syr" type="final-rubric" xml:id="name81-7" source="#bib81-21">ܫܠܡܬ ܐܓܪܬܐ ܕܠܘܬ ܐܦܣܝܐ ܕܐܬܟܬܒܬ ܡܢ ܪܗܘܡܐ ܒܝܕ ܛܘܟܝܩܘܣ. ܕܐܝܬ ܒܗ̇ ܦܬ̈ܓܡܐ ܬܠܬܡܐܐ ܘܫܒܥܝ̣ܢ ܘܚܕ .ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name81-8" source="#bib81-23 #bib81-41">The Epistle of Ephesians, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name81-9" source="#bib81-27">ܫܠܡܬ ܐܓܪܬܐ. ܕܠܘܬ ܐܦ̈ܣܝܐ. ܕܐܬܟܬܒܬ ܡܢ. ܪܗܘܡܐ. ܘܗܘܝܐ ܬܠܬܡܐܐ ܘܬܫܬܥܣܪ: ܦܬ̈ܓܡܝܢ܀</title>
        <title xml:lang="en" xml:id="name81-10" source="#bib81-35">Ephesians, according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name81-11" source="#bib81-47">The Epistle of Ephesians</title>
        <title xml:lang="syr" xml:id="name81-12" source="#bib81-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܐܦ݂ܣܝ̈ܐ</title>
        <title xml:lang="syr-Syrj" xml:id="name81-13" source="#bib81-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܐܶܦ݂ܶܣܳܝ̈ܶܐ</title>
        <title xml:lang="en" xml:id="name81-14">The Epistle to the Ephesians</title>
        <idno type="URI">http://syriaca.org/work/81</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Epistle_to_the_Ephesians</idno>
