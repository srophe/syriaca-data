        </author>
        <editor ref="http://syriaca.org/person/3272" role="http://syriaca.org/documentation/author-editor-roles.xml#anonymous http://syriaca.org/documentation/author-editor-roles.xml#translator" xml:lang="en"/>
        <idno type="URI">http://syriaca.org/work/9726</idno>
        <idno type="Bekker">1a1–15b32</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib9726-1">ܐܷܘܴܡܾ̈ܘܢܾܘܡܘܱ ܆ ܗܢܘ ܕܝܼܢ ܫܘ̈ܝܝ ܫܡܐ ܡܬܐܡܪܝܢ ܗܿܢܘܢ ܕܫܡܐ ܕܓܘܐ ܗܘ܂ ܡܠܬܐ ܕܝܢ ܕܐܘܣܝܐܼ ܐܚܪܬܐ ܗܝ</quote>
          </note>
          <note xml:lang="grc" type="incipit">
            <quote source="#bib9726-3">Ὁμώνυμα λέγεται ὧν ὄνομα μόνον κοινόν, ὁ δὲ κατὰ τοὔνομα λόγος τῆς οὐσίας ἕτερος</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib9726-1">ܟܒܪ ܕܝܢ ܐܦ ܙܢ̈ܝܐ ܐܚܪ̈ܢܐ ܡܬܡܢܝܢ ܕܗܿܘ ܕܐܝܬ܂ ܙܢ̈ܝܐ ܕܝܢ ܕܡܥܕܝܢ ܕܢܬܐܡܪܘܢ܂ ܐܝܟ ܕܠܡܐܡܪ ܟܠܗܘܢ ܡܢ ܟܕܘ ܐܬܡܢܝܘ</quote>
          </note>
          <note xml:lang="grc" type="explicit">
            <quote source="#bib9726-3">ἴσως δ’ ἂν καὶ ἄλλοι τινὲς φανείησαν τοῦ ἔχειν τρόποι, οἱ δὲ εἰωθότες λέγεσθαι σχεδὸν ἅπαντες κατηρίθμηνται.</quote>
          </note>
        </noteGrp>
