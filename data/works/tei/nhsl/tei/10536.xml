            <bibl xml:id="work-10536" type="lawd:ConceptualWork">
        <title xml:id="name10536-1" xml:lang="en" srophe:tags="#syriaca-headword">New Testament (Philoxenian version)</title>
        <title xml:id="name10536-2" xml:lang="syr" srophe:tags="#syriaca-headword">ܟܬܒܐ ܕܕܝܬܩܐ ܚ̇ܕܬܐ</title>
        <idno type="URI">http://syriaca.org/work/10536</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/New_Testament</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q18813</idno>
        <idno type="URI">https://viaf.org/viaf/185488588</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" source="#bib10536-1">The <title ref="http://syriaca.org/work/10536">New Testament (Philoxenian version)</title> is a revision of the
                        <title ref="http://syriaca.org/work/70">New Testament (Peshitta version)</title> commissioned by <persName ref="http://syriaca.org/person/44">Philoxenos
                                of Mabbug</persName> and made by <persName ref="http://syriaca.org/person/35">Polycarp, chorepiscopus of Mabbug</persName> in 507 or 508. It survives only in quotations
                    from <persName ref="http://syriaca.org/person/44">Philoxenos
                        of Mabbug</persName>'s own writings and possibly in a version of the Minor
                    Catholic Epistles and <title ref="http://syriaca.org/work/98">Revelation</title>.</note>
        </noteGrp>
