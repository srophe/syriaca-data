        <title xml:id="name82-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib82-5">Phil</title>
        <title xml:id="name82-5" xml:lang="en" source="#bib82-5 #bib82-20 #bib82-24 #bib82-26 #bib82-28 #bib82-30 #bib82-32 #bib82-34 #bib82-36 #bib82-40 #bib82-42 #bib82-46">Philippians</title>
        <title xml:id="name82-6" xml:lang="syr-Syrj" source="#bib82-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܦܺܝܠܺܝܦܺܝܣܳܝܶ̈ܐ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name82-7" source="#bib82-20">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܦܝܠܝ̈ܦܝܣܝܐ ܕܐܬܟܬܒܬ ܡܢ ܪܗܘܡܐ. ܘܐܫܬ̣ܕܪܬ ܒܝܕ ܐܦܦܪܘܕܝܛܘܣ. ܕܐܝܬ ܒܗ̇ ܦܬܓܡ̈ܐ ܡܐܬܝܢ ܘܬܡܢܐܝܢ ܘܚܕ .ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name82-8" source="#bib82-22 #bib82-38">The Epistle of Philippians, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name82-9" source="#bib82-26">ܫܠܡܬ. ܐܓܪܬܐ܀ ܕܠܘܬ ܦܝܠܝܦܝ̈ܣܝܐ܀ ܕܐܬܟܬܒܬ܀ ܡܢ܀ ܪܗܘܡܐ. ܘܗܘܝܐ܀ ܡܐܬܝܢ܀ ܘܬܠܬܝܢ܀ ܘܬܡܢܝܐ. ܦܬܓ̈ܡܝܢ܀</title>
        <title xml:lang="en" xml:id="name82-10" source="#bib82-44">The Epistle of Philippians</title>
        <title xml:lang="syr" xml:id="name82-11" source="#bib82-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܦ݂ܝܠܝܦ݁ܝܣܝ̈ܿܐ</title>
        <title xml:lang="syr-Syrj" xml:id="name82-12" source="#bib82-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܦ݂ܺܝܠܺܝܦ݁ܺܝܣܳܝ̈ܿܐ</title>
        <title xml:lang="en" xml:id="name82-13">The Epistle to the Philippians</title>
        <idno type="URI">http://syriaca.org/work/82</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Epistle_to_the_Philippians</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q51613</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/82">Philippians (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib82-3">ܦܿܘܠܘܣ ܘܛܝܡܬܼܐܘܣ܂ ܥܒܼܕܿܐ̈ ܕܿܝܫܘܼܥ ܡܫܝܚܐ܃ ܠܟܼܠܗܘܼܢ ܩܕܿܝܫܐ̈ ܕܿܒܼܝܫܘܼܥ ܡܫܝܚܐ ܕܿܐܝܬܼ ܒܿܦܼܝܠܝܦܿܘܣ܃ ܥܡ ܩܫܝܫܐ̈ ܘܡܫܡܫܢܐ̈܂</quote>
          </note>
        </noteGrp>
