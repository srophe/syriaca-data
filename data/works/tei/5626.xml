      <bibl xml:id="work-5626" type="lawd:ConceptualWork">
        <title xml:id="name5626-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Discourse 81</title>
        <title xml:id="name5626-3" xml:lang="en" source="#bib5626-2">An answer to a brother who had asked him why when our Lord has defined mercy as similitude to the greatness of the Father in Heaven 
          the solitaries honour solitude more than it? And an apology of this point and that it is not becoming to neglect the distressed and sick when they are near</title>
        <title xml:id="name5626-2" xml:lang="syr" source="#bib5626-1"><foreign xml:lang="syr">ܦܝܣܐ ܕܫܘܐܠܐ ܕܠܘܬ ܐܚܐ ܕܬܒܥܗ܆ ܕܠܡܢܐ ܟܕ ܡܪܢ ܠܕܘܡܝܐ ܕܠܘܬ ܗܝ ܪܒܘܬܐ ܕܐܒܐ ܕܒܫܡܝܐ ܠܡܪܚܡܢܘܬܐ ܬܚܡ܆
            ܝܚܝ̈ܕܝܐ ܕܝܢ ܠܫܠܝܐ ܡܝܩܪܝܢ ܝܬܝܪ ܡܢܗ̇؟ ܘܡܦܩ ܒܪܘܚܐ ܕܥܠ ܗܕܐ܆ ܘܕܠܐ ܙܕܩ ܠܡܗܡܝܘ ܒܐܠܝ̈ܨܐ ܘܒܡܪ̈ܥܐ ܐܡܬܝ ܕܩܪܝܒܝܢ</foreign></title>
        <author ref="http://syriaca.org/person/550" source="#bib5626-1" xml:lang="en">Isaac of Nineveh — <foreign xml:lang="syr">ܐܝܣܚܩ
            ܕܢܝܢܘܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5626</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5626-1"><foreign xml:lang="syr">ܫܦܝܪ ܡܢ ܐܘܢܓܠܝܘܢ ܕܘܡܝܐ ܐܝܬܝܬ ܘܦܘܚܡܐ ܡܒܚܢܢܐ ܠܕܘܒܪܐ ܪܒܐ ܕܫܠܝܐ܆ ܐܝܟ ܗܘ ܕܚܢܢ ܠܘܩܒܠ ܗܕܐ ܩܝܡܝܢܢ܆ ܐܘ ܗܡܣܝܢܢ ܠܡܫܪܝܗ̇ ܐܝܟ ܕܠܡܕܡ ܝܬܝܪܐ.</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5626-2">It is well that thou has brought forward from the Gospel a comparison and a tested example for the great duty of solitude, as if we were opponents
            to it or tried to reject it as something superfluous.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5626-1"><foreign xml:lang="syr">ܕܠܗ ܬܫܒܘܚܬܐ ܘܐܝܩܪܐ ܡܢ ܟܠܗ̇ ܒܪܝܬܐ ܠܥܠܡ ܥܠܡܝܢ. ܐܡܝܢ.</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5626-2">To whom be glory and honour from the whole creation for ever and ever. Amen.</quote>
          </note>
        </noteGrp>
