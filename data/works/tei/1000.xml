            <bibl xml:id="work-1000" ana="#syriaca-hagiographic">
        <title xml:id="name1000-1" xml:lang="syr" source="#bib1000-1" srophe:tags="#syriaca-headword">ܡܪܝܡ ܝܠܕܬ ܐܠܗܐ</title>
        <title xml:id="name1000-2" xml:lang="fr-x-bhs" source="#bib1000-1">Maryam yāldaṯ Alāhā</title>
        <title xml:id="name1000-3" xml:lang="fr" source="#bib1000-1">Marie Mère de Dieu (texte)</title>
        <title xml:id="name1000-4" xml:lang="en" source="#bib1000-1" srophe:tags="#syriaca-headword">Mary Mother of God (text)</title>
        <author ref="http://syriaca.org/person/13" source="#bib1000-1" xml:lang="en">Ephrem — <foreign xml:lang="syr">ܐܦܪܝܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1000</idno>
        <idno type="number" subtype="BHS">811</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1000-1">Réveille-toi, ma harpe, pour l’éloge de la Vierge Marie; élève ta voix et chante la génération tout à fait admirable de cette vierge, fille de David qui a enfanté la vie pour le monde.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1000-1">ܒܪܝܟܬܝ ܡܪܝܡ ܒܪܬ ܕܘܝܕ. ܘܒܪܝܟ ܗܘ ܦܐܪܐ ܕܝܗܒܬܝ ܠܢ. ܒܪܝܟ ܐܒܐ ܕܫܠܚܗ. ܠܒܪܗ ܠܦܘܪܩܢܢ. ܘܒܪܝܟ ܪܘܚܐ ܦܪܩܠܝܬܐ. ܕܚܟܡ ܠܢ ܒܪܐܙܗ ܒܪܝܟ ܫܡܗ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1000-1">Bénie es-tu Marie, fille de David et béni est le fruit que tu nous a donné; béni est le Père qui a envoyé son Fils pour notre salut et béni est l’Esprit Paraclet qui nous a instruits de son mystère. Béni est son nom.</quote>
          </note>
        </noteGrp>
