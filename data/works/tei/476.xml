            <bibl xml:id="work-476" ana="#syriaca-hagiographic">
        <title xml:id="name476-3" xml:lang="fr" source="#bib476-1">Disciple d’un vieillard de Scété (texte)</title>
        <title xml:id="name476-4" xml:lang="en" source="#bib476-1" srophe:tags="#syriaca-headword">Disciple of an Elder of Scetis (text)</title>
        <author xml:lang="fr" source="#bib476-1" ref="http://syriaca.org/person/668">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Palladius</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܦܠܕܝܣ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Pallade</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/476</idno>
        <idno type="number" subtype="BHS">256</idno>
        <idno type="number" subtype="BHO">854</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib476-1">ܣܒܐ ܚܕ ܥܡܿܪ ܗܘ̣ܐ ܒܡܕܒܪܐ ܗܘܿ ܕܡܬܩܪܐ ܐܣܩܝܛܝܣ: ܘܠܗ ܠܗܢܐ ܣܒܐ ܐܝܬ ܗܘ̣ܐ ܠܗ ܬܠܡܝܕܐ ܚܕ ܕܥܡܿܪ ܗܘ̣ܐ ܥܡܗ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib476-1">Un vieillard demeurait dans le désert qui s’appelle Scété; et ce vieillard avait un disciple qui demeurait avec lui.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib476-1">ܘܦܪܩ ܠܗܘܢ ܡܢ ܐܝܕܐ ܕܒܥܠܕܒܒܝ̈ܗܘܢ: ܘܡܫܘܙܒ ܠܗܘܢ ܡܢ ܦܚܘ̈ܗܝ ܕܐܟܠܩܪܨܐ. ܕܐܦ ܠܢ ܢܣܬܪ ܠܢ ܡܪܢ ܬܚܝܬ ܟܢ̈ܦܐ ܕܡܪܚܡܢܘܬܗ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib476-1">Et il les délivra de la main de leurs ennemis et les sauva des filets du Calomniateur. Nous aussi, que notre Seigneur nous cache sous les ailes de sa miséricorde… Amen.</quote>
          </note>
        </noteGrp>
