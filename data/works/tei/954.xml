        <title xml:id="name954-1" xml:lang="syr" source="#bib954-1" srophe:tags="#syriaca-headword">ܣܛܦܢܘܣ</title>
        <title xml:id="name954-2" xml:lang="fr-x-bhs" source="#bib954-1">Sṭapānōs</title>
        <title xml:id="name954-3" xml:lang="fr" source="#bib954-1">Étienne (texte)</title>
        <title xml:id="name954-4" xml:lang="en" source="#bib954-1" srophe:tags="#syriaca-headword">Stephen (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib954-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/954</idno>
        <idno type="number" subtype="BHS">757</idno>
        <idno type="number" subtype="BHO">1094</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib954-1">Le premier-né des martyrs m’a appelé à la fête spirituelle; donne-moi, Seigneur, de me réjouir avec lui de mes offrandes.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib954-1">ܗܘܐ ܩܕܡܝܐ ܒܐܘܪܚܐ ܕܕܡܐ ܡܠܝܬ ܚܫ̈ܐ: ܒܪܝܟ ܗܘ ܕܝܗܒ ܠܗ ܟܠܝܠ ܙܟܘܬܐ ܠܣܗܕܐ ܓܒܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib954-1">Il fut le premier sur le chemin de sang plein de souffrances; béni soit celui qui a donné la couronne de la victoire au martyr choisi.</quote>
          </note>
        </noteGrp>
        <listRelation>
