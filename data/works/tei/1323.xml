            <bibl xml:id="work-1323" ana="#hagiographic">
        <title xml:id="name1323-1" xml:lang="syr" source="#bib1323-1" srophe:tags="#syriaca-headword">ܝܫܘܥ ܒܪ ܢܘܢ</title>
        <title xml:id="name1323-2" xml:lang="fr-x-bhs" source="#bib1323-1">Īšōʿ bar Nūn</title>
        <title xml:id="name1323-3" xml:lang="fr" source="#bib1323-1">Isho‘ Bar-Noun (texte)</title>
        <title xml:id="name1323-4" xml:lang="en" source="#bib1323-1" srophe:tags="#syriaca-headword">Isho‘ Bar-Noun (text)</title>
        <author xml:lang="fr" source="#bib1323-1" ref="http://syriaca.org/person/928">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yoḥannan</forename>
                        <addName type="family" sort="2">bar Kaldun</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܘܚܢܢ</forename>
                        <addName type="family" sort="2">ܒܪ ܟܠܕܘܢ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jean</forename>
                        <addName type="family">Bar-Kaldoun</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1323</idno>
        <idno type="BHS">1183</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1323-1">ܗܢܐ ܕܝܢ ܛܘܒܢܐ̣. ܒܥܘܡܪܐ ܕܩܕܝܫܐ ܪܒܢ ܗܘܪܡܝܙܕ ܐܬܬܠܡܕ. ܘܚܕ ܡܢ ܬܠܡܝ̈ܕܘܗܝ ܕܪܒܢ ܝܘܚܢܢ ܐܝܬܘܗܝ ܗܘܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1323-1">Ce bienheureux fut formé dans le couvent de saint Rabban Hôrmîzd; il fut l’un des disciples de Rabban Jean.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1323-1">ܘܕܒܚܘܡܣܢܗܘܢ ܠܗܠܝܢ ܕܟܝܢܐ ܙܟܝܢ ܘܠܥܠ ܡܢܗ ܡܬܥܠܝܢ. ܗܿܘ ܕܠܗܿ ܠܗܕܐ ܢܫܘܝܢ ܡܪܢ ܘܐܠܗܢ. ܕܒܗ ܢܬܡܨܐ ܕܐܝܟ ܨܒܝܢܐ ܕܪ̈ܚܡܘܗܝ ܢܬܕܒܪ ܒܥܘܡܪܐ ܗܢܐ ܕܬܘܬܒܘܬܢ ܒܛܝܒܘ ܕܚܢܢܗ ܘܒܪ̈ܚܡܘܗܝ. ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1323-1">Et leur endurance vainc les choses de la nature et ils s’élèvent au-dessus d’elle. Que notre Seigneur et notre Dieu nous en juge dignes pour que nous puissions ainsi, selon la volonté de sa miséricorde, vivre dans ce couvent où nous demeurons, par la grâce de sa clémence et sa miséricorde. Amen.</quote>
          </note>
        </noteGrp>
