            <bibl xml:id="work-1422" ana="#syriaca-hagiographic">
        <title xml:id="name1422-3" xml:lang="fr" source="#bib1422-1">Martyrs (texte)</title>
        <title xml:id="name1422-4" xml:lang="en" source="#bib1422-1" srophe:tags="#syriaca-headword">The Martyrs (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib1422-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1422</idno>
        <idno type="number" subtype="BHS">1295</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1422-1">ܣܗ̈ܕܐ ܩ̈ܛܝܠܐ ܥܒܕܘ ܡܫܬܘܬܐ ܪܒܬܐ ܕܕܡܐ̣. ܘܬܒܥܘܢܝ ܕܐܡܪ ܢܨܚ̈ܢܝܗܘܢ ܒ̈ܟܠܝܠܝܗܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1422-1">Les martyrs mis à mort ont fait un grand banquet de sang; demandez-moi de dire leurs exploits dans leurs couronnes.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1422-1">ܒܥܠܡܐ ܪܒܐ ܡܒܪܩ ܫܘܦܪܐ ܕܟ̈ܠܝܠܝܗܘܢ ܒܪܝܟ ܗܘ ܚܝܠܐ ܕܚܝܠ ܐܢܘܢ ܒܐܓܘ̈ܢܝܗܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1422-1">Dans le grand monde brille la beauté de leurs couronnes; béni soit la force qui les a fortifiés dans leurs combats.</quote>
          </note>
        </noteGrp>
        
