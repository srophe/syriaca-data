        <title xml:id="name637-3" xml:lang="fr" source="#bib637-1">Vierge riche (texte)</title>
        <title xml:id="name637-4" xml:lang="en" source="#bib637-1" srophe:tags="#syriaca-headword">Rich virgin (text)</title>
        <author xml:lang="fr" source="#bib637-1" ref="http://syriaca.org/person/474">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">ʿEnanishoʿ</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܥܢܢܝܫܘܥ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Enanicho</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/637</idno>
        <idno type="number" subtype="BHS">421</idno>
        <idno type="number" subtype="BHO">849</idno>
        <idno type="number" subtype="CPG">6036</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib637-1">ܠܐ ܕܝܢ ܡܒܨܪ ܐܢܐ ܒܬܫܥܝܬܐ ܗܕܐ ܠܗܿܢܘܢ ܕܒܗܝܡܢܘܬܐ ܕܡܫܝܚܐ ܐܬܕܒܪܘ ܗܘܘ̣ ܐܝܟ ܕܠܬܫܒܘܚܬܐ ܕܓܡܝܪ̈ܐ ܘܙܗܝܘܬܐ ܕܗܿܢܘܢ ܕܫܡܥܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib637-1">Je n’omets pas cette histoire pour ceux qui ont vécu dans la foi du Christ pour la gloire des parfaits et la splendeur de ceux qui entendent.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib637-1">ܡܛܠ ܕܠܗܿܝ ܛܠܝܬܐ ܕܢܛܪܐ ܗܘܬ ܥܘܬܪܗܿ ܠܡܫܡܫܘܬܗܿ ܡܝܬܬ ܗܘܬ ܠܗܿ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib637-1">Parce que cette jeune fille pour les noces de laquelle elle gardait sa fortune était morte.</quote>
          </note>
        </noteGrp>
