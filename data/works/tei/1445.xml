        <title xml:id="name1445-1" xml:lang="syr" source="#bib1445-1" srophe:tags="#syriaca-headword">ܡܪܝܡ ܝܠܕܬ ܐܠܗܐ</title>
        <title xml:id="name1445-2" xml:lang="fr-x-bhs" source="#bib1445-1">Maryam yāldaṯ Alāhā</title>
        <title xml:id="name1445-3" xml:lang="fr" source="#bib1445-1">Marie Mère de Dieu (texte)</title>
        <title xml:id="name1445-4" xml:lang="en" source="#bib1445-1" srophe:tags="#syriaca-headword">Mary Mother of God (text)</title>
        <author xml:lang="fr" source="#bib1445-1" ref="http://syriaca.org/person/1708">
                    <persName xml:lang="en-x-gedsh">Apīpānes</persName> — <persName xml:lang="syr">ܐܦܝܦܢܣ</persName> (<persName xml:lang="fr">
                        <forename>Épiphane</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1445</idno>
        <idno type="order" subtype="BHS">1322</idno>
        <idno type="order" subtype="CPG">3771</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1445-1">ܟܕ ܠܙܗܪ̈ܝܪܐ ܢܨ̈ܝܚܐ ܘܨ̈ܡܚܐ ܕܚ̈ܝܠܐ ܕܝܠܕܬ ܐܠܗܐ: ܘܚܝ̈ܠܐ ܠܐ ܡܬܕܪ̈ܟܢܐ ܗܿܢܘܢ ܕܐܝܬܝܗܘܢ ܪܐܙܐ ܕܫܡܝܐ ܘܕܐܪܥܐ ܫܩܠܬ ܕܐܦܫܩ ܐܢܐ ܕܘܝܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1445-1">Lorsque j’ai accepté, moi misérable, d’expliquer les splendeurs illustres et les éclats redoutables de la Mère de Dieu, et les forces inconnaissables qui sont les mystères du ciel et de la terre…</quote>
          </note>
        </noteGrp>
