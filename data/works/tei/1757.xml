        <title xml:id="name1757-1" xml:lang="syr" source="#bib1757-1" srophe:tags="#syriaca-headword">ܡܓܘ̈ܫܐ</title>
        <title xml:id="name1757-2" xml:lang="fr-x-bhs" source="#bib1757-1">Məǥūšē</title>
        <title xml:id="name1757-3" xml:lang="fr" source="#bib1757-1">Mages (Caverne des Trésors) (texte)</title>
        <title xml:id="name1757-4" xml:lang="en" source="#bib1757-1" srophe:tags="#syriaca-headword">Magi (Cave of Treasures) (text)</title>
        <idno type="URI">http://syriaca.org/work/1757</idno>
        <idno type="order" subtype="BHS">1692</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1757-1">ܗܫܐ ܚܙܝ ܪܚܿܡ ܝܘܠܦܢܐ ܐܚܘܢ ܢܡܘܣܝܐ. ܕܒܫܢܬ ܐܪܒܥܝܢ ܘܬܪ̈ܬܝܢ ܕܡܠܟܘܬܗ ܕܐܓܘܣܛܘܣ ܐܬܝܠܕ ܡܫܝܚܐ ܒܒܝܬ ܠܚܡ ܕܝܗܘܕܐ. ܐܝܟ ܕܟܬܝܒ ܒܐܘܢܓܠܝܘܢ ܩܕܝܫܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1757-1">Maintenant vois, ami de la science, Namosayâ notre frère, qu’en l’an 42 du règne d’Auguste le Messie est né à Bethléem de Juda, comme il est écrit dans le saint Évangile.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1757-1">ܘܣܓܕܘ ܠܗ ܐܝܟ ܕܠܡܪܐ ܘܡܠܟܐ. ܕܟܠ ܡܕܡ ܛܝܒܘ ܠܗܘܢ ܙܘ̈ܕܐ ܘܢܚܬܘ ܠܗܘܢ ܠܐܘܪܚܗܘܢ ܡܕܒܪ̈ܝܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1757-1">Et ils se prosternèrent devant lui comme devant un seigneur et un roi. Lorsqu’ils eurent préparé tous les vivres, ils descendirent par leur route dans le désert.</quote>
          </note>
        </noteGrp>
