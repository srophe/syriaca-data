        <title xml:id="name869-1" xml:lang="syr" source="#bib869-1" srophe:tags="#syriaca-headword">ܠܐܘܢܛܝܘܣ</title>
        <title xml:id="name869-2" xml:lang="fr-x-bhs" source="#bib869-1">Lēʾōnṭīyōs</title>
