            <bibl xml:id="work-754" ana="#syriaca-hagiographic">
        <title xml:id="name754-3" xml:lang="fr" source="#bib754-1">Martyrs (texte)</title>
        <title xml:id="name754-4" xml:lang="en" source="#bib754-1" srophe:tags="#syriaca-headword">Martyrs (text)</title>
        <author source="#bib754-1" ref="http://syriaca.org/person/51">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Severus</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/10">Antioch</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܣܘܝܪܝܘܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܢܛܝܘܟܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Sévère</forename>
                        <addName type="untagged-title">d’Antioche</addName>
                    </persName>)</author>
        <author source="#bib754-1" ref="http://syriaca.org/person/113">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yaʿqub</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/78">Edessa</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܥܩܘܒ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܘܪܗܝ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jacques</forename>
                        <addName type="untagged-title">d’Édesse</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/754</idno>
        <idno type="number" subtype="BHS">540</idno>
        <idno type="number" subtype="CPG">7072</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib754-1">ܢܡܘܣܐ ܝܗܒܬ ܠܬܠܡ̈ܝܕܐ ܕܝܠܟ ܟܕ ܐܡܿܪ ܐܢܬ ܡܫܝܚܐ ܐܠܗܐ̣. ܕܚܘܒܐ ܕܡܝܬܪ ܡܢ ܗܢܐ̣. ܘܠܐ ܐܢܫ ܐܝܬ ܠܗ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib754-1">Tu as donné une loi à tes disciples, Christ Dieu, en disant: “Personne n’a d’amour meilleur que celui-ci…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib754-1">ܘܗܟܢܐ ܐܬܢܨܚܘ ܒܫܘܒܚܐ. ܗܿܢܘܢ ܕܒܨ̈ܠܘܬܗܘܢ ܒܒܥܘ ܡܢܟ ܐܬܪܚܡ ܥܠܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib754-1">Et ils triomphèrent ainsi dans la gloire. Par leurs prières, nous t’en prions, prends pitié de nous.</quote>
          </note>
        </noteGrp>
