        <title xml:id="name1154-1" xml:lang="syr" source="#bib1154-1" srophe:tags="#syriaca-headword">ܩܘܣܛܢܛܝܢܘܣ</title>
        <title xml:id="name1154-2" xml:lang="fr-x-bhs" source="#bib1154-1">Qōsṭantīnōs</title>
        <title xml:id="name1154-3" xml:lang="fr" source="#bib1154-1">Constantin, empereur et les Pères de Nicée (texte)</title>
        <title xml:id="name1154-4" xml:lang="en" source="#bib1154-1" srophe:tags="#syriaca-headword">Constantine the Emperor and the Fathers of Nicea (text)</title>
        <author xml:lang="fr" source="#bib1154-1" ref="http://syriaca.org/person/42">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yaʿqub</forename>
                        <addName type="untagged-title" sort="2">of Serugh</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܥܩܘܒ</forename>
                        <addName type="untagged-title" sort="2">ܕܣܪܘܓ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jacques</forename>
                        <addName type="untagged-title">de Serugh</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1154</idno>
        <idno type="number" subtype="BHS">993</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1154-1">ܒܗܝܡܢܘܬܗ ܕܒܪ ܐܠܗܐ ܢܗܪ̈ܝ ܒܪ̈ܝܬܐ: ܘܒܗܿ ܐܬܦܬܚ ܥܠܡܐ ܣܡܝܐ ܘܚܙܐ ܢܘܗܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1154-1">Dans la foi du fils de Dieu, la création a été illuminée et en lui le monde aveugle a recouvré la vue et a vu la lumière.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1154-1">ܘܐܙܠ ܘܐܬܐ ܕܢܘܪܬ ܓܐܙܐ ܠܐܕܡ: ܘܗܘܝܘ ܕܐܙܠܘ ܘܗܘܝܘ ܕܐܬܐ ܠܗ ܬܫܒܘܚܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1154-1">Il est allé et venu pour donner en héritage un trésor à Adam, louange à celui qui est allé et à celui qui est venu.</quote>
          </note>
        </noteGrp>
