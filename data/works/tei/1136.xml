            <bibl xml:id="work-1136" ana="#syriaca-hagiographic">
        <title xml:id="name1136-3" xml:lang="fr" source="#bib1136-1">Croix (texte)</title>
        <title xml:id="name1136-4" xml:lang="en" source="#bib1136-1" srophe:tags="#syriaca-headword">The First Finding of the Cross (text)</title>
        <author ref="http://syriaca.org/person/173" source="#bib1136-1" xml:lang="en">Moses bar Kipho — <foreign xml:lang="syr">ܡܘܫܐ ܒܪ ܟܐܦܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1136</idno>
        <idno type="number" subtype="BHS">972</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1136-1">ܡܛܠ ܕܝܢ ܕܥܐܕܐ ܕܚܘܕܬܐ ܥܒܕܝܢ ܗܘܘ ܩܕ̈ܡܝܐ: ܡܛܠ ܗܝܟܠܐ ܗܿܘ ܕܒܐܘܪܝܫܠܡ. ܗܿܘ ܕܚܟܝܡܐ ܡܢ ܫܠܝܡܘܢ ܒܢܝܗܝ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1136-1">Puisque les anciens faisaient une fête de la dédicace pour le temple de Jérusalem bâti par le sage Salomon…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1136-1">ܟܠܗܘܢ ܐܝܠܝܢ ܕܡܗܝܡܢܝܢ ܒܨܠܝܒܐ. ܥܗܕܝܢ ܠܝܘܡܐ ܫܒܝܚܐ ܕܕܘܟܪܢܗ̣. ܬܗܘܐ ܠܗܘܢ ܡܠܬܐ ܘܫܘܬܦܘܬܐ ܒܡܠܟܘܬܐ ܕܫܡܝܐ. ܥܡ ܝܠܕܬ ܐܠܗܐ ܘܥܡ ܟܠܗܘܢ ܟ̈ܐܢܐ ܘܙܕܝܩ̈ܐ ܕܫܦܪܘ ܠܗ. ܕܠܗ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1136-1">Tout ceux qui croient en la croix se souviennent du jour glorieux de sa mémoire; qu’il y ait pour eux parole et participation au royaume des cieux, avec la Mère de Dieu et avec tous les justes et les saints qui lui ont plu; à lui… Amen.</quote>
          </note>
        </noteGrp>
