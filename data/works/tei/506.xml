            <bibl xml:id="work-506" ana="#syriaca-hagiographic">
        <title xml:id="name506-1" xml:lang="syr" source="#bib506-1" srophe:tags="#syriaca-headword">ܐܚܐ ܚܕ ܫܫܒܗ ܦܘܡܢ</title>
        <title xml:id="name506-3" xml:lang="fr" source="#bib506-1">Frère voisin de Poimèn (texte)</title>
        <title xml:id="name506-4" xml:lang="en" source="#bib506-1" srophe:tags="#syriaca-headword">Brotherly Neighbor of Poimen (text)</title>
        <author ref="http://syriaca.org/person/668" source="#bib506-1" xml:lang="en">Palladius of Aspuna — <foreign xml:lang="syr">ܦܠܕܝܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/506</idno>
        <idno type="number" subtype="BHS">286</idno>
        <idno type="number" subtype="BHO">854</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib506-1">ܟܕ ܐܬܐ ܗܘ̣ܐ ܐܒܐ ܦܘܡܢ ܠܐܬܪ̈ܘܬܐ ܕܡܨܪܝܢ ܠܡܥܡܪ ܬܡܢ: ܓܕܫ ܘܥܡܪ ܥܠ ܓܒܗ ܐܚܐ ܚܕ ܕܐܝܬ ܗܘ̣ܐ ܠܗ ܢܩܦܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib506-1">Quand abba Poimên fut venu dans les régions d’Égypte pour y demeurer, il arriva qu’il demeura près d’un frère qui avait une concubine.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib506-1">Et il fut révélé au vieillard à propos de ce frère que Dieu avait accepté sa conversion.</quote>
          </note>
        </noteGrp>
