        <title xml:id="name87-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">2 Timothy (Peshitta version)</title>
        <title xml:id="name87-2" xml:lang="syr" srophe:tags="#syriaca-headword" source="#bib87-1">ܐܓܪܬܐ ܕܦܘܠܘܣ ܕܠܘܬ ܛܝܡܬܐܘܣ ܕܬܪܬܝܢ</title>
        <title xml:id="name87-3" xml:lang="syr" source="#bib87-1">ܐܓܪܬܐ ܕܠܘܬ ܛܝܡܬܐܘܣ ܕܬܪ̈ܬܝܢ</title>
        <title xml:id="name87-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib87-5">2 Tim</title>
        <title xml:id="name87-5" xml:lang="en" source="#bib87-5 #bib87-21 #bib87-25 #bib87-27 #bib87-29 #bib87-31 #bib87-33 #bib87-37 #bib87-39 #bib87-43 #bib87-45 #bib87-49">2 Timothy</title>
        <title xml:id="name87-6" xml:lang="syr-Syrj" source="#bib87-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܛܺܝܡܳܬܶܐܳܘܣ ܕܬܰܪܬܶܝܢ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name87-7" source="#bib87-21">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܛܝܡܬܐܘܣ ܕܬܪܬܝܢ ܕܗܘ̣ܐ ܐܦܣܩܘܦܐ ܩܕܡܝܐ ܒܥܕܬܐ ܕܐܦܣܘܣ. ܕܐܬܟ̣ܬܒܬ݂ ܡܢ ܪܗܘܡܐ. ܟܕ ܙܒ̣ܢܬܐ ܕܬܪܬܝܢ ܩܡ ܦܘܠܘܣ ܩܕܡ ܢܐܪܘܢ ܩܣܪ. ܘܐܫ̣ܬܕܪܬ݂ ܒܝܕ ܠܘܩܐ ܬܠܡܝܕܗ. ܕܐܝܬ ܒܗ̇ ܦܬܓܡ̈ܐ ܡܐܬܝܢ ܘܬܠܬܝ̣ܢ ܘܫܬܐ .ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name87-8" source="#bib87-23 #bib87-41">The Epistle of 2 Timothy, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name87-9" source="#bib87-27">ܫܠܡܬ. ܐܓܪܬܐ. ܕܠܘܬ. ܛܝܡܬܐܘܣ. ܕܬܪܬܝܢ. ܕܐܬܟܬܒܬ. ܡܢ. ܪܗܘܡܐ. ܘܗܘܝܐ. ܡܐܐ܀ ܘܬܪܥܣܪ. ܦ̈ܬܓܡܝܢ. ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name87-10" source="#bib87-35">2 Timothy, according to the Peshitta version</title>
        <title xml:lang="en" xml:id="name87-11" source="#bib87-47">The Epistle of 2 Timothy</title>
        <title xml:lang="syr" xml:id="name87-12" source="#bib87-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܛܝܡܬ݂ܐܘܣ ܕ݁ܬ݂ܪ̈ܬ݁ܝܢ</title>
        <title xml:lang="syr-Syrj" xml:id="name87-13" source="#bib87-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܛܺܝܡܳܬ݂ܶܐܘܳܣ ܕ݁ܬ݂ܰܪ̈ܬ݁ܶܝܢ</title>
        <title xml:lang="en" xml:id="name87-14" resp="http://syriaca.org">The Second Epistle to Timothy</title>
        <idno type="URI">http://syriaca.org/work/87</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Second_Epistle_to_Timothy</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q131489</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/87">2 Timothy (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib87-3">ܦܿܘܠܘܣ ܫܠܝܚܐ ܕܿܝܫܘܼܥ ܡܫܝܚܐ܂ ܒܿܨܒܼܝܢܗ ܕܿܐܠܗܐ܂ ܘܒܼܡܘܼܠܟܿܢܐ ܕܿܚܝܐ̈ ܕܿܒܼܝܫܘܼܥ ܡܫܝܚܐ܃</quote>
          </note>
        </noteGrp>
