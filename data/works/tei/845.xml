            <bibl xml:id="work-845" ana="#syriaca-hagiographic">
        <title xml:id="name845-1" xml:lang="syr" source="#bib845-1" srophe:tags="#syriaca-headword">ܩܣܪܝܐ</title>
        <title xml:id="name845-2" xml:lang="fr-x-bhs" source="#bib845-1">Qēsarīyā</title>
        <title xml:id="name845-3" xml:lang="fr" source="#bib845-1">Césarie (texte)</title>
        <title xml:id="name845-4" xml:lang="en" source="#bib845-1" srophe:tags="#syriaca-headword">Caesarea (text)</title>
        <author ref="http://syriaca.org/person/74" source="#bib845-1" xml:lang="en">John of Ephesus — <foreign xml:lang="syr">ܝܘܚܢܢ ܕܐܦܣܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/845</idno>
        <idno type="number" subtype="BHS">637</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib845-1">ܠܐ ܗܘܬ ܗܟܝܠ ܒܨܝܪܐ ܡܢ ܕܠܡܬܗܪ ܒܗܿ ܪܘܪܒܐܝܬܿ. ܐܦ ܬܫܥܝܬܐ ܕܐܢܬܬܐ ܗܕܐ ܕܩܕܡ ܐܠܗܐ ܘܩܕܡ ܒܢ̈ܝ ܐܢܫܐ ܪܒܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib845-1">L’histoire de cette femme, grande devant Dieu et devant les hommes, ne pouvait faire moins que susciter une grande admiration.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib845-1">ܗܠܝܢ ܩܠܝܠ ܥܘ̈ܗܕܢܐ ܕܡܢ ܥܡܠܗܿ ܘܕܘܒܪ̈ܝܗܿ ܕܛܘܒܢܝܬܐ̣. ܐܝܟ ܕܠܬܫܒܘܚܬܐ ܕܐܠܗܐ ܘܝܘܬܪܢܐ ܕܐܝܠܝܢ ܕܚܦܝܛܝܢ ܥܠ ܝܘܬܪܢܐ ܪܘܚܢܝܐ ܪܫܡܢܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib845-1">Nous avons écrit brièvement ces souvenirs du labeur et de la vie de la bienheureuse pour la gloire de Dieu et l’avantage de ceux qui sont appliqués pour le profit spirituel.</quote>
          </note>
        </noteGrp>
