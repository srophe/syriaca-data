        <title xml:id="name801-1" xml:lang="syr" source="#bib801-1" srophe:tags="#syriaca-headword">ܡܪܐ ܕܒܝܬ ܐܘܪ̈ܛܝܐ</title>
        <title xml:id="name801-2" xml:lang="fr-x-bhs" source="#bib801-1">Mārā d-ḇēṯ ʾUrṭāyē</title>
        <title xml:id="name801-3" xml:lang="fr" source="#bib801-1">Mara du Beth Ourtayê (texte)</title>
        <title xml:id="name801-4" xml:lang="en" source="#bib801-1" srophe:tags="#syriaca-headword">Mara of Beth Ourtaye (text)</title>
        <author ref="http://syriaca.org/person/74" source="#bib801-1" xml:lang="en">John of Ephesus — <foreign xml:lang="syr">ܝܘܚܢܢ ܕܐܦܣܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/801</idno>
        <idno type="number" subtype="BHS">591</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib801-1">ܛܘܒܢܐ ܗܢܐ ܡܪܐ ܐܝܬܘܗܝ ܗܘܐ ܩܠܝܪܝܩܐ̣. ܒܥܕܬܐ ܕܩܪܝܬܐ ܚܕܐ ܪܒܬܐ ܕܒܐܬܪܐ ܕܗܢܙܝܛ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib801-1">Ce bienheureux Marâ était un clerc de l’église d’un grand village du pays d’Anzitène.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib801-1">ܗܿܝ ܕܝܢ ܡܢ ܦܓܪܐ ܒܣܗܕܘܬܐ ܛܒܬܐ ܫܢܝ̣. ܟܕ ܠܐ ܐܫܬܟܚ ܡܕܡ ܠܓܡܪ ܕܢܪܦܝܘܗܝ. ܐܘ ܕܢܒܨܪ ܡܢܗ ܐܝܠܝܢ ܕܡܢ ܫܘܪܝܐ ܠܒ̣ܟ. ܠܐ ܟܘܪ̈ܗܢܐ ܘܠܐ ܪ̈ܕܘܦܝܐ ܘܠܐ ܫܪܟܐ ܕܐܘ̈ܠܨܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib801-1">Alors il quitta son corps en un bon témoignage alors qu’il ne se trouva absolument rien pour l’affaiblir ou le faire manquer ce qu’il avait commencé, ni les maladies ni les persécutions ni les autres tribulations.</quote>
          </note>
        </noteGrp>
