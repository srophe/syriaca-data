            <bibl xml:id="work-1177" ana="#syriaca-hagiographic">
        <title xml:id="name1177-1" xml:lang="syr" source="#bib1177-1" srophe:tags="#syriaca-headword">ܡܪܝܡ ܝܠܕܬ ܐܠܗܐ</title>
        <title xml:id="name1177-2" xml:lang="fr-x-bhs" source="#bib1177-1">Maryam yāldaṯ Alāhā</title>
        <title xml:id="name1177-3" xml:lang="fr" source="#bib1177-1">Marie Mère de Dieu (texte)</title>
        <title xml:id="name1177-4" xml:lang="en" source="#bib1177-1" srophe:tags="#syriaca-headword">Mary Mother of God (text)</title>
        <author xml:lang="fr" source="#bib1177-1" ref="http://syriaca.org/person/504">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Gewargis</forename>
                        <addName type="family" sort="2">Warda</addName>
                    </persName> —   (<persName xml:lang="fr">
                        <forename>Georges</forename>
                        <addName type="family">Warda</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1177</idno>
        <idno type="number" subtype="BHS">1017</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1177-1">ܒܢܨܪܬ ܡܕܝܢܬܐ ܕܓܠܝܠܐ. ܫܡܥܬ ܩ̈ܠܐ ܕܥܒܪܝܢ ܠܚܝܠܐ. ܘܠܐ ܡܬܡܠܠܝܢ ܒܠܫ̈ܢܐ. ܘܠܐ ܡܬܕܪܟܝܢ ܒܟܠ ܪ̈ܥܝܢܐ. ܘܠܐ ܡܬܬܨܝܪܝܢ ܒܟܪ̈ܝܬܐ. ܘܠܐ ܡܬܦܫܩܝܢ ܒܐܪ̈ܝܟܬܐ. ܘܠܝܬ ܕܣܦܩ ܠܗܘܢ ܒܒܪܝܬܐ. ܐܠܐ ܐܢ ܗܝܡܢܘܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1177-1">Dans la ville de Galilée Nazareth, j’ai entendu des voix extraordinaires, non dites au moyen de langues, incompréhensibles à tout esprit, qui ne peuvent être figurées brièvement, ni expliquées par de longs discours, que rien dans la création ne peut comprendre, si ce n’est la foi.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1177-1">Exalté est ton sein, loué ton enfantement; il n’est personne parmi les êtres créés qui te ressemble. L’enfant de toi atteste mes paroles, lui qui est confessé par tous et en tous, le Christ Seigneur et seigneur de tout; à lui la louange de toutes les bouches et à toi béatitude de tous les peuples.</quote>
          </note>
        </noteGrp>
