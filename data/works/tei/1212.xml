            <bibl xml:id="work-1212" ana="#syriaca-hagiographic">
        <title xml:id="name1212-1" xml:lang="syr" source="#bib1212-1" srophe:tags="#syriaca-headword">ܝܫܘܥܣܒܪܢ</title>
        <title xml:id="name1212-2" xml:lang="fr-x-bhs" source="#bib1212-1">Īšōʿsabran</title>
        <title xml:id="name1212-3" xml:lang="fr" source="#bib1212-1">Isho‘sabran (texte)</title>
        <title xml:id="name1212-4" xml:lang="en" source="#bib1212-1" srophe:tags="#syriaca-headword">Ishoʿsabran (text)</title>
        <author ref="http://syriaca.org/person/587" source="#bib1212-1" xml:lang="en">Khamis bar Qardahe — <foreign xml:lang="syr">ܟܡܝܣ ܒܪ ܩܪܕܚܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1212</idno>
        <idno type="number" subtype="BHS">1052</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1212-1">ܛܘܒܝܟ ܣܗܕܐ ܢܨܝܚܐ. ܐܓܘܢܣܛܗ ܕܡܫܝܚܐ. ܕܐܬܟܫܪܬ ܒܟܪܡ ܪܘܚܐ. ܘܗܘܝܬ ܦܠܚܐ ܘܦܠܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1212-1">Heureux es-tu, vaillant martyr, combattant du Christ, qui t’es dépensé dans la vigne de l’Esprit et a été serviteur et vigneron.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1212-1">ܘܝܠܕ̈ܝܗܿ ܢܗܘܘܢ ܒܐܘܝܘܬܐ. ܘܥܠܠܢ̈ܝܗܿ ܒܡܫܝܢܘܬܐ. ܘܡܠܟ̈ܝܗܿ ܢܛܪܘܢ ܟܐܢܘܬܐ. ܘܠܡܪܟܒܢܐ ܕܥܘܢܝܬܐ ܘܐܦ ܠܐܡܘܪܐ ܒܗܿܝ ܫܥܬܐ. ܬܚܘܢ ܒܪ̈ܚܡܐ ܕܛܝܒܘܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1212-1">Et que ses enfants soient dans la concorde, que ses pasteurs soient en paix, que ses rois observent la justice; pour l’auteur de cet hymne et celui qui la récite à cette heure, vivez dans la miséricorde de la grâce.</quote>
          </note>
        </noteGrp>
