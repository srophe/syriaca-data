        <title xml:id="name953-1" xml:lang="syr" source="#bib953-1" srophe:tags="#syriaca-headword">ܝܘܚܢܢ ܡܥܡܕܢܐ</title>
        <title xml:id="name953-2" xml:lang="fr-x-bhs" source="#bib953-1">Yōḥanān maʿməḏānā</title>
        <title xml:id="name953-3" xml:lang="fr" source="#bib953-1">Jean Baptiste (texte)</title>
        <title xml:id="name953-4" xml:lang="en" source="#bib953-1" srophe:tags="#syriaca-headword">John the Baptist (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib953-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/953</idno>
        <idno type="number" subtype="BHS">756</idno>
        <idno type="number" subtype="BHO">490</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib953-1">ܝܫܘܥ ܢܘܗܪܐ ܕܠܟܠ ܣܘ̈ܦܝܢ ܕܢܚܗ ܐܦܨܚ: ܕܢܚ ܒܝ ܐܢܗܪ ܘܐܡܠܠ ܠܟ ܦܪܘܫܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib953-1">Jésus lumière, toi qui as fait briller ton apparition partout, illumine-moi, que je je brille parle de toi avec discernement.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib953-1">ܕܟܠܗܘܢ ܫܘܦܪ̈ܐ ܕܟ̈ܢܘܬܗ ܐܚܝܢܐ ܘܐܚܐ: ܘܐܝܬ ܠܗ ܐܚܪܬܐ ܕܐܥܡܕ ܡܪܗ ܒܪܝܟ ܗܘ ܕܓܒܝܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib953-1">Parent et frère de toutes les vertus ses compagnes, il en a une autre, celle d’avoir baptisé son Seigneur; béni soit celui qui l’a choisi.</quote>
          </note>
        </noteGrp>
