            <bibl xml:id="work-246" ana="#syriaca-hagiographic">
        <title xml:id="name246-1" xml:lang="syr" source="#bib246-1" srophe:tags="#syriaca-headword">ܗܕܪܝܢܘܣ ܘܐܘܒܘܠܘܣ</title>
        <title xml:id="name246-2" xml:lang="fr-x-bhs" source="#bib246-1">Hadryānōs w-ʾĒwbūlōs</title>
        <title xml:id="name246-3" xml:lang="fr" source="#bib246-1">Hadrien et Eubule (texte)</title>
        <title xml:id="name246-4" xml:lang="en" source="#bib246-1" srophe:tags="#syriaca-headword">Hadrian and Eubulus (text)</title>
        <author xml:lang="fr" source="#bib246-1" ref="http://syriaca.org/person/480">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Eusebius</forename>
                        <addName type="untagged-title" sort="2">of Caesarea</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܐܘܣܒܝܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܩܣܪܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Eusèbe</forename>
                        <addName type="untagged-title">de Césarée</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/246</idno>
        <idno type="number" subtype="BHS">25</idno>
        <idno type="number" subtype="BHO">369</idno>
        <idno type="number" subtype="CPG">3490</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib246-1">ܟܕ ܫܘܡܠܝܗ ܕܦܡܦܝܠܘܣ ܘܕܗܢܿܘܢ ܣܗ̈ܕܐ ܕܥܡܗ ܒܦܘܡܐ ܕܟܠ ܐܢܫ ܡܬܟܪܙ ܗܘ̣ܐ: ܘܗܕܪܝܢܘܣ ܘܐܘܒܘܠܘܣ ܡܢ ܕܘܟܬܐ ܕܡܬܩܪܝܐ ܕܒܛܢܝ̈ܐ ܠܘܬ ܫܪܟܐ ܕܡܘ̈ܕܝܢܐ ܐܣܬܪܗܒܘ ܠܩܣܪܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib246-1">Quand la confirmation de Pamphile et de ses compagnons martyrs fut proclamée par la bouche de tous, Hadrien et Eubule, originaires d’un lieu appelé Batanéa, se hâtèrent vers le reste des confesseurs à Césarée.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib246-1">ܘܐܚܪܝܐ ܕܟܠܗܘܢ ܗܢܿܘܢ ܕܒܩܣܪܝܐ ܐܣܗܕ ܗܘ̣ܐ: ܘܐܓܘܢܗ ܫܠܡ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib246-1">Il fut le dernier de tous à subir le martyre et à livrer son combat à Césarée.</quote>
          </note>
        </noteGrp>
