            <bibl xml:id="work-864" ana="#syriaca-hagiographic">
        <title xml:id="name864-3" xml:lang="fr" source="#bib864-1">Justes d’autrefois (tous les) (texte)</title>
        <title xml:id="name864-4" xml:lang="en" source="#bib864-1" srophe:tags="#syriaca-headword">All the Just (text)</title>
        <author xml:lang="fr" source="#bib864-1" ref="http://syriaca.org/person/51">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Severus</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/10">Antioch</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܣܘܝܪܝܘܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܢܛܝܘܟܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Sévère</forename>
                        <addName type="untagged-title">d’Antioche</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/864</idno>
        <idno type="number" subtype="BHS">657</idno>
        <idno type="number" subtype="CPG">7035</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib864-1">ܠܐ ܐܝܬ. ܡܢ ܗܠܝܢ ܕܠܘܬ ܟܪ̈ܝܣܛܝܢܐ ܡܫܬܡ̈ܠܝܢ ܘܠܐ ܡܕܡ. ܗܿܘ ܕܠܘ ܠܗܠ ܡܢ ܟܠܗ ܕܘܡܪܐ ܐܝܬܘܗܝ. ܘܡܘܕܥ ܓܠܝܐܝܬ. ܕܪܐܙܐ ܕܝܠܢ ܘܟܠܗ ܝܘܠܦܢܢ. ܣܒܪܐ ܕܠܐ ܡܝܘܬܘܬܐ ܐܝܬܘܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib864-1">Il n’y a, parmi ce qui est célébré chez les chrétiens, rien qui soit davantage au-dessus de toute admiration et qui fasse clairement savoir que notre mystère et toute notre doctrine est l’espérance de l’immortalité.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib864-1">ܐܠܐ. ܘܠܐ ܚܕܐ ܡܠܬܐ ܐܝܬ ܠܢ ܡܛܠ ܗܠܝܢ ܕܥ̈ܬܝܕܢ. ܟܕ ܗܟܝܠ ܗܠܝܢ ܟܠܗܝܢ ܢܬܪ̈ܨ: ܘܠܥܘܗܕܢܐ ܗܿܘ ܕܡܛܠ ܙܕܝ̈ܩܐ. ܒܗܘܢܢ ܢܣܒ̣. ܢܨܠܐ ܕܢܫܬܘܐ ܠܦܣܐ ܘܝܘܪܬܢܐ ܗܿܘ ܕܥܡܗܘܢ̣. ܒܛܝܒܘܬܐ ܘܒܪܚܡܬ ܐܢܫܘܬܐ ܕܐܠܗܐ ܪܒܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib864-1">Mais nous n’avons pas une parole sur ces choses à venir. Lorsque nous corrigerons tout cela, et que nous recevrons dans notre esprit la mémoire des justes, prions pour que nous soyons jugés dignes du sort et de l’héritage avec eux, par la grâce et l’amour pour les hommes du grand Dieu… Amen.</quote>
          </note>
        </noteGrp>
