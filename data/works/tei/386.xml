            <bibl xml:id="work-386" ana="#syriaca-hagiographic">
        <title xml:id="name386-1" xml:lang="syr" source="#bib386-1" srophe:tags="#syriaca-headword">ܐܠܘܬܪܝܘܣ ܘܐܢܬܝܐ ܘܩܘܪܒܘܪ</title>
        <title xml:id="name386-2" xml:lang="fr-x-bhs" source="#bib386-1">ʾĒlūṯēryōs w-ʾAntīyā w-Qōrebōr</title>
        <title xml:id="name386-3" xml:lang="fr" source="#bib386-1">Éleuthère, Anthie et Qorebor (texte)</title>
        <title xml:id="name386-4" xml:lang="en" source="#bib386-1" srophe:tags="#syriaca-headword">Eleutheria, Anthia, and Qorabor (text)</title>
        <idno type="URI">http://syriaca.org/work/386</idno>
        <idno type="number" subtype="BHS">166</idno>
        <idno type="number" subtype="BHO">266</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib386-1">ܗܕܪܝܢܘܣ ܡܠܟܐ: ܒܫܢܬ ܥܣܪܝܢ ܘܚܕܐ ܕܡܠܟܘܬܗ: ܡܢ ܕܦܢܐ ܡܢ ܡܕܢܚܐ: ܐܫܬܡܥ ܠܗ ܥܠ ܐܦܣܩܘܦܐ ܛܘܒܢܐ: ܕܐܝܬ ܗܘ̣ܐ ܥܡܗ ܛܝܒܘܬܐ ܪܒܬܐ: ܘܫܡܗ ܗܘ̣ܐ ܐܠܘܬܪܝܘܣ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib386-1">L’empereur Hadrien, en l’an 21 de son règne, de retour de l’Orient, entendit parler du bienheureux évêque plein de grâce dont le nom était Éleuthère.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib386-1">ܘܡܢ ܒܬܪܟܢ ܓܠܘ ܠܗܘܢ ܐܚ̈ܐ: ܕܨܐܕܝܗܘܢ ܐܢܘܢ ܦܓܪ̈ܝܗܘܢ ܕܩܕܝ̈ܫܐ. ܘܡܢ ܕܫܡܥܘ ܒܢܝ̈ ܪܗܘܡܐ: ܐܬܪܘܚܘ. ܗܘܐ ܕܝܢ ܫܘܠܡܗܘܢ ܒܝܘܡ ܚܡܫܥܣܪܐ: ܒܫܥܐ ܫܒܥ: ܒܪܗܘܡܐ ܡܫܡܗܬܐ: ܒܡܠܟܘܬܗ ܕܗܕܪܝܢܘܣ. ܒܗܝܡܢܘܬܐ ܕܝܢ ܕܝܠܢ ܒܡܠܟܘܬܗ ܕܝܫܘܥ ܡܫܝܚܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib386-1">Et ensuite les frères leur révélèrent que les corps des saints étaient chez eux; ayant entendu cela les Romains furent soulagés. Leur fin eut lieu le 15 à la septième heure dans la célèbre Rome sous le règne d’Hadrien, mais selon notre foi, sous le règne de Jésus-Christ… Amen.</quote>
          </note>
        </noteGrp>
        <listRelation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/386" passive="http://syriaca.org/person/2033 http://syriaca.org/person/1697 http://syriaca.org/person/1591" source="#bib386-1">
            <desc xml:lang="en">This work commemorates <persName ref="http://syriaca.org/person/2033">Qorabor</persName>; <persName ref="http://syriaca.org/person/1697">Eleutherius</persName>;  and <persName ref="http://syriaca.org/person/1591">Anthia</persName>
            </desc>
          </relation>
                </listRelation>
