            <bibl xml:id="work-2003" ana="#syriaca-hagiographic">
        <title xml:id="name2003-3" xml:lang="fr" source="#bib2003-1">Croix (texte)</title>
        <title xml:id="name2003-4" xml:lang="en" source="#bib2003-1" srophe:tags="#syriaca-headword">The Cross (text)</title>
        <author ref="http://syriaca.org/person/431" source="#bib2003-1" xml:lang="en">Cyril of Jerusalem — <foreign xml:lang="syr">ܩܘܪܝܠܠܘܣ ܕܐܘܪܫܠܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/2003</idno>
        <idno type="number" subtype="BHS">1972</idno>
        <idno type="number" subtype="CPG">3587</idno>
        <noteGrp type="prologue">
          <desc xml:lang="en">Prologue</desc>
          <note xml:lang="fr" type="prologue">
            <quote source="#bib2003-1">À l’empereur ami de Dieu Constantin Auguste, Cyrille évêque à Jérusalem, salut.</quote>
          </note>
          <note xml:lang="syr" type="prologue">
            <quote source="#bib2003-1">ܠܡܠܟܐ ܪܚܡ ܐܠܗܐ ܩܘܣܛܢܛܝܢܘܣ ܐܓܘܣܛܘܣ. ܩܘܪܝܠܠܘܣ ܐܦܝܣܩܘܦܐ ܕܒܐܘܪܫܠܡ ܫܠܡ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib2003-1">ܠܘܩܕܡ ܪܫܝܬܐ ܗܕܐ ܕܟܬܝ̈ܒܬܢ ܡܢ ܐܘܪܫܠܡ ܡܕܝܢܬܐ ܩܕܝܫܬܐ ܠܡܠܟܘܬܟ ܪܚܡܬ ܐܠܗܐ ܡܫܕܪܝܢܢ. ܗܿܝ ܕܠܟ ܫܦܝܪ ܠܡܩܒܠܘ ܘܠܢ ܠܡܩܪܒܘ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib2003-1">Tout d’abord nous envoyons à ta majesté amie de Dieu ces prémices de nos écrits depuis la ville sainte de Jérusalem, chose belle à recevoir pour toi, et belle à présenter pour nous.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib2003-1">ܠܡܬܚܐ ܕܫ̈ܢܝܐ ܣܓܝ̈ܐܬܐ ܡܪܝܐ ܡܪܐ ܕܟܠ ܠܢ ܢܬܠܟ ܡܠܟܐ ܪܚܝܡܐ ܘܪܚܡ ܐܠܗܐ ܐܓܘܣܛܐ ܩܘܣܛܢܛܝܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib2003-1">Que le Seigneur, seigneur de tout, te donne à nous, empereur aimé et ami de Dieu, Constantin Auguste, pour une durée de nombreuses années.</quote>
          </note>
        </noteGrp>
