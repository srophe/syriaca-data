            <bibl xml:id="work-1564" ana="#syriaca-hagiographic">
        <title xml:id="name1564-3" xml:lang="fr" source="#bib1564-1">Martyrs (texte)</title>
        <title xml:id="name1564-4" xml:lang="en" source="#bib1564-1" srophe:tags="#syriaca-headword">The Martyrs (text)</title>
        <author xml:lang="fr" source="#bib1564-1" ref="http://syriaca.org/person/650">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Narsai</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܢܪܣܝ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Narsaï</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1564</idno>
        <idno type="number" subtype="BHS">1481</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1564-1">ܩܠ ܙܟܘܬܐ ܕܒܪܫ ܩܝܣܐ ܫܡܥܘ ܡܝܘ̈ܬܐ ܘܩܢܘ ܣܒܪܐ ܠܡܐܚܕ ܕܪܐ ܪܘܚܢܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1564-1">Les mortels ont entendu la voix de la victoire au sommet du bois et ils ont acquis l’espérance de soutenir le combat spirituellement.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1564-1">ܕܡܚܝܠ ܚܝܠܢ ܠܡܥܙܝܘ ܩܕܡ ܚܘ̈ܬܚܬܐ: ܢܩܪܐ ܠܪ̈ܚܡܐ ܕܚܫܘ ܠܟܝܢܢ ܕܢܥܕܪܘܢܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1564-1">Que celui qui a renforcé notre force pour que nous l’emportions devant les démengeaisons invoque la miséricorde qui a souffert pour notre nature afin qu’elle nous secoure.</quote>
          </note>
        </noteGrp>
