      <bibl xml:id="work-5603" type="lawd:ConceptualWork">
        <title xml:id="name5603-1" xml:lang="en" srophe:tags="#syriaca-headword" source="#bib5603-2">On those who live in the neighbourhood of God and pass all their days in a life of knowledge</title>
        <title xml:id="name5603-2" xml:lang="syr" source="#bib5603-1"><foreign xml:lang="syr">ܥܠ ܗܢܘܢ ܕܒܩܪܝܒܘܬܐ ܕܐܠܗܐ ܚܐܝܢ ܘܒܚܝ̈ܐ ܕܝܕܥܬܐ ܟܠܗܘܢ ܝܘ̈ܡܬܗܘܢ</foreign></title>
        <author ref="http://syriaca.org/person/550" source="#bib5603-1" xml:lang="en">Isaac of Nineveh — <foreign xml:lang="syr">ܐܝܣܚܩ
            ܕܢܝܢܘܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5603</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5603-1"><foreign xml:lang="syr">ܛܘܒܘܗܝ ܠܡܢ ܕܚܝ̈ܐ ܙܗܝܪ̈ܐ ܚܝܐ ܒܥܠܡܐ ܗܢܐ!</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5603-2">Blessed is he that leads a watchful life in this world.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5603-1"><foreign xml:lang="syr">ܕܠܗ ܫܘܒܚܐ܆ ܘܠܢ ܢܢܛܪ ܒܩܪܝܒܘܬܗ ܘܒܥܢܝܢܗ. ܐܡܝܢ.</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5603-2">To whom be the glory. May He keep us near to Him and in intercourse with Him. Amen.
            </quote>
          </note>
        </noteGrp>
