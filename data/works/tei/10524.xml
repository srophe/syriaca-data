        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/10524">Galatians (Harqlean version)</title> is extant in only a few manuscripts, 
                    the earliest being from the 9th century. It circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/10520">Pauline Epistles (Harqlean version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib10524-5">ܦܘܠܘܣ ܫܠܝܚܐ܂ ܠܐ ܡܢ ܒܢܝ̈ܢܫܐ܂ ܘܠܐ ܒܝܕ ܒܪܢܫܐ. ܐܠܐ ܒܝܕ ܝܫܘܥ ܡܫܝܚܐ܇ ܘܐܠܗܐ ܐܒܐ܂ ܗ̇ܘ ܕܐܩܝܡܗ ܡܢ ܡܝ̈ܬܐ܂</quote>
          </note>
        </noteGrp>
