        <title xml:id="name474-1" xml:lang="syr" source="#bib474-1" srophe:tags="#syriaca-headword">ܐܘܠܘܓ</title>
        <title xml:id="name474-2" xml:lang="fr-x-bhs" source="#bib474-1">ʾŌlōǥ</title>
        <title xml:id="name474-3" xml:lang="fr" source="#bib474-1">Euloge et le lépreux (texte)</title>
        <title xml:id="name474-4" xml:lang="en" source="#bib474-1" srophe:tags="#syriaca-headword">Eulogius and the Leper (text)</title>
        <author xml:lang="fr" source="#bib474-1" ref="http://syriaca.org/person/668">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Palladius</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܦܠܕܝܣ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Pallade</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/474</idno>
        <idno type="number" subtype="BHS">254</idno>
        <idno type="number" subtype="BHO">854</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib474-1">ܩܫܝܫܐ ܕܢܝܛܪܐ: ܕܫܡܗ ܩܪܘܢܝܘܣ: ܐܫܬܥܝ ܠܝ: ܕܟܕ ܐܝܬܝ ܛܠܝܐ ܙܥܘܪܐ ܡܐܢܬ ܠܝ: ܘܥܪܩܬ ܡܢ ܕܝܪܐ ܘܡܢ ܪܫ ܕܝܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib474-1">Un prêtre de Nitrie, qui s’appelait Cronios, me raconta: «Quand j’étais un petit garçon, je fus dégoûté et je m’enfuis loin du monastère et de l’higoumène.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib474-1">ܐܢܐ ܕܝܢ ܓܝܪ ܝܕܥܿ ܗܘܝܬ ܠܬܪ̈ܝܗܘܢ ܠܫܢ̈ܐ: ܘܦܫܩܬ ܠܬܪ̈ܝܗܘܢ ܓܒ̈ܐ: ܠܗܘܿ ܐܓܘܒܛܐܝܬ: ܘܠܗܢܐ ܝܘܢܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib474-1">Mais moi je connaissais les deux langues et je traduisis dans les deux sens: le grec en égyptien et l’égyptien en grec.»</quote>
          </note>
        </noteGrp>
