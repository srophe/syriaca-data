        <title xml:id="name359-1" xml:lang="syr" source="#bib359-1" srophe:tags="#syriaca-headword">ܐܢܣܝܡܐ</title>
        <title xml:id="name359-2" xml:lang="fr-x-bhs" source="#bib359-1">ʾĀnēsīmā</title>
        <title xml:id="name359-3" xml:lang="fr" source="#bib359-1">Onésima (texte)</title>
        <title xml:id="name359-4" xml:lang="en" source="#bib359-1" srophe:tags="#syriaca-headword">Onesima (text)</title>
        <idno type="URI">http://syriaca.org/work/359</idno>
        <idno type="number" subtype="BHS">139</idno>
        <idno type="number" subtype="BHO">815</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib359-1">ܐܢܬܬܐ ܚܕܐ ܐܝܬ ܗܘ̣ܐ ܒܐܓܘܦܛܘܣ: ܕܫܡܗܿ ܗܘ̣ܐ ܐܢܣܝܡܐ: ܘܐܝܬ ܗܘ̣ܐ ܠܗܿ ܚܡܫܥܣܪ̈ܐ ܡܕܝ̈ܢܢ: ܘܟܠܗ ܫܘܠܛܢܗܝܢ ܕܐܒܗܝ̈ܗܿ ܗܘ̣ܐ: ܡܠܟ̈ܐ ܗܘ̣ܘ ܓܝܪ ܕܥܠܡܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib359-1">Il y avait en Égypte une femme du nom d’Onésima; elle possédait quinze villes et tout le pouvoir sur elles appartenait à ses parents car ils étaient rois du monde.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib359-1">ܘܠܐܝܟܐ ܐܙܠܬ: ܐܢܫ ܠܐ ܝܕܥ: ܐܦܠܐ ܐܝܟܐ ܫܟܒܬ ܐܬܝܕܥܬ ܠܒܢܝ̈ܢܫܐ. ܘܗܐ ܫܟܝܒܐ: ܘܢܨܚܢܗܿ ܡܬܝܒܠ ܘܡܬܥܗܕ ܥܕܡܐ ܠܡܐܬܝܬܗ ܕܒܪܗ ܕܐܠܗܐ: ܕܠܗ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib359-1">Et personne ne sut où elle était allée; et l’endroit de sa mort ne fut pas non plus connu des hommes. Et voilà qu’elle est morte; et ses hauts faits seront transmis et commémorés jusqu’à la venue du Fils de Dieu; à lui… Amen.</quote>
          </note>
        </noteGrp>
