        <title xml:id="name1067-3" xml:lang="fr" source="#bib1067-1">Docteurs grecs (trois) (texte)</title>
        <title xml:id="name1067-4" xml:lang="en" source="#bib1067-1" srophe:tags="#syriaca-headword">Three Greek Doctors (text)</title>
        <author ref="http://syriaca.org/person/650" source="#bib1067-1" xml:lang="en">Narsai — <foreign xml:lang="syr">ܢܪܣܝ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1067</idno>
        <idno type="number" subtype="BHS">893</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1067-1">ܛܢܢܐ ܟܐܢܐ ܕܚܠܦ ܟܐܢ̈ܐ ܫܚܩܢܝ ܣܓܝ: ܕܡܛܠ ܡܢܐ ܛܠܝܡ ܝܘܬܪܢܐ ܕܡܢ ܥܡ̈ܠܝܗܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1067-1">Le juste zèle qui m’a beaucoup tourmenté pour les justes, pourquoi l’utilité de leurs peines est-elle mépriséeܒ?</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1067-1">ܨܐܬܐ ܕܥܘܠܐ ܢܡܪܘܡ ܟܠ ܫܥ ܡܢ ܪ̈ܥܝܢܝܢ: ܕܠܐ ܢܬܦܪܣܐ ܒܗܿܘ ܒܝܬ ܕܝܢܐ ܕܟܐܝܢ ܒܘܚܪܢܗ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1067-1">Nettoyons toujours la souillure de l’impiété de mes pensées pour qu’elle ne soit pas manifestée lors du jugement dont l’examen est ferme.</quote>
          </note>
        </noteGrp>
