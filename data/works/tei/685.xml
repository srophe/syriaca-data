            <bibl xml:id="work-685" ana="#syriaca-hagiographic">
        <title xml:id="name685-1" xml:lang="syr" source="#bib685-1" srophe:tags="#syriaca-headword">ܣܐܘܝܪܐ</title>
        <title xml:id="name685-2" xml:lang="fr-x-bhs" source="#bib685-1">Sēwērā</title>
        <title xml:id="name685-3" xml:lang="fr" source="#bib685-1">Sévère d’Antioche (texte)</title>
        <title xml:id="name685-4" xml:lang="en" source="#bib685-1" srophe:tags="#syriaca-headword">Severus of Antioch (text)</title>
        <author xml:lang="fr" source="#bib685-1" ref="http://syriaca.org/person/52">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">John</forename>
                        <addName type="family" sort="2">bar Aphtonia</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܘܚܢܢ</forename>
                        <addName type="family" sort="2">ܒܪ ܐܦܬܘܢܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jean</forename>
                        <addName type="family">bar Aphtonya</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/685</idno>
        <idno type="number" subtype="BHS">470</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib685-1">ܠܡܝܬܪ̈ܬܐ ܘܢܨܚܢ̈ܐ ܕܚܣܝܐ ܣܐܘܝܪܐ ܗܿܘ ܪܝܫ ܟܗ̈ܢܐ̣. ܐܝܕܐ ܡܠܬܐ ܡܨܝܐ ܚܝܠܐ ܠܡܫܒܚܘ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib685-1">Quelle parole est capable de louer les vertus et les hauts faits du vénérable patriarche Sévère?</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib685-1">ܗܿܘ ܕܒܨܠܘ̈ܬܗ ܡܪܐ ܟܠ̣. ܠܗ̈ܕܡܐ ܡܒܕܪ̈ܐ ܕܥܕܬܐ ܟܢܫ̣. ܘܐܝܬܐ ܠܚܕܐ ܐܘܝܘܬܐ. ܘܫܘܙܒ ܠܢ ܒܪ̈ܚܡܝܟ. ܐܝܟ ܪܚܡ ܐܢܫܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib685-1">Par ses prères, Dieu tout-puissant, rassemble les membres dispersés de l’Église, ramène-les à la concorde et sauve nous dans ta miséricorde en tant qu’ami des hommes.</quote>
          </note>
        </noteGrp>
