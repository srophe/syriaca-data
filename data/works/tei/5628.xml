      <bibl xml:id="work-5628" type="lawd:ConceptualWork">
        <title xml:id="name5628-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Testament of Our Lord</title>
        <title xml:id="work5628-2" xml:lang="syr" source="bib5628-2">ܕܝܐܬܝܩܝ ܐܘܟܝܬ ܡ̈ܠܐ ܕܐܡܪ ܡܪܢ ܠܫܠܝ̈ܚܐ ܩܕܝ̈ܫܐ܆ ܟܕ ܩܡ ܡܢ ܡ̈ܝܬܐ܆ ܘܐܬܟܬܒ̈ܝ ܒܝܕ ܩܠܝܡܝܣ ܕܪܘܡܝ ܬܠܡܝܕܗ ܕܦܛܪܘܣ ܫܠܝܚܐ</title>
        <title xml:id="work5628-3" xml:lang="la" source="bib5628-2">Testamentum Domini Nostri Jesu Christi</title>
        <idno type="URI">http://syriaca.org/work/5628</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Testamentum_Domini</idno>
        <idno type="URI">http://viaf.org/en/viaf/180027062</idno>
        <idno type="number" subtype="CPG">1743</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc>Abstract</desc>
          <note lang="en" xml:id="abstract5628">A tripartite work consisting of an introduction in which the resurrected Christ speaks with his disciples on the night of his resurrection, the main body, which contains information pertaining to the ideal organization of the church, and a conclusion, returning to the resurrected Christ's conversation with the disciples.</note>
        </noteGrp>
