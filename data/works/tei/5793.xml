      <bibl xml:id="work-5793" type="lawd:ConceptualWork">
        <title xml:id="name5793-1" xml:lang="en" srophe:tags="#syriaca-headword" source="#bib5793-2">On the two blind men</title>
        <title xml:id="name5793-2" xml:lang="syr" source="#bib5793-1"><foreign xml:lang="syr">ܥܠ ܗܢܘܢ ܬܪ̈ܝܢ ܣܡ̈ܝܐ</foreign></title>
        <author ref="http://syriaca.org/person/51" source="#bib5793-1" xml:lang="en">Severus of Antioch — <foreign xml:lang="syr">ܣܘܝܪܝܘܣ ܕܐܢܛܝܘܟܝܐ</foreign></author>
        <author ref="http://syriaca.org/person/113" source="#bib5793-1" xml:lang="en">Jacob of Edessa — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܐܘܪܗܝ</foreign></author>
        <idno type="URI">http://syriaca.org/work/5793</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5793-1"><foreign xml:lang="syr">ܟܕ ܡܫܝܚܐ ܒܕܘܟ ܥܝܒܪ ܗܘܐ ܒܐܘܪܚܐ܆ ܢܩܦܘ ܘܐܬܝܢ ܗܘܘ ܒܬܪܗ܆ ܬܪܝܢ ܣܡ̈ܝܐ ܕܡܙܥܩܝܢ ܘܐܡܪܝܢ܆</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5793-1">When Christ was passing by a certain place on the way, two blind men followed and came after him, who cried and said.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5793-1"><foreign xml:lang="syr">ܘܚܢܢ ܒܥܝܢ ܚܢܢ ܡܪܝܐ ܢܘܗܪܐ ܕܗܝܡܢܘܐ ܬܪܝܨܬ ܫܘܒܚܐ ܫܟܢ ܠܢ܆ ܐܝܟ ܫܦܝܥܘܬܐ ܕܪ̈ܚܡܝܟ ܣܓܝ̈ܐܐ ܀</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5793-2">And we ourselves pray. Lord, bestow on us the light of the orthodox faith, according to the abundance of thy great mercy.</quote>
          </note>
        </noteGrp>
