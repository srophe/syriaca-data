        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib468-1">ܠܗ ܕܝܢ ܠܗܢܐ ܩܕܝܫܐ ܗܠܦܝܕܘܣ ܬܠܡܝܕܐ ܚܕ ܐܝܬ ܗܘ̣ܐ ܠܗ: ܕܫܡܗ ܣܝܣܝܢܘܣ: ܕܐܝܬܘܗܝ ܗܘܐ ܒܪ ܐܡܬܐ: ܒܗܝܡܢܘܬܐ ܕܝܢ ܒܪ ܚܐܪ̈ܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib468-1">Ce saint Elpidios avait un disciple qui s’appelait Sisinnius, qui était fils d’une esclave, mais homme libre dans la foi…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib468-1">ܐܝܬܘܗܝ ܕܝܢ ܐܦ ܣܓܝ ܪܚܡ ܐܟܣܢܝ̈ܐ ܘܡܣܪܩܘܬܐ: ܠܟܘܘܢܐ ܕܗܢܘܢ ܥܬܝܪ̈ܐ ܘܚܣܘ̈ܟܬܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib468-1">Il aimait (aussi) beaucoup les étrangers et la pauvreté volontaire, admonition pour les riches avares.</quote>
          </note>
        </noteGrp>
