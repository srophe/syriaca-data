        <title xml:id="name468-2" xml:lang="fr-x-bhs" source="#bib468-1">Sīsīnōs</title>
        <title xml:id="name468-3" xml:lang="fr" source="#bib468-1">Sisinnius (texte)</title>
        <title xml:id="name468-4" xml:lang="en" source="#bib468-1" srophe:tags="#syriaca-headword">Sisinnius (text)</title>
        <author ref="http://syriaca.org/person/474" source="#bib468-1" xml:lang="en">ʿEnanishoʿ — <foreign xml:lang="syr">ܥܢܢܝܫܘܥ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/468</idno>
        <idno type="number" subtype="BHS">248</idno>
        <idno type="number" subtype="BHO">849</idno>
