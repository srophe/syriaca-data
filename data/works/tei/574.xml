        <title xml:id="name574-2" xml:lang="fr-x-bhs" source="#bib574-1">ʾAḇrāhām Qīdūnāyā</title>
        <title xml:id="name574-3" xml:lang="fr" source="#bib574-1">Abraham Qidounaya (texte)</title>
        <title xml:id="name574-4" xml:lang="en" source="#bib574-1" srophe:tags="#syriaca-headword">Abraham Quidounaya (text)</title>
        <author ref="http://syriaca.org/person/13" source="#bib574-1" xml:lang="en">Ephrem — <foreign xml:lang="syr">ܐܦܪܝܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/574</idno>
        <idno type="number" subtype="BHS">355</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib574-1">ܐ̈ܚܝ ܕܚܿܠ ܐܢܐ ܕܐܡܪ ܢܨܚܢܘ̈ܗܝ ܟܕ ܬܘܒ ܩܿܢܛ ܐܢܐ ܕܐܫܠܐ ܡܢ ܫܪ̈ܒܘܗܝ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib574-1">Mes frères, je crains de dire ses triomphes alors que j’ai peur de taire son histoire.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib574-1">ܟܕ ܬܘܒ ܚܙܬܗ ܪܓܬܐ ܐܙܕܟܝܬ ܒܗܬܬ ܒܣܝܢܗܿ ܕܦܠܦܠܬ ܠܣ̈ܓܝܐܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib574-1">En outre en le voyant le désir a été vaincu; il a eu honte de sa boue dont il a souillé beaucoup de monde.</quote>
          </note>
        </noteGrp>
