        <author ref="http://syriaca.org/person/53" source="#bib254-1" xml:lang="en">Simeon of Beth Arsham — <foreign xml:lang="syr">ܫܡܥܘܢ ܕܒܝܬ ܐܪܫܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/254</idno>
