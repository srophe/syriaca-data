        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib430-1">ܐܝܬ ܗܘ̣ܐ ܕܝܢ ܬܘܒ ܐܢܫ ܐܚܪܢܐ: ܕܫܡܗ ܗܘܐ ܦܛܘܠܘܡܐܘܣ: ܗܘ ܕܝܢ ܗܢܐ ܐܝܬܘܗܝ ܗܘ̣ܐ ܒܓܢܣܗ ܡܢ ܡܨܪܝܢ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib430-1">Il y avait (encore quelqu’un) d’autre qui s’appelait Ptolémée; (il était par sa famille originaire d’Égypte).</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib430-1">ܕܐܝܠܝܢ ܕܠܐ ܐܝܬܝܗܘܢ ܬܚܝܬ ܡܕܒܪܢܘܬܐ ܕܦܩ̈ܘܕܐ ܢܦܠܘܢ ܐܝܟ ܛܪ̈ܦܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib430-1">Ceux qui ne sont pas soumis à l’administration (des magistrats) tomberont comme des feuilles.</quote>
          </note>
        </noteGrp>
