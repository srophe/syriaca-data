        <title xml:id="name430-3" xml:lang="fr" source="#bib430-1">Ptolémée l’Égyptien (texte)</title>
        <title xml:id="name430-4" xml:lang="en" source="#bib430-1" srophe:tags="#syriaca-headword">Ptolemy the Egyptian (text)</title>
        <author ref="http://syriaca.org/person/474" source="#bib430-1" xml:lang="en">ʿEnanishoʿ — <foreign xml:lang="syr">ܥܢܢܝܫܘܥ</foreign>
        </author>
