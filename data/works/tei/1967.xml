            <bibl xml:id="work-1967" ana="#syriaca-hagiographic">
        <title xml:id="name1967-3" xml:lang="fr" source="#bib1967-1">Justes d’autrefois (tous les) (texte)</title>
        <title xml:id="name1967-4" xml:lang="en" source="#bib1967-1" srophe:tags="#syriaca-headword">All the Just (text)</title>
        <author ref="http://syriaca.org/person/51" source="#bib1967-1" xml:lang="en">Severus of Antioch — <foreign xml:lang="syr">ܣܘܝܪܝܘܣ ܕܐܢܛܝܘܟܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1967</idno>
        <idno type="number" subtype="BHS">1934</idno>
        <idno type="number" subtype="CPG">7035</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1967-1">ܘܠܐ ܡܕܡ ܐܝܬ ܡܢ ܗܠܝܢ ܕܡܢ ܟܪ̈ܣܛܝܢܐ ܗ̈ܘܝܢ ܕܠܐ ܐܝܬܘܗܝ ܠܗܠ ܡܢ ܟܠܗ ܬܗܪܐ. ܘܡܘܕܥ ܢܗܝܪܐܝܬ ܕܐܪܙܐ ܕܝܠܢ ܘܝܘܠܦܢܐ ܟܠܗ ܣܒܪܐ ܐܝܬܘܗܝ ܕܠܐ ܡܝܘܬܘܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1967-1">Il n’y a, parmi ce qui est chez les chrétiens, rien qui soit au-dessus de toute admiration et qui fasse clairement savoir que notre mystère et toute notre doctrine est l’espérance de l’immortalité.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1967-1">ܐܠܐ ܘܠܐ ܚܕܐ ܡܠܬܐ ܐܝܬ ܠܢ ܡܛܘܠ ܐܝܠܝܢ ܕܥ̈ܬܝܕܢ. ܟܕ ܗܟܝܠ ܗܠܝܢ ܟܠܗܝܢ ܡܬܪܨܝܢ ܐܢܚܢܢ ܘܥܘܗܕܢܐ ܕܡܛܠ ܙܕܝ̈ܩܐ ܒܢܦܫܢ ܢܣܒܝܢ ܚܢܢ. ܢܨܠܐ ܕܥܡܗܘܢ ܢܫܬܘܐ ܠܝܪܬܘܬܗܘܢ. ܒܛܝܒܘܬܗ ܘܒܡܪܚܡܢܘܬܗ ܕܐܠܗܢ ܪܒܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1967-1">Mais nous n’avons pas une parole sur ces choses à venir. Lorsque nous corrigerons tout cela, et que nous recevrons en notre âme la mémoire des justes, prions pour que nous soyons jugés dignes de leur héritage avec eux, par la grâce et la miséricorde de notre grand Dieu… Amen.</quote>
          </note>
        </noteGrp>
