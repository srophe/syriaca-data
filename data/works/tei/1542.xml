        <title xml:id="name1542-1" xml:lang="syr" source="#bib1542-1" srophe:tags="#syriaca-headword">ܩܠܡܣ</title>
        <title xml:id="name1542-2" xml:lang="fr-x-bhs" source="#bib1542-1">Qlēmis</title>
        <title xml:id="name1542-3" xml:lang="fr" source="#bib1542-1">Clément (texte)</title>
        <title xml:id="name1542-4" xml:lang="en" source="#bib1542-1" srophe:tags="#syriaca-headword">Clement (text)</title>
        <idno type="URI">http://syriaca.org/work/1542</idno>
        <idno type="number" subtype="BHS">1450</idno>
        <idno type="number" subtype="BHO">200</idno>
        <idno type="number" subtype="CPG">1015</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1542-1">ܟܕ ܕܝܢ ܡܟܝܠ ܠܛܪܝܦܘܠܣ ܫܒܩܢܗܿ ܒܪ ܝܘܡܗ ܠܐܪܬܣܘܣ ܐܬܝܢ ܘܬܡܢ ܝܘܡܐ ܚܕ ܩܘܝܢ ܘܗܝܕܝܢ ܐܬܝܢ ܠܐܢܛܕܪܘܣ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1542-1">Après avoir abandonné Tripoli, le même jour nous arrivâmes à Orthôsos (Orthôsia); nous y restâmes un jour et puis nous arrivâmes à Antadaros (Antarados).</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1542-1">ܟܕ ܗܠܝܢ ܐܡܪ ܘܕܣܓܝ̈ܐܢ ܡܢ ܗܠܝܢ ܠܫܢܬܐ ܡܟܝܠ ܫ̈ܢܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1542-1">Quand il eut prononcé ces paroles et d’autre encore, nous nous allâmes aussitôt dormir.</quote>
          </note>
        </noteGrp>
