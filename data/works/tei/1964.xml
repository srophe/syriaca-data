            <bibl xml:id="work-1964" ana="#syriaca-hagiographic">
        <title xml:id="name1964-1" xml:lang="syr" source="#bib1964-1" srophe:tags="#syriaca-headword">ܒܣܝܠܝܘܣ ܘܓܪܝܓܘܪܝܘܣ</title>
        <title xml:id="name1964-2" xml:lang="fr-x-bhs" source="#bib1964-1">Bāsīlīyōs wa-Órīǥōrīyōs</title>
        <title xml:id="name1964-3" xml:lang="fr" source="#bib1964-1">Basile et Grégoire (texte)</title>
        <title xml:id="name1964-4" xml:lang="en" source="#bib1964-1" srophe:tags="#syriaca-headword">Basil and Gregory (text)</title>
        <author xml:lang="fr" source="#bib1964-1" ref="http://syriaca.org/person/51">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Severus</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/10">Antioch</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܣܘܝܪܝܘܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܢܛܝܘܟܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Sévère</forename>
                        <addName type="untagged-title">d’Antioche</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1964</idno>
        <idno type="number" subtype="BHS">1931</idno>
        <idno type="number" subtype="CPG">7035</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1964-1">ܠܥܐܕܐ ܗܢܐ ܦܨܝܚܐ ܘܪܘܚܢܝܐ ܐܝܟ ܕܒܫܪܪܐ ܕܠܐ ܒܨܒܝܢܝ ܡܿܢ ܕܢܬ ܕܝܢ ܒܪܡ ܕܐܥܒܪܝܘܗܝ ܒܫܬܩܐ. ܟܕ ܒܡܪ̈ܢܝܬܐ ܕܣܘܥܪ̈ܢܐ ܣܢܓܝܐܐ ܩܿܛܐ ܐܢܐ. ܘܐܦ ܠܐ ܕܐܣܘܩ ܪܘܚܐ ܡܫܬܒܩ ܐܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1964-1">Cette fête joyeuse et à vrai dire spirituelle, contre ma volonté, j’avais pensé la passer sous silence, poursuivi par les soucis d’affaires nombreuses et n’ayant même plus de souffle pour respirer.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1964-1">ܬܠܝܬܝܘܬܐ ܕܝܢ ܡܫܡܠܝܬ ܒܟܠ ܘܩܕܝܫܬܐ̣. ܡܛܘܠ ܐܝܩܪܐ ܕܩܕܝ̈ܫܐ ܗܿܢܘܢ ܕܡܫܡܠܝܐܝܬ ܡܠܠܘܗܿ ܒܡܠܬܐ ܕܐܠܗܘܬܐ ܘܠܝܠܕܐ ܕܝܠܢ ܠܐ ܡܫܡܠܝܐ ܘܚܣܝܪܐ ܐܝܟ ܡܫܡܠܝܐ ܬܩܒܠ ܘܬܬܠ ܐܓܪܐ ܠܨܒܝܢܐ. ܕܠܗܿ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1964-1">Que cette Trinité, parfaite en tout et sainte, pour l’honneur de ces saints qui ont parlé parfaitement dans le discours de la divinité, reçoive aussi notre enfant imparfait et indigent comme s’il était parfait, et donne la récompense à la volonté; à elle… Amen.</quote>
          </note>
        </noteGrp>
