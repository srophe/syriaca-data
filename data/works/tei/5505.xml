         <bibl xml:id="work-5505" type="lawd:ConceptualWork">
            <title xml:id="name5505-1" xml:lang="en" source="#bib5505-1" srophe:tags="#syriaca-headword">Book of the Dove</title>
            <author ref="http://syriaca.org/person/239" xml:lang="en" source="#bib5505-1">Gregory Bar Hebraeus<foreign xml:lang="syr">ܓܪܝܓܘܪܝܘܣܒܪ ܥܒܪܝܐ</foreign>
            </author>
            <idno type="URI">http://syriaca.org/work/5505</idno>
            <textLang mainLang="syr"/>
            <date notBefore="1200" notAfter="1300" source="#bib5505-2">13th cent. CE</date>
            <noteGrp type="abstract">
               <desc xml:lang="en">Abstract</desc>
               <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" resp="http://syriaca.org">
                  The Book of the Dove is a concise ascetic and mystical manual composed by the West Syrian maphrian Gregory Bar Hebraeus (13th cent. CE). Written as a practical distillation of his larger ethical encyclopedia, the Ethikon, it was specifically intended as a guidebook for monks and novices lacking extensive library access. According to Bedjan’s (1919) edition, the work is structurally divided into four parts: (1) on the bodily service in the monastery; (2) on the psychic service which is accomplished in the cell; (3) on the spiritual rest of the perfect; and (4) a tale of the author’s progress in teachings and some sentences communicated to him in revelations.
               </note>
            </noteGrp>
