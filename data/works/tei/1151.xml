            <bibl xml:id="work-1151" ana="#syriaca-hagiographic">
        <title xml:id="name1151-3" xml:lang="fr" source="#bib1151-1">Enfants d’Éphèse (texte)</title>
        <title xml:id="name1151-4" xml:lang="en" source="#bib1151-1" srophe:tags="#syriaca-headword">The Children of Ephesus (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib1151-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1151</idno>
        <idno type="number" subtype="BHS">988</idno>
        <idno type="number" subtype="BHO">1021</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1151-1">ܒܪ ܐܠܗܐ ܕܦܬܝܚ ܬܪܥܗ ܠܕܩܿܪܐ ܠܗ. ܦܬܚ ܠܝ ܬܪܥܟ ܐܙܡܪ ܫܘܦܪܐ ܕܒܢ̈ܝ ܢܘܗܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1151-1">Fils de Dieu, toi dont la porte est ouverte à celui qui t’appelle, ouvre moi ta porte que je chante la beauté des fils de la lumière.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1151-1">ܒܪܝܟ ܗܘ ܪܥܝܐ ܕܓܒܐ ܠܐܡܪ̈ܐ ܡܢ ܓܘ ܥܢܗ. ܘܐܘܪܬ ܐܢܘܢ ܓܢܘܢܐ ܘܓܢܬܐ ܘܡܠܟܘܬ ܪܘܡܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1151-1">Béni soit le bon pasteur qui a choisi ses brebis parmi son troupeau, et qui leur a donné en héritage la chambre nuptiale et le jardin et le royaume d’en-haut.</quote>
          </note>
        </noteGrp>
