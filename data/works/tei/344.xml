            <bibl xml:id="work-344" ana="#syriaca-hagiographic">
        <title xml:id="name344-1" xml:lang="syr" source="#bib344-1" srophe:tags="#syriaca-headword">ܒܒܘܠܐ</title>
        <title xml:id="name344-2" xml:lang="fr-x-bhs" source="#bib344-1">Bābūlā</title>
        <title xml:id="name344-3" xml:lang="fr" source="#bib344-1">Babylas d’Antioche et les trois enfants (texte)</title>
        <title xml:id="name344-4" xml:lang="en" source="#bib344-1" srophe:tags="#syriaca-headword">Babylas and the Three Children (text)</title>
        <idno type="URI">http://syriaca.org/work/344</idno>
        <idno type="number" subtype="BHS">124</idno>
        <idno type="number" subtype="BHO">128</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib344-1">ܢܘܡܪܝܢܘܣ ܡܠܟܐ ܕܒܚ ܠܫܐܕ̈ܐ: ܘܒܥܐ ܕܢܡܪܚ ܘܢܥܘܠ ܠܒܝܬܗ ܕܐܠܗܐ. ܛܘܒܢܐ ܕܝܢ ܒܒܘܠܐ ܐܦܣܩܘܦܐ ܐܝܬܘܗܝ ܗܘ̣ܐ: ܘܝܕܥܿ ܗܘ̣ܐ ܕܢܪܥܐ ܥܡܗ ܛܒܐܝܬ ܐܝܟ ܙܕܩܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib344-1">L’empereur Numérien avait sacrifié aux démons, et il voulut effrontément entrer dans la maison de Dieu. Le bienheureux Babylas était évêque et il savait bien paître son peuple comme il faut.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib344-1">ܘܗܝܕܝܢ ܐܫܬܩܠ ܐܦ ܪܫܗ ܕܝܠܗ ܕܛܘܒܢܐ: ܘܐܬܬܣܝܡ ܥܡ ܕܗܢܿܘܢ ܝܠܘ̈ܕܐ ܘܥܡ ܗܠܝܢ ܦܪ̈ܙܠܐ ܕܪܡܝܢ ܗܘ̣ܘ ܒܗ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib344-1">Et alors le bienheureux fut aussi décapité, et il fut placé avec ces enfants et avec ces chaînes qui lui avaient été mises.</quote>
          </note>
        </noteGrp>
