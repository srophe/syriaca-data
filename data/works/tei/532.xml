        <title xml:id="name532-1" xml:lang="syr" source="#bib532-1" srophe:tags="#syriaca-headword">ܐܝܣܝܕܘܪܐ</title>
        <title xml:id="name532-2" xml:lang="fr-x-bhs" source="#bib532-1">ʾĪsīḏōrā</title>
        <title xml:id="name532-3" xml:lang="fr" source="#bib532-1">Isidore (texte)</title>
        <title xml:id="name532-4" xml:lang="en" source="#bib532-1" srophe:tags="#syriaca-headword">Isidore (text)</title>
        <author ref="http://syriaca.org/person/857" source="#bib532-1" xml:lang="en">Jerome — <foreign xml:lang="syr">ܐܝܪܢܘܡܝܣ</foreign>
        </author>
        <author ref="http://syriaca.org/person/474" source="#bib532-1" xml:lang="en">ʿEnanishoʿ — <foreign xml:lang="syr">ܥܢܢܝܫܘܥ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/532</idno>
        <idno type="number" subtype="BHS">312</idno>
        <idno type="number" subtype="BHO">843</idno>
        <idno type="number" subtype="CPG">5620</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib532-1">ܚܙܝܢܢ ܬܘܒ ܒܗܿ ܒܬܒܐܝܣ ܕܝܪܗ ܕܛܘܒܢܐ ܐܝܣܝܕܘܪܐ: ܕܚܣܝܢܐ ܒܫܘܪܐ ܪܡܐ ܕܠܒ̈ܢܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib532-1">Nous vîmes encore en Thébaïde le monastère du bienheureux Isidore, solide avec un haut mur de briques.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib532-1">ܐܠܐ ܟܠ ܐܡܬܝ ܕܢܡܛܐ ܩܨܐ ܕܚܕ ܡܢܗܘܢ: ܡܩܕܡ ܗܘ̣ܐ ܘܠܟܠܗܘܢ ܐܡܿܪ ܗܘ̣ܐ: ܘܡܓܣ ܗܘ̣ܐ ܘܫܟܿܒ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib532-1">Mais chaque fois qu’arrivait la fin de l’un d’entre eux, il la prédisait à tous et il se couchait et il mourait.</quote>
          </note>
        </noteGrp>
