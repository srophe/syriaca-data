        <title xml:id="name828-1" xml:lang="syr" source="#bib828-1" srophe:tags="#syriaca-headword">ܡܪܐ ܝܚܝܕܝܐ</title>
        <title xml:id="name828-2" xml:lang="fr-x-bhs" source="#bib828-1">Mārē ʾīḥīḏāyā</title>
        <title xml:id="name828-3" xml:lang="fr" source="#bib828-1">Maré le Solitaire (texte)</title>
        <title xml:id="name828-4" xml:lang="en" source="#bib828-1" srophe:tags="#syriaca-headword">Mari the Solitary (text)</title>
        <author ref="http://syriaca.org/person/74" source="#bib828-1" xml:lang="en">John of Ephesus — <foreign xml:lang="syr">ܝܘܚܢܢ ܕܐܦܣܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/828</idno>
        <idno type="number" subtype="BHS">619</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib828-1">ܡܛܠ ܗܟܝܠ ܕܒܡ̈ܫܠܡܢܘܬܐ ܩܕ̈ܡܝܬܐ ܡܫܟܚܝܢܢ: ܕܐܟܝܦܐܝܬ ܘܚܦܝܛܐܝܬ ܗܘ̣ܬ ܒܛܝܠܘܬܐ ܠܐܢܫܐ ܩܕ̈ܡܝܐ: ܕܢܥܒܕܘܢ ܥܘܗ̈ܕܢܐ ܕܣܥܘܪ̈ܘܬܐ ܕܨ̈ܒܘܬܐ ܡܫܚ̈ܠܦܬܐ ܕܩܕܡ ܙܒ̈ܢܝܗܘܢ ܘܒܝ̈ܘܡܬܗܘܢ ܐܣܬܥܪ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib828-1">Puisque nous trouvons dans les anciennes traditions que les gens anciens étaient diligents et appliqués pour faire mémoire des actions diverses accomplies dans les temps antérieurs et de leurs jours…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib828-1">ܘܗܠܝܢ ܩܠܝܠ ܡܢ ܣܓܝ̣. ܐܝܟ ܕܠܥܘܗܕܢܐ ܘܠܡܫܬܘܝܢܘܬܐ ܕܒܘܪܟܬܗ ܘܕܨܠܘܬܗ ܪܫܡܢܢ. ܟܕ ܡܢ ܣܓܝ̈ܐܬܐ ܕܥܡܠܘ̈ܗܝ ܘܕܕܘܒܪ̈ܘܗܝ ܐܗܡܝܢܢ̣. ܡܛܠ ܡܬܚܐ ܕܬܫܥܝܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib828-1">Nous avons écrit cela, qui n’est qu’une petite partie de son histoire, pour la mémoire et pour être digne de sa bénédiction et de sa prière, en ayant omis beaucoup de ses labeurs et de ses pratiques de vie, à cause de la longueur de l’histoire.</quote>
          </note>
        </noteGrp>
