        <title xml:id="name5805-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Palm Sunday</title>
        <title xml:id="name5805-2" xml:lang="en" source="#bib5805-2">Hymn 55 on the Reception of Our Saviour Jesus Christ</title>
        <idno type="URI">http://syriaca.org/work/5805</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" source="#bib5805-1 #bib5805-2">A Syriac liturgical hymn for Palm Sunday that maps the Jerusalem procession onto the Christian moral and spiritual life. The audience is urged to meet Christ with disciplined passions, virtues, and right confession (as the doctors of the church proclaim) their spiritual palm branches while joining in with the Hosanna of the Gospel narrative. It is hymn 55 in Brooks’s Palm Sunday sequence.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5675-2">ܒܢ̈ܝ ܨܗܝܘܢ ܢܪܘܙܘܢ ܒ݀ܡܠܟܗܘܢ ܐܘ ܐܝܬܐ ܠܡܪܝܐ ܫܘܒܚܐ ܘܐܝܩܪܐ</quote> 
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5675-1">The children of Zion shall rejoice in their king - O! bring to the Lord glory and honour</quote>
          </note>
          </noteGrp>
          <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5675-2">ܐܘܫܥܢܐ ܠܒܪܗ ܕܕܐܘܝܕ ܒܪܝܟ ܕܐܬ݂ܐ ܘܥܬ݂ܝܕ ܕܢܐܬܐ</quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5675-1">Hosanna to the Son of David! Blessed is he that hath come and shall come.</quote>
          </note>
        </noteGrp>
