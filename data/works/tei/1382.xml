            <bibl xml:id="work-1382" ana="#syriaca-hagiographic">
        <title xml:id="name1382-1" xml:lang="syr" source="#bib1382-1" srophe:tags="#syriaca-headword">ܓܝܘܪܓܝܣ</title>
        <title xml:id="name1382-2" xml:lang="fr-x-bhs" source="#bib1382-1">Gīwargīs</title>
        <title xml:id="name1382-3" xml:lang="fr" source="#bib1382-1">Georges (texte)</title>
        <title xml:id="name1382-4" xml:lang="en" source="#bib1382-1" srophe:tags="#syriaca-headword">George (text)</title>
        <author ref="http://syriaca.org/person/1034" source="#bib1382-1" xml:lang="en">Ishoʿyahb bar Mqadam — <foreign xml:lang="syr">ܝܫܘܥܝܗܒ ܒܪ ܡܩܕܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1382</idno>
        <idno type="number" subtype="BHS">1248</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1382-1">ܛܘܒܝܟ ܣܗܕܐ ܩܕܝܫܐ. ܡܪܝ ܓܝܘܪܓܝܣ ܢܨܝܚܐ. ܕܩܒܠܬ ܫܢ̈ܕܐ ܘܩܘܦܚܐ. ܘܥܒܕܬ ܠܒܝܫܐ ܕܚܝܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1382-1">Heureux es-tu saint martyr Mâr Georges, toi qui as subi tourments et châtiment et qui pulvérisé le Mauvais.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1382-1">ܘܬܗܘܐ ܒܐܡܝܢܘ ܒܚܕܘܬ. ܘܢܫܬܟ̈ܢܢ ܠܗܿ ܟܠ ܒܘܪܟܬ. ܘܢܬܪ̈ܣܡܢ ܥܠܝܗܿ ܟܠ ܛܝܒ̈ܘܬ. ܘܛܒ̈ܢ ܪ̈ܡܢ ܡܢ ܡܠܬ ܠܫܢ ܒܣܪܐ ܩܢܐ ܝܕܥܬ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1382-1">Qu’elle soit éternellement dans la joie, que lui soient accordées toutes les bénédictions; que se répandent sur elle toutes les grâces et les biens sublimes de la parole de la langue de la chair qui a acquis la connaissance (???).</quote>
          </note>
        </noteGrp>
