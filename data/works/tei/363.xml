        <title xml:id="name363-1" xml:lang="syr" source="#bib363-1" srophe:tags="#syriaca-headword">ܐܘܓܢܝܐ</title>
        <title xml:id="name363-2" xml:lang="fr-x-bhs" source="#bib363-1">ʾĒwgēnyā</title>
        <title xml:id="name363-3" xml:lang="fr" source="#bib363-1">Eugénie et ses compagnons (texte)</title>
        <title xml:id="name363-4" xml:lang="en" source="#bib363-1" srophe:tags="#syriaca-headword">Eugenia and her Friends (text)</title>
        <idno type="URI">http://syriaca.org/work/363</idno>
        <idno type="number" subtype="BHS">143</idno>
        <idno type="number" subtype="BHO">282</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib363-1">ܟܕ ܡܡܠܟ ܗܘ̣ܐ ܩܘܡܘܕܝܣ ܐܚܝܕ ܫܘܠܛܢܐ ܕܥܠܡܐ ܒܡܕܝܢܬܐ ܪܒܬܐ ܘܡܫܡܗܬܐ ܪܗܘܡܐ: ܒܗܘܦܛܝܐ ܕܝܠܗ ܕܫܒܥ: ܫܘܠܛܢܐ ܕܗܘܦܪܟܘܬܐ ܝܗܒ ܗܘ̣ܐ ܠܦܝܠܝܦܘܣ ܚܕ ܡܢ ܪܘܪ̈ܒܢܘܗܝ: ܘܫܕܪܗ ܗܘ̣ܐ ܠܐܠܟܣܢܕܪܝܐ ܡܕܝܢܬܐ ܕܐܝܬ ܒܐܬܪܐ ܕܐܝܓܝܦܛܘܣ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib363-1">Alors que régnait Commode empereur du monde dans la grande et fameuse ville de Rome, pendant son septième consulat, il avait donné le pouvoir du consulat à un de ses grands, Philippe; et il l’envoya dans la ville d’Alexandrie qui est au pays d’Égypte.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib363-1">ܫܦܪܘ ܓܝܪ ܒܕܘܒܪ̈ܝܗܘܢ ܠܡܫܝܚܐ: ܘܥܠܘ ܘܐܬܚܠܛܘ ܒܓܘ̈ܕܐ ܫܒܝ̈ܚܬܐ ܕܟܐܢ̈ܐ ܘܕܙܕܝ̈ܩܐ. ܕܥܡܗܘܢ ܘܐܦ ܚܢܢ ܢܫܬܘܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib363-1">Par leur vie ils plurent au Christ et ils entrèrent et se joignirent aux choeurs glorieux des hommes justes et droits. Puissions-nous être jugés dignes avec eux… Amen.</quote>
          </note>
        </noteGrp>
