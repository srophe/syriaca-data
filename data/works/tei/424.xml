        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib424-1">ܐܝܬ ܗܘ̣ܐ ܕܝܢ ܬܘܒ ܐܢܫ ܩܘܪܝܝܐ ܦܠܚܐ: ܕܫܡܗ ܗܘ̣ܐ ܦܘܠܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib424-1">Il y avait encore un cultivateur de la campagne qui s’appelait Paul…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib424-1">ܗܢܘ ܢܨܚܢܗ ܕܦܘܠܐ: ܕܐܬܩܪܝ ܦܫܝܛܐ ܡܢ ܟܠܗܿ ܐܚܘܬܐ. ܕܒܨ̈ܠܘܬܗ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib424-1">Voilà les hauts faits de Paul, qui fut appelé Simple par toute la fraternité. (Qu’à ses prières… Amen.)</quote>
          </note>
        </noteGrp>
