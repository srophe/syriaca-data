            <bibl xml:id="work-1077" ana="#syriaca-hagiographic">
        <title xml:id="name1077-1" xml:lang="syr" source="#bib1077-1" srophe:tags="#syriaca-headword">ܡܪܝܡ ܝܠܕܬ ܐܠܗܐ</title>
        <title xml:id="name1077-2" xml:lang="fr-x-bhs" source="#bib1077-1">Maryam yāldaṯ Alāhā</title>
        <title xml:id="name1077-3" xml:lang="fr" source="#bib1077-1">Marie Mère de Dieu (Annonciation) (texte)</title>
        <title xml:id="name1077-4" xml:lang="en" source="#bib1077-1" srophe:tags="#syriaca-headword">Mary Mother of God (Annunciation) (text)</title>
        <author xml:lang="fr" source="#bib1077-1" ref="http://syriaca.org/person/42">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yaʿqub</forename>
                        <addName type="untagged-title" sort="2">of Serugh</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܥܩܘܒ</forename>
                        <addName type="untagged-title" sort="2">ܕܣܪܘܓ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jacques</forename>
                        <addName type="untagged-title">de Serugh</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1077</idno>
        <idno type="number" subtype="BHS">904</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1077-1">ܒܪ ܐܠܗܐ ܕܐܝܬܘܗܝ ܡܠܬܐ ܕܠܐ ܡܬܡܠܠ: ܗܒ ܠܝ ܡܠܬܐ ܕܙܡܪܐ ܫܘܒܚܟ ܥܬܝܪܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1077-1">Fils de Dieu qui est Parole indicible, donne-moi la parole qui chante ta louange abondamment.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1077-1">ܘܡܢ ܣܘܥܪ̈ܢܘܗܝ ܝܠܦܗ ܥܠܡܐ ܕܒܪ ܐܠܗܐ ܗܘ: ܒܪܝܟ ܗܘ ܟܣܝܐ ܕܐܬܐ ܠܓܠܝܐ ܕܢܚܐ ܠܐܕܡ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1077-1">Et par ses actions il a enseigné au monde qu’il est le Fils de Dieu; béni soit le caché qui s’est manifesté pour vivifier Adam.</quote>
          </note>
        </noteGrp>
