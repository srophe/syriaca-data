            <bibl xml:id="work-1685" ana="#syriaca-hagiographic">
        <title xml:id="name1685-3" xml:lang="fr" source="#bib1685-1">Croix (texte)</title>
        <title xml:id="name1685-4" xml:lang="en" source="#bib1685-1" srophe:tags="#syriaca-headword">The Cross (text)</title>
        <author ref="http://syriaca.org/person/933" source="#bib1685-1" xml:lang="en">Elijah III Abu Halim — <foreign xml:lang="syr">ܐܠܝܐ ܬܠܝܬܝܐ ܐܒܘ ܚܠܝܡ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1685</idno>
        <idno type="number" subtype="BHS">1613</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1685-1">ܠܟ ܝܡܐ ܓܢܝܙܐ ܠܐ ܡܬܓܫܫܢܐ ܕܪ̈ܚܡܐ. ܘܬܗܘܡ ܚܢܢܐ ܕܠܐ ܡܬܬܡܝܫܝܢ ܓܙܝ̈ ܥܘܬܪܗ ܡܬܘܡܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1685-1">À toi mer cachée et insondable de miséricorde et flot de pitié dont les trésors de richesse éternelle sont inexplorables.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1685-1">ܘܠܐ ܒܟܐܦ̈ܐ ܫܠܡ̈ܠܡܬܐ ܐܬܛܟܣܘ ܕܘܡܣܝ̈ܗܿ. ܐܠܐ ܐܘܡܢܗܿ ܘܥܒܘܕܗܿ ܐܢܬ ܗܘ ܐܠܗܢ ܣܓܝܕܝܢ ܪ̈ܚܡܝܟ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1685-1">Et ses fondements n’ont pas été établi avec des pierres entières mais c’est toi notre Dieu qui est son artisan et son créateur, adorable est ta miséricorde.</quote>
          </note>
        </noteGrp>
        <listRelation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/1685" passive="http://syriaca.org/person/1661" source="#bib1685-1"/>
                </listRelation>
