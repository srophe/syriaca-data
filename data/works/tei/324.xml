        <title xml:id="name324-3" xml:lang="fr" source="#bib324-1">Abraham, évêque d’Arbèles (texte)</title>
        <title xml:id="name324-4" xml:lang="en" source="#bib324-1" srophe:tags="#syriaca-headword">Abraham, Bishop of Arbela (text)</title>
        <idno type="URI">http://syriaca.org/work/324</idno>
        <idno type="number" subtype="BHS">104</idno>
        <idno type="number" subtype="BHO">12</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib324-1">ܒܫܢܬ ܚܡܫ ܕܪܕܘܦܝܢ: ܐܬܬܚܕ ܗܘ̣ܐ ܐܒܪܗܡ ܐܦܣܩܘܦܐ ܕܐܪܒܝܠ: ܡܢ ܐܝܕܝ̈ ܐܕܘܪܦܪܗ ܡܘܗܦܛܐ ܕܚܕܝܒ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib324-1">En la cinquième année de notre persécution, fut pris Abraham, évêque d’Arbèles, par le chef des mages d’Adiabène, Adôrpareh.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib324-1">ܘܐܬܩܛܠ ܗܘ ܗܢܐ ܛܘܒܢܐ ܒܬܠܢܚܐ ܩܪܝܬܐ: ܒܚܡܫܐ ܒܐܝܪܚ ܫܒܛ ܒܕܣܗܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib324-1">Ce bien heureux fut mis à mort dans le village de Telnahâ, le cinq du mois lunaire de Shbat.</quote>
          </note>
        </noteGrp>
