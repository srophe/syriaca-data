            <bibl xml:id="work-259" ana="#hagiographic">
        <title xml:id="name259-1" xml:lang="syr" source="#bib259-1" srophe:tags="#syriaca-headword">ܨܘܠܛܢ ܡܗܪܕܘܟ ܘܐܕܘܪܦܪܘܐ ܘܡܗܪܢܪܣܐ</title>
        <title xml:id="name259-2" xml:lang="fr-x-bhs" source="#bib259-1">Sūlṭān Mahdōk w-ʾĀḏōrparwā w-Mēharnarsā</title>
        <title xml:id="name259-3" xml:lang="fr" source="#bib259-1">Soultan Mahdok, Adorparwa et Méharnarsa (texte)</title>
        <title xml:id="name259-4" xml:lang="en" source="#bib259-1" srophe:tags="#syriaca-headword">Soultan Mahdok, Adorparwa and Meharnarsa (text)</title>
        <idno type="URI">http://syriaca.org/work/259</idno>
        <idno type="BHS">38</idno>
        <idno type="BHO">1106</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib259-1">ܒܫܢܬ ܬܫܥ ܕܡܠܟܘܬܗ ܕܫܒܘܪ ܡܠܟܐ ܕܦܪ̈ܣܝܐ: ܟܕ ܡܢ ܟܕܘ ܣܒܪܬܗ ܕܡܫܝܚܐ ܥܠ ܟܠ ܐܬܦܪܣܬ ܗܘܬ: ܘܚܝ̈ܠܐ ܘܬܕܡܪ̈ܬܐ ܘܐܬ̈ܘܬܐ ܫܠܝ̈ܚܝܬܐ ܥܕܟܝܠ ܓܠܝܐܝܬ ܒܟܗܢܝ̈ܗܿ ܘܡܕܒܪ̈ܢܝܗܿ ܕܥܕܬܐ ܡܥܒܕ ܗܘ̣ܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib259-1">En la neuvième année du règne de Shahpour roi de Perse, alors que l’Évangile du Christ s’était déjà répandu partout et qu’il accomplissait encore par les prêtres et les chefs de l’Église des miracles, des merveilles et des signes apostoliques…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib259-1">ܐܬܟܠܠܘ ܕܝܢ ܗܢܘܿܢ ܩܕܝ̈ܫܐ ܒܬܪܥܣܪ ܒܟܢܘܢ ܐܚܪܝ. ܨܠܘܬܗܘܢ ܥܠ ܟܠܗ ܟܢܫܢ. ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib259-1">Ces saints furent couronnés le douze Kanôn II. Que leur prière soit sur toute notre assemblée. Amen.</quote>
          </note>
        </noteGrp>
