            <title xml:id="name5506-3" xml:lang="syr" source="#bib5506-3">ܕܝܠܗ ܕܡܠܦܢܐ ܡܪܝ ܝܥܩܘܒ ܡܐܡܪܐ ܕܥܠ ܐܘܪܗܝ ܘܥܠ ܐܘܪܫܠܡ ܕܠܠܝܐ ܕܚܡܫܐ ܕܫܒܬܐ ܕܐܘ̈ܫܥܢܐ</title>

            <author ref="http://syriaca.org/person/42" xml:lang="en" source="#bib5506-1">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
            </author>
            <idno type="URI">http://syriaca.org/work/5506</idno>
            <textLang mainLang="syr"/>
            <noteGrp type="abstract">
               <desc xml:lang="en">Abstract</desc>
               <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" resp="http://syriaca.org">
                  Jacob of Serugh’s Canticle on Edessa is a Syriac verse homily on the Abgar legend, contrasting Edessa’s faithful reception of Christ with Jerusalem’s rejection. Through the personification of Edessa and Jerusalem, Jacob presents Edessa as the first-fruit of Gentile faith and celebrates the spread of the Gospel among the nations.
               </note>
            </noteGrp>

