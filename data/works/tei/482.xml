        <title xml:id="name482-1" xml:lang="syr" source="#bib482-1" srophe:tags="#syriaca-headword">ܡܘܫܐ ܗܢܕܘܝܐ</title>
        <title xml:id="name482-2" xml:lang="fr-x-bhs" source="#bib482-1">Mūšē Hendwāyā</title>
        <title xml:id="name482-3" xml:lang="fr" source="#bib482-1">Moïse l’Indien (texte)</title>
        <title xml:id="name482-4" xml:lang="en" source="#bib482-1" srophe:tags="#syriaca-headword">Moses the Indian (text)</title>
        <author ref="http://syriaca.org/person/668" source="#bib482-1" xml:lang="en">Palladius of Aspuna — <foreign xml:lang="syr">ܦܠܕܝܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/482</idno>
        <idno type="number" subtype="BHS">262</idno>
        <idno type="number" subtype="BHO">854</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib482-1">ܐܝܬ ܗܘ̣ܐ ܕܝܢ ܓܒܪܐ ܚܕ: ܕܫܡܗ ܗܘܐ ܡܘܫܐ: ܕܐܝܬܘܗܝ ܗܘ̣ܐ ܒܓܢܣܗ ܓܝܪ... ܗܢܕܘܝܐ ܘܒܣܪܗ ܐܘܟܡܐ ܗܘܿܐ</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib482-1">Il y avait un homme qui s’appelait Moïse et qui par sa famille était Indien et en effet sa chair était noire.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib482-1">ܗܫܐ ܕܝܢ ܐܝܬܝܗܘܢ ܟܠܗܘܢ ܬܠܡܝܕܘ̈ܗܝ ܘܡܬܓܒܪ̈ܝ ܒܕܚܠܬ ܐܠܗܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib482-1">Maintenant tous sont ses disciples et sont devenus vaillants dans la crainte de Dieu.</quote>
          </note>
        </noteGrp>
