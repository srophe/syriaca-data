        <title xml:id="name1328-1" xml:lang="syr" source="#bib1328-1" srophe:tags="#syriaca-headword">ܐܬܩܢ</title>
        <title xml:id="name1328-2" xml:lang="fr-x-bhs" source="#bib1328-1">ʾAṯqen</title>
        <title xml:id="name1328-3" xml:lang="fr" source="#bib1328-1">Atqen (Rabban Mar) (texte)</title>
        <title xml:id="name1328-4" xml:lang="en" source="#bib1328-1" srophe:tags="#syriaca-headword">Atqen (Rabban Mar) (text)</title>
        <author ref="http://syriaca.org/person/928" source="#bib1328-1" xml:lang="en">John bar Kaldun — <foreign xml:lang="syr">ܝܘܚܢܢ ܒܪ ܟܠܕܘܢ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1328</idno>
        <idno type="number" subtype="BHS">1188</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1328-1">ܗܢܐ ܕܝܢ ܛܘܒܢܐ ܪܒܢ ܡܪܝ ܐܬܩܢ̣. ܥܠ ܐܝܕܘ̈ܗܝ ܕܪܒܢ ܒܪ ܝܠܕܐ ܐܬܬܠܡܕ ܘܐܦ ܗܘ ܠܕܘܒܪܐ ܗܢܐ ܩܕܝܫܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1328-1">Ce bienheureux Rabban Mâr Atqen fut lui aussi formé par Rabban Bar Yaldâ à cette vie sainte.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1328-1">ܥܢܕ ܕܝܢ ܪܒܢ ܡܪܝ ܐܬܩܢ ܡܢ ܥܠܡܐ ܗܢܐ. ܒܫܢܬ ܬܠܬܡܐܐ ܘܚܡܫܝܢ ܘܬܫܥ ܕܛܝܝ̈ܐ. ܨܠܘ̈ܬܗ ܥܠ ܟܠܢ ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1328-1">Rabban Mâr Atqen quitta ce monde en l’an 359 des Arabes; que sa prière soit sur nous tous. Amen.</quote>
          </note>
        </noteGrp>
