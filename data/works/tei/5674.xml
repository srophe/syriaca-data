         <bibl xml:id="work-5674" type="lawd:ConceptualWork">
            <title xml:id="name5674-2" xml:lang="en" source="#bib5674-2">Book of Protection</title>
            <title xml:id="name5674-1" xml:lang="syr" source="#bib5674-1" srophe:tags="#syriaca-headword">ܟܬܝܒܬܐ ܕܢܛܘܪܝܐ ܢܘܛܪܐ ܕܒܢܝܢܫܐ</title>
             
            <idno type="URI">http://syriaca.org/work/5674</idno>
            <textLang mainLang="syr"/>
            <!-- You can add an optional date element or delete this note. -->
            <noteGrp type="abstract">
               <desc xml:lang="en">Abstract</desc>
               <note corresp="http://syriaca.org/nhsl" xml:lang="en" type="abstract" resp="http://syriaca.org">The Book of Protection is a Syriac Christian tradition of ritual texts intended to provide practical assistance and protection in many areas of life. Its stated purpose is essentially the "protection of humanity from all that is evil and hostile," including illness, demons, the evil eye, dangers to property and livestock, and various social or personal difficulties. Although surviving manuscripts are mostly relatively modern copies, the tradition has much older roots and is closely related to earlier Syriac amuletic practices.
                  <!-- Replace with short description of this work -->
               </note>
          </noteGrp>
            <noteGrp type="incipit">
            <desc xml:lang="en"> Incipit(This is the Codex A from Hermann Gollancz's edition. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies)</ref>.</desc>
            <note xml:lang="syr" type="incipit">
            <quote source="#bib5674-1">ܥܠ ܚܝܠܐ ܐܠܗܝܐ ܡܫܪܐ ܥܒܕܐ ܚܛܝܐ ܠܡܟܬܒ ܟܬܝܒܬܐ ܕܢܛܘܪܝܐ </quote>
            </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5674-1">By the Divine power, the servant, the sinner, begins to write the 'Book of Protection'.</quote>
        </note>
      </noteGrp>

