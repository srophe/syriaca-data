            <bibl xml:id="work-1098" ana="#syriaca-hagiographic">
        <title xml:id="name1098-1" xml:lang="syr" source="#bib1098-1" srophe:tags="#syriaca-headword">ܫܘܒܚܐ ܠܝܫܘܥ</title>
        <title xml:id="name1098-2" xml:lang="fr-x-bhs" source="#bib1098-1">Šūḇḥā lʾīšōʿ</title>
        <title xml:id="name1098-3" xml:lang="fr" source="#bib1098-1">Shoubhâ-lishô d’Adiabène (texte)</title>
        <title xml:id="name1098-4" xml:lang="en" source="#bib1098-1" srophe:tags="#syriaca-headword">Shoubha-lisho of Adiabene (text)</title>
        <author xml:lang="fr" source="#bib1098-1" ref="http://syriaca.org/person/901">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Mshiḥazka</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܡܫܝܚܐܙܟܐ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Mshiha-Zekha</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1098</idno>
        <idno type="number" subtype="BHS">928</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1098-1">ܡܪܝ ܫܘܒܚܐ ܠܝܫܘܥ: ܗܢܐ ܡܢ ܟܪܟܐ ܕܒܝܬ ܣܠܘܟ ܐܝܬܝܗܘܢ ܗܘܘ ܐܒܗܘ̈ܗܝ: ܘܐܬܘ ܥܡܪܘ ܒܐܪܒܝܠ: ܘܡܢ ܙܥܘܪܘܬܗ ܠܥܕܬܐ ܢܩܝܦ ܗܘܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1098-1">Mar Shoubhâ-lîshô‘: ses parents étaient originaires de Karkâ de Beyt-Selôkh et étaient venus habiter à Arbèles; dès son plus jeune âge il fréquenta l’église.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1098-1">ܘܡܢ ܒܬܪ ܕܢܓܕ ܒܢܝܪܐ ܕܐܦܣܩܘܦܘܬܐ ܒܥܡܠܐ̈ ܕܠܐ ܡܬܡܠܠܝܢ ܘܒܬܥܫ̈ܐ ܕܠܐ ܡܬܚܫܒܝܢ ܥܢܕ ܠܗ ܘܐܬܥܦܝ ܒܙܘܝܚܐ ܪܒܐ ܡܢ ܒܬܪ ܕܕܒܪ ܗܘܐ ܠܡܗܝܡܢ̈ܐ ܙܒܢܐ ܢܓܝܪܐ ܕܬܠܬܝܢ ܘܚܕܐ ܫܢܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1098-1">Et après avoir supporté le joug de l’épiscopat dans des peines indicibles et des fatigues innombrables, il décéda et fut enterré en grande pompe après avoir administré les fidèles pendant la longue période de trente-et-un ans.</quote>
          </note>
        </noteGrp>
        <listRelation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/1098" passive="http://syriaca.org/person/2082" source="#bib1098-1"/>
