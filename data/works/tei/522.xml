        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib522-1">ܚܙܝܢܢ ܕܝܢ ܒܬܒܐܝܣ ܓܒܪܐ ܐܚܪܢܐ: ܕܫܡܗ ܐܡܘܢ: ܐܒܐ ܕܬܠܬܐ ܐܠܦܝ̈ܢ ܝܚܝ̈ܕܝܐ: ܐܝܠܝܢ ܕܐܦ ܛܒܐܢܣܝܘ ܩܪܝܢ ܠܗܘܢ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib522-1">Nous vîmes en Thébaïde un autre homme, qui s’appelait Ammon, père de trois mille solitaires, appelés aussi Tabennésiotes…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib522-1">ܘܡܛܠ ܕܒܟܠܗܝܢ ܫܒܝ̈ܚܬܗܘܢ ܬܗܪܢܢ ܡܢ ܟܠܗܝܢ ܥܘܕܪܢܐ ܩܢܝܢܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib522-1">Et parce que nous admirâmes toutes leurs actions glorieuses, nous acquîmes un secours d’elles toutes.</quote>
          </note>
        </noteGrp>
