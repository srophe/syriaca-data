            <bibl xml:id="work-1750" ana="#syriaca-hagiographic">
        <title xml:id="name1750-1" xml:lang="syr" source="#bib1750-1" srophe:tags="#syriaca-headword">ܐܘܦܪܘܣܝܢܝ ܐܙܡܪܓܕܘܣ</title>
        <title xml:id="name1750-2" xml:lang="fr-x-bhs" source="#bib1750-1">ʾĒwprōsīnī ʾEzmargḏōs</title>
        <title xml:id="name1750-3" xml:lang="fr" source="#bib1750-1">Euphrosyne (texte)</title>
        <title xml:id="name1750-4" xml:lang="en" source="#bib1750-1" srophe:tags="#syriaca-headword">Euphrosyne (text)</title>
        <idno type="URI">http://syriaca.org/work/1750</idno>
        <idno type="number" subtype="BHS">1685</idno>
        <idno type="number" subtype="BHO">289</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1750-1">ܐܝܬ ܗܘܐ ܕܝܢ ܒܙܒܢ ܒܡܕܝܢܬܐ ܪܒܬܐ ܐܠܟܣܢܕܪܝܐ. ܓܒܪܐ ܚܕ ܡܝܩܪܐ ܘܫܡܗ ܗܘܐ ܦܦܢܛܘܣ: ܘܚܦܝܛ ܗܘܐ ܕܢܫܡܠܐ ܦܘܩ̈ܕܢܘܗܝ ܕܐܠܗܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1750-1">Il était une fois dans la grande ville d’Alexandrie un homme honorable qui s’appelait Paphnuce, et il était appliqué à exécuter les commandements de Dieu.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1750-1">ܚܝܐ ܕܝܢ ܐܒܘܗܿ ܒܕܝܪܐ ܗܿܝ ܫ̈ܢܝܐ ܥܣܪ: ܘܚܙܩ ܠܘܬ ܡܪܗ. ܘܫܒܩ ܐܪ̈ܥܢܝܬܐ ܘܐܬܩܒܪ ܥܠ ܓܪܡܗ ܕܩܕܝܫܬܐ ܐܘܦܪܘܣܝܢܐ ܒܪܬܗ ܠܬܫܒܘܚܬܐ ܕܐܒܐ.... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1750-1">Et son père vécut dans ce monastère dix ans; et il partit vers son Seigneur, et il abandonna les choses terrestres et fut enterré près du corps de sainte Euphrosyne sa fille pour la gloire du Père… Amen.</quote>
          </note>
        </noteGrp>
