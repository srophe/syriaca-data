        <author ref="http://syriaca.org/person/51" source="#bib5876-1" xml:lang="en">Severus of Antioch — <foreign xml:lang="syr">ܣܘܝܪܝܘܣ
                        ܕܐܢܛܝܘܟܝܐ</foreign>
        </author>
        <author ref="http://syriaca.org/person/113" source="#bib5876-1" xml:lang="en">Jacob of Edessa — <foreign xml:lang="syr">ܝܥܩܘܒ
