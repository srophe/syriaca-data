            <bibl xml:id="work-1327" ana="#syriaca-hagiographic">
        <title xml:id="name1327-1" xml:lang="syr" source="#bib1327-1" srophe:tags="#syriaca-headword">ܥܒܕܝܫܘܥ ܕܣܢܝܐ</title>
        <title xml:id="name1327-2" xml:lang="fr-x-bhs" source="#bib1327-1">ʿAḇdīšōʿ Dasnāyā</title>
        <title xml:id="name1327-3" xml:lang="fr" source="#bib1327-1">Abdisho‘ de Dasen (texte)</title>
        <title xml:id="name1327-4" xml:lang="en" source="#bib1327-1" srophe:tags="#syriaca-headword">ʿAbdisho‘ of Dasen (text)</title>
        <author xml:lang="fr" source="#bib1327-1" ref="http://syriaca.org/person/928">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yoḥannan</forename>
                        <addName type="family" sort="2">bar Kaldun</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܘܚܢܢ</forename>
                        <addName type="family" sort="2">ܒܪ ܟܠܕܘܢ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jean</forename>
                        <addName type="family">Bar-Kaldoun</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1327</idno>
        <idno type="number" subtype="BHS">1187</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1327-1">ܗܢܐ ܕܝܢ ܛܘܒܢܐ ܪܒܢ ܥܒܕܝܫܘܥ ܡܢ ܐܬܪܐ ܕܕܣܢ ܐܝܬܘܗܝ ܗܘܐ ܒܓܢܣܗ. ܘܒܥܘܡܪܐ ܗܢܐ ܕܒܝܬ ܨܝܪܐ ܐܬܬܠܡܕ. ܥܠ ܐܝܕܘ̈ܗܝ ܕܪܒܢ ܒܪ ܝܠܕܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1327-1">Ce bienheureux Rabban ‘Abîshô‘ était par sa famille originaire du pays de Dasen; il fut formé dans ce couvent de Beyt-Sayaré par Rabban Bar-Yaldâ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1327-1">ܘܦܓܪܗ ܐܬܬܣܝܡ ܒܒܝܬ ܣܗ̈ܕܐ̣. ܒܐܝܩܪܐ ܕܝܐܐ ܗܘܐ ܠܗ ܘܡܬܬܚܝܒ. ܘܗܐ ܢܒܥܝܢ ܡܢܗ ܥܘܕܪ̈ܢܐ ܠܟܠ ܕܡܬܓܘܣ ܒܨ̈ܠܘܬܗ ܕܒܗܝܢ ܘܐܦ ܚܢܢ ܡܚ̈ܝܠܐ ܢܗܘܘܢ ܥܠܝܢ ܪ̈ܚܡܐ ܒܬܪ̈ܝܗܘܢ ܬܘܩ̈ܢܐ ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1327-1">Et son corps fut placé dans le martyrion avec l’honneur qui lui était dû; et voilà qu’en coulent des secours pour tous ceux qui se réfugient dans ses prières. Que par elles sur nous aussi, faibles, vienne la miséricorde dans les deux créations. Amen.</quote>
          </note>
        </noteGrp>
