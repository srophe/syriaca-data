            <bibl xml:id="work-1779" ana="#syriaca-hagiographic">
        <title xml:id="name1779-3" xml:lang="fr" source="#bib1779-1">Apocalypse de Méthode (texte)</title>
        <title xml:id="name1779-4" xml:lang="en" source="#bib1779-1" srophe:tags="#syriaca-headword">Apocalypse of Methodius (text)</title>
        <author source="#bib1779-1" ref="http://syriaca.org/person/2800" role="pseudo">
                    <persName xml:lang="en" srophe:tags="#syriaca-headword #syriaca-anglicized">
                        <forename>Methodius</forename>
                        <addName type="untagged-title">of <placeName>Olympus</placeName>
                        </addName>
                    </persName> —   (<persName xml:lang="fr">
                        <forename>Méthode</forename>
                        <addName type="untagged-title">d’<placeName>Olympe</placeName>
                        </addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1779</idno>
        <idno type="number" subtype="BHS">1716</idno>
        <idno type="number" subtype="CPG">1830</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1779-1">ܢܘܕܥ ܗܟܝܠ ܒܪܝܫ ܡܠܬܢ ܠܝܕܘ̈ܥܐ ܕܦܘܪܫܢܐ: ܟܕ ܢܦܩ ܐܕܡ ܘܚܘܐ ܡܢ ܦܪܕܝܣܐ ܒܬܘ̈ܠܐ ܗܘܘ ܬܪ̈ܝܗܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1779-1">Faisons donc savoir au début de notre propos aux connaisseurs du discernement: quand Adam et Ève sortirent du Paradis, tous deux étaient vierges.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1779-1">ܘܠܢ ܕܝܢ ܢܫܘܐ ܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܠܡܠܟܘܬܐ ܕܝܠܗ ܫܡܝܢܝܬܐ ܥܡ ܟܠܗܘܢ ܥܒ̈ܕܝ ܨܒܝܢܗ. ܘܢܣܩ ܬܫܒܘܚܬܐ ܘܐܝܩܪܐ ܘܣܓܕܬܐ ܘܪܘܡܪܡܐܿ. ܗܫܐ ܘܒܟܠܙܒܢ ܠܥܠܡܥܠܡܝܢ ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1779-1">Quant à nous, que notre Seigneur Jésus-Christ nous juge dignes de son Royaume céleste avec tous ceux qui auront fait sa volonté, et puissions-nous faire monter la louange, l’honneur, l’adoration et l’exaltation, maintenant, en tout temps et pour les siècles des siècles. Amen.</quote>
          </note>
        </noteGrp>
