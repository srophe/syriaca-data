        <title xml:id="name1555-2" xml:lang="fr-x-bhs" source="#bib1555-1">Dīyōsqōrōs</title>
        <title xml:id="name1555-3" xml:lang="fr" source="#bib1555-1">Dioscore (texte)</title>
        <title xml:id="name1555-4" xml:lang="en" source="#bib1555-1" srophe:tags="#syriaca-headword">Dioscorus (text)</title>
        <author source="#bib1555-1" ref="http://syriaca.org/person/857">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Jerome</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܐܝܪܢܘܡܝܣ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jérôme</forename>
                    </persName>)</author>
        <author source="#bib1555-1" ref="http://syriaca.org/person/474">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">ʿEnanishoʿ</forename>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܥܢܢܝܫܘܥ</forename>
                    </persName> (<persName xml:lang="fr">
                        <forename>Enanicho</forename>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1555</idno>
        <idno type="number" subtype="BHS">1469</idno>
        <idno type="number" subtype="BHO">843</idno>
        <idno type="number" subtype="CPG">5620</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1555-1">ܐܚܪܢܐ ܬܘܒ ܩܫܝܫܐ ܚܙܝܢ ܚܢܢ ܒܬܒܐܝܣ. ܕܫܡܗ ܕܝܣܩܪܘܣ. ܐܒܐ ܕܡ̈ܐܐ ܝܚܝ̈ܕܝܐ ܐܚ̈ܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1555-1">Nous vîmes encore en Thébaïde un autre prêtre qui s’appelait Dioscore et était le père de cent frères solitaires.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1555-1">ܬܘܒ ܡܙܗܪ ܗܘܐ ܠܗܘܢ ܘܐܡܪ. ܕܕܟܝܐܝܬ. ܘܙܗܝܐܝܬ ܢܩܒܠܘܢ ܦܓܪܗ ܘܕܡܗ ܕܡܫܝܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1555-1">Il les mit encore en garde et leur dit de recevoir le corps et le sang du Christ dans la pureté et la chasteté.</quote>
          </note>
        </noteGrp>
