         <bibl xml:id="work-5504" type="lawd:ConceptualWork">
        <title xml:id="name5504-1" xml:lang="en" source="#bibl5504-2" srophe:tags="#syriaca-headword">Book of the Bee </title>
        <title xml:id="name5504-2" xml:lang="syr" source="#bib5504-1" srophe:tags="#syriaca-headword"> ܟܬܒ ܕܕܒܘܪܝܬܐ</title>
        <title xml:id="name5504-3" xml:lang="La" source="#bib5504-3" srophe:tags="#syriaca-headword">Liber Apis</title>
        <title xml:id="name5504-4" xml:lang="Ar" source="#bib5504-1" srophe:tags="#syriaca-headword">کتاب النحلة</title>
            <author ref="http://syriaca.org/person/745" xml:lang="en" source="#bibl5504-2"> Solomon of Basra — <foreign xml:lang="syr"> ܫܠܝܡܘܢ ܕܒܨܪܐ </foreign>
            </author>
            <idno type="URI">http://syriaca.org/work/5504</idno>
            <textLang mainLang="syr"/>
             <date notBefore="1207" notAfter="1237"> c.1222 </date>
            <noteGrp type="abstract">
               <desc xml:lang="en">Abstract</desc>
               <note corresp="http://syriaca.org/nhsl" xml:id="" xml:lang="en" type="abstract" resp="http://syriaca.org">
                  A collection of Theological works form Solomon of Basra from the 13th century.
               </note>
            </noteGrp>
            <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" source="#bib5504-1" type="incipit">
            <quote >  ܠܐ ܠܡ ܓܝܪ ܚܲܝܵܒܝܢ ܒܢ̈ܝܐ ܠܡܣܡ ܣܝܡ̈ܬܐ ܐܒܗ̈ܐ. ܐܠܐ ܐܒܗ̈ܐ ܠܒܢ̈ܝܐ ܪ̈ܘܼܚܢܝܐ ܡܼܪ ܛܘܼܒܢܐ ܦܵܘܠܘܿܣ. ܒܕܓܘܿܢ ܚܲܘܒܵܬܐ ܚܲܝܵܒܝܢܢ ܠܡܦܪܥܟ. ܐܘܿ ܐܚܘܢ ܒܝܒܢ ܘܚܘܼܛܪܐ ܕܣܝܒܘܼܬܢ. ܚܣܝܗ. ܡܪܝ ܢܲܪܣܲܝ ܐܲܦܸܣܩܘܿܦܐ ܕܟܘܿܝ ܒܝܬ ܘܲܙܝܼܩ</quote>
          </note>
          <note xml:lang="en" source="#bib5504-2" type="incipit">
            <quote >'The children ought not to lay up treasures for the parents, but the parents for the spiritual children,' saith the blessed Paul; therefore we are bound to repay thee the debt of love, O beloved brother and staff of our old age, saint of God, Mâr Naeses, bishop of Khônî-Shâbôr Bêth-Wâzîḳ</quote>
          </note>
          </noteGrp>
          <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" source="#bib5504-1" type="explicit">
            <quote>ܕܠܗ ܫܘܒܚܐ ܘܐܘܚܕܢܐ ܘܩܘܠܣܐ ܘܪܘܡܪܡܐ ܘܐܝܩܪܐ ܠܥܠܡ ܘܠܥܠܡ ܥܠܡܝܢ ܐܡܝܢ ܘܐܡܝܢ.</quote>
          </note>
          <note xml:lang="en" source="#bib5504-2" type="explicit">
            <quote >To Him be glory and dominion and praise and exaltation and honour for ever and ever. Amen and Amen</quote>
          </note>
        </noteGrp>
