        <title xml:id="name322-1" xml:lang="syr" source="#bib322-1" srophe:tags="#syriaca-headword">ܬܐܕܛܐ ܙܢܝܬܐ</title>
        <title xml:id="name322-2" xml:lang="fr-x-bhs" source="#bib322-1">Tēʾādāṭē zānīṯā</title>
        <title xml:id="name322-3" xml:lang="fr" source="#bib322-1">Théodote la courtisane (texte)</title>
        <title xml:id="name322-4" xml:lang="en" source="#bib322-1" srophe:tags="#syriaca-headword">Theodote the Courtesan (text)</title>
        <idno type="URI">http://syriaca.org/work/322</idno>
        <idno type="number" subtype="BHS">102</idno>
        <idno type="number" subtype="BHO">1179</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib322-1">ܒܫܢܬ ܫܬܡܐܐ ܘܐܪܒܥܝܢ ܘܬܪܬܝܢ: ܪܕܘܦܝܐ ܩܡ ܥܠܝܢ ܒܝܪܚ ܐܝܠܘܠ: ܒܝܘܡܐ ܕܥܪܘܒܬܐ: ܒܦܝܠܝܦܘܣ ܡܕܝܢܬܐ. ܐܓܪܦܘܣ ܗܓܡܘܢܐ ܕܒܚ ܠܐܠܗ̈ܐ: ܘܨܒܐ ܗܘ̣ܐ ܕܟܠܗܘܢ ܒܢܝ̈ܢܫܐ ܥܡܗ ܢܕܒܚܘܢ ܠܗܘܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib322-1">En l’an 642 il y eut une persécution contre nous au mois de septembre, un vendredi, dans la ville de Philippes. Le gouverneur Agrippa sacrifia aux dieux et voulut que tout le monde leur sacrifiât avec lui.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib322-1">ܘܪܓܡܘܗܿ ܠܬܐܕܛܐ: ܘܢܦܫܗܿ ܠܡܠܟܘܬܐ ܕܫܡܝܐ ܫܢܝܬ. ܫܘܒܚܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib322-1">Et ils lapidèrent Théodote et son âme partit au royaume des cieux. Gloire… Amen.</quote>
          </note>
        </noteGrp>
