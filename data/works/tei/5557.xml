    <body>
      <bibl xml:id="work-5557" type="lawd:ConceptualWork">
        <title xml:id="name5557-1" xml:lang="en" srophe:tags="#syriaca-headword" source="#bib5557-2">That it is not beautiful for the servant of God who had renunciation the world and has gone forth to seek even the truth,
          out of fear that he shall not find the truth to desist from seeking it or from the fervour which is born from the desire of divine things, or from the inquiry after their mystic secrets which are described mysteriously.
          That, by this seeking, the mind may desist from evil distraction and recollections of the affections</title>
        <title xml:id="name5557-2" xml:lang="syr" source="#bib5557-1"><foreign xml:lang="syr">ܥܠ ܗܝ ܕܠܐ ܦܐܐ ܠܥܒܕܗ ܕܐܠܗܐ ܕܐܣܬܪܩ ܡܢ ܥܠܡܐ ܘܢܦܩ ܒܒܝܬܗ ܘܐܦ ܕܫܪܪܐ܆ ܡܢ ܥܠܬ ܩܢܛܐ ܟܐܡܬ ܕܕܡ ܠܐ ܢܫܟܚ ܠܫܪܪܐ܆ 
            ܢܦܘܫ ܡܢ ܒܥܬܐ ܕܝܠܗ ܕܫܪܪܐ܆ ܘܡܢ ܪܬܚܐ ܚܡܝܡܐ ܕܡܬܝܠܕ ܡܢ ܣܘܘܚܐ ܕܒܐܠܗܝܬܐ܆ ܘܒܨܬܐ ܕܐܪ̈ܙܝܗܝܢ ܕܪܫܝܡܝܢ ܐܪܙܢܐܝܬ. ܕܒܗܕܐ ܒܥܬܐ܆ ܢܦܘܫ ܪܥܝܢܐ ܡܢ ܦܗܝܐ ܒܝܫܐ܆ ܘܥܘ̈ܗܕܢܐ ܚܫܢܝ̈ܐ</foreign></title>
        <author ref="http://syriaca.org/person/550" source="#bib5557-1" xml:lang="en">Isaac of Nineveh — <foreign xml:lang="syr">ܐܝܣܚܩ
            ܕܢܝܢܘܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5557</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5557-1"><foreign xml:lang="syr">ܬܠܬܐ ܐܢܘܢ ܛܟܣ̈ܐ܆ ܕܒܗܘܢ ܡܬܕܪܓ ܟܠܗ ܪܗܛܐ ܕܒܪܢܫܐ.</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5557-2">There are three degrees which constitute the whole course of man.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5557-1"><foreign xml:lang="syr">ܘܡܢ ܗܠܝܢ ܬܫܬܗܐ ܚܡܝܡܘܬܐ ܕܙܘܥܗ܆ ܘܢܦܠ ܒܪ̈ܓܝܠܬܐ.</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5557-2">this would quench the ardour of its emotion and it would fall into desires.</quote>
          </note>
        </noteGrp>
