        <title xml:id="name799-1" xml:lang="syr" source="#bib799-1" srophe:tags="#syriaca-headword">ܐܒܪܗܡ ܚܒܝܫܐ</title>
        <title xml:id="name799-2" xml:lang="fr-x-bhs" source="#bib799-1">ʾAḇrāhām ḥḇīšā</title>
        <title xml:id="name799-3" xml:lang="fr" source="#bib799-1">Abraham le Reclus (texte)</title>
        <title xml:id="name799-4" xml:lang="en" source="#bib799-1" srophe:tags="#syriaca-headword">Abraham the Recluse (text)</title>
        <author ref="http://syriaca.org/person/74" source="#bib799-1" xml:lang="en">John of Ephesus — <foreign xml:lang="syr">ܝܘܚܢܢ ܕܐܦܣܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/799</idno>
        <idno type="number" subtype="BHS">589</idno>
        <idno type="number" subtype="BHO">13</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib799-1">ܨܒܿܝܢܢ ܬܘܒ ܕܢܝܬܐ ܠܥܘܗܕܢܐ̣. ܐܦ ܬܫܥܝܬܗ ܕܣܒܐ ܐܒܪܗܡ. ܐܝܢܐ ܕܡܩܕܫܐ ܡܬܩܪܐ ܗܘܐ. ܘܗܘܐ ܒܣܝܒܘܬܐ ܐܝܟ ܒܪ ܐܫܬܝܢ ܫ̈ܢܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib799-1">Nous voulons encore apporter le souvenir de l’histoire du vieillard Abraham appelé le Consacré, qui était arrivé à la vieillesse, puisqu’il avait soixante ans.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib799-1">ܘܒܫܘܠܡܐ ܕܫܢܬܐ ܕܬܡܢܐ̣. ܢܦ̣ܩ ܡܢ ܥܠܡܐ ܒܫܘܠܡܐ ܛܒܐ ܕܬܝܒܘܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib799-1">Et à la fin de la huitième année il quitta le monde dans la bonne fin de la pénitence.</quote>
          </note>
        </noteGrp>
