        <title xml:id="name85-4" xml:lang="en" type="abbreviation" srophe:tags="#canonical" source="#bib85-5">2 Thess</title>
        <title xml:id="name85-5" xml:lang="en" source="#bib85-5 #bib85-20 #bib85-24 #bib85-26 #bib85-28 #bib85-30 #bib85-32 #bib85-34 #bib85-36 #bib85-40 #bib85-42 #bib85-46">2 Thessalonians</title>
        <title xml:id="name85-6" xml:lang="syr-Syrj" source="#bib85-4">ܐܶܓܰܪܬܳܐ ܕܦܰܘܠܳܘܣ ܕܰܠܘܳܬ ܬܶܣܰܠܳܘܢܺܝ̈ܩܳܝܶܐ ܕܬܰܪܬܶܝܢ</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name85-7" source="#bib85-20">ܫܠܡ̣ܬ ܐܓܪܬܐ ܕܠܘܬ ܬܣ̈ܠܘܢܝܩܝܐ ܕܬܪܬܝܢ ܕܐܬܟܬܒܬ ܡܢ ܠܕܝܩܝܐ ܕܦܝܣܝܕܝܐ ܕܐܫܬ̣ܕܪܬ ܒܝܕ ܛܝܡܬܐܘܣ. ܕܐܝܬ ܒܗ̇ ܦܬܓܡ̈ܐ ܡܐܐ̣ ܘܥܣܪܝܢ .ܘ:ܘ.</title>
        <title xml:lang="en" xml:id="name85-8" source="#bib85-22 #bib85-38">The Epistle of 2 Thessalonians, according to the Peshitta version</title>
        <title xml:lang="syr" type="final-rubric" xml:id="name85-9" source="#bib85-26">ܫܠܡܬ. ܐܓܪܬܐ. ܕܠܘܬ. ܬܣܠܘ̈ܢܝܩܝܐ. ܕܬܪܬܝܢ. ܕܐܬܟܬܒܬ. ܡܢ ܪܗܘܡܐ. ܘܗܘܝܐ. ܡܐܐ. ܘܬܡܢܬܥܣܪ ܦܬܓ̈ܡܝܢ.</title>
        <title xml:lang="en" xml:id="name85-10" source="#bib85-44">The Epistle of 2 Thessalonians</title>
        <title xml:lang="syr" xml:id="name85-11" source="#bib85-2">ܐܓ݁ܪܬ݁ܐ ܕ݂ܠܘܬ݂ ܬ݂ܣܠܘܢܝ̈ܩܝܐ ܕ݂ܬ݂ܪ̈ܬܿܝܢ</title>
        <title xml:lang="syr-Syrj" xml:id="name85-12" source="#bib85-2">ܐܶܓ݁ܰܪܬ݁ܳܐ ܕ݂ܰܠܘܳܬ݂ ܬ݂ܶܣܰܠܳܘܢܺܝ̈ܩܳܝܶܐ ܕ݂ܬ݂ܰܪ̈ܬܿܶܝܢ</title>
        <title xml:lang="en" xml:id="name85-13" resp="http://syriaca.org">The Second Epistle to the Thessalonians</title>
        <idno type="URI">http://syriaca.org/work/85</idno>
        <idno type="URI">https://en.wikipedia.org/wiki/Second_Epistle_to_the_Thessalonians</idno>
        <idno type="URI">https://www.wikidata.org/wiki/Q131107</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note corresp="http://syriaca.org/nhsl http://syriaca.org/bible" xml:lang="en" type="abstract" resp="http://syriaca.org">
          <title xml:lang="en" ref="http://syriaca.org/work/85">2 Thessalonians (Peshitta version)</title> is extant as early as the 5th-6th century 
                    and consistently circulates as one of the <title xml:lang="en" ref="http://syriaca.org/work/159">Pauline Epistles (Peshitta version)</title>.</note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib85-3">ܦܿܘܠܘܣ ܘܣܠܘܢܘܣ ܘܛܝܡܬܼܐܘܣ܃ ܠܥܕ̱ܿܬܿܐ ܕܿܬܼܣܠܘܢܝܩܝܐ̈ ܕܿܒܼܐܠܗܐ ܐܒܼܘܼܢ܂ ܘܡܪܢ ܝܫܘܼܥ ܡܫܝܚܐ܂</quote>
          </note>
        </noteGrp>
