        <title xml:id="name261-1" xml:lang="syr" source="#bib261-1" srophe:tags="#syriaca-headword">ܫܒܘܪ ܘܐܝܣܚܩ ܘܡܥܢܐ ܘܐܒܪܗܡ ܘܫܡܥܘܢ</title>
        <title xml:id="name261-2" xml:lang="fr-x-bhs" source="#bib261-1">Šāḇōr w-ʾĪsḥāq w-Maʿnā w-ʾAḇrōhōm w-Šemʿōn</title>
        <title xml:id="name261-3" xml:lang="fr" source="#bib261-1">Shahpour, Isaac, Ma‘na, Abraham et Simon (texte)</title>
        <title xml:id="name261-4" xml:lang="en" source="#bib261-1" srophe:tags="#syriaca-headword">Shabor, Isaac, Maʿna, Abraham and Simeon (text)</title>
        <idno type="URI">http://syriaca.org/work/261</idno>
        <idno type="number" subtype="BHS">40</idno>
        <idno type="number" subtype="BHO">1042</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib261-1">ܒܫܢܬ ܬܠܬܝܢ ܕܡܠܟܘܬܗ ܕܫܒܘܪ ܡܠܟܐ ܕܦܪܣ: ܩܪܒܘ ܓܒܪ̈ܐ ܡܓܘ̈ܫܐ: ܘܐܟܠܘ ܩܪ̈ܨܝܗܘܢ ܕܢܨܪ̈ܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib261-1">En la trentième année du règne de Shahpour roi de Perse, les Mages vinrent calomnier les chrétiens.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib261-1">ܘܦܩܕ ܠܩܫܬ̈ܐ: ܘܡܚܐܘܗܝ ܒܓܐܪ̈ܐ ܘܡܝܬ. ܘܐܬܘ ܐܢܫܐ ܐܚ̈ܐ ܟܪ̈ܣܛܝܢܐ ܘܓܢܒܘ ܫܠܕܝ̈ܗܘܢ: ܘܩܒܪܘ ܡܛܫܝܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib261-1">Et il commanda les archers et ils tirèrent des flèches et il mourut. Et des frères chrétiens vinrent dérober leurs corps et les ensevelirent en cachette.</quote>
          </note>
        </noteGrp>
        <listRelation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/261" passive="http://syriaca.org/person/1450 http://syriaca.org/person/1791 http://syriaca.org/person/1354 http://syriaca.org/person/1110 http://syriaca.org/person/1474" source="#bib261-1">
            <desc xml:lang="en">This work commemorates <persName ref="http://syriaca.org/person/1450">Shapor, bishop of Niqator</persName>; <persName ref="http://syriaca.org/person/1791">Isaac, bishop of Karka</persName>; <persName ref="http://syriaca.org/person/1354">Maʿna</persName>; <persName ref="http://syriaca.org/person/1110">Abraham</persName>;  and <persName ref="http://syriaca.org/person/1474">Simeon</persName>
            </desc>
          </relation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/261" passive="http://syriaca.org/person/1450" source="#bib261-1">
