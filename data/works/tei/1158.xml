            <bibl xml:id="work-1158" ana="#syriaca-hagiographic">
        <title xml:id="name1158-1" xml:lang="syr" source="#bib1158-1" srophe:tags="#syriaca-headword">ܩܘܣܛܢܛܝܢܘܣ</title>
        <title xml:id="name1158-2" xml:lang="fr-x-bhs" source="#bib1158-1">Qōsṭantīnōs</title>
        <title xml:id="name1158-3" xml:lang="fr" source="#bib1158-1">Constantin, empereur (texte)</title>
        <title xml:id="name1158-4" xml:lang="en" source="#bib1158-1" srophe:tags="#syriaca-headword">Constantine the Emperor (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib1158-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1158</idno>
        <idno type="number" subtype="BHS">997</idno>
        <idno type="number" subtype="BHO">1070</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1158-1">ܝܫܘܥ ܕܐܝܬܘܗܝ ܢܘܗܪܐ ܪܒܐ ܠܕܚܐܪ ܒܗ: ܕܢܚ ܒܝ ܘܐܢܗܪ ܘܐܬܢܐ ܫܪܒܟ ܢܗܝܪܐܝܬ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1158-1">Jésus, toi qui es une grande lumière pour celui qui te regarde, brille sur moi, éclaire-moi, que je raconte brillamment ton histoire.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1158-1">ܩܒܠ ܐܢܝܢ ܠܟܬܝܒ̈ܬܐ ܩܘܣܛܢܛܝܢܘܣ: ܘܩܪܐ ܐܢܝܢ ܘܚܕܝ ܘܐܬܦܨܚ ܘܙܡܪ ܫܘܒܚܐ ܘܣܡ ܗܘܐ ܐܦܘ̈ܗܝ ܕܢܐܚܘܕ ܕܐܪܐ ܥܡ ܣܛܢܐ: ܘܠܗܪ̈ܣܝܣ ܢܣܚܘܦ ܢܦܩ ܡܢ ܥܕ̈ܬܐ. ܘܗ ܡܢ ܗܝܕܝܢ ܫܪܝ ܢܨܚ ܒܐܬܠܝܛܘܬܐ: ܨܠܘܬܗ ܬܗܘܐ ܫܘܪܐ ܕܪ̈ܚܡܐ ܠܟܠܗ ܟܢܫܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1158-1">Constantin reçut ces lettres, il les lut et se réjouit, et fut rempli d’allégresse et chanta gloire; il se décida à livrer combat à Satan et à expulser et à faire sortir les hérésies des Églises. Dès lors il s’illustra dans la vaillance; que sa prière soit un mur de miséricorde pour toute notre assemblée.</quote>
          </note>
        </noteGrp>
