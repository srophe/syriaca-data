        <title xml:id="name229-1" xml:lang="syr" source="#bib229-1" srophe:tags="#syriaca-headword">ܚܒܝܒ</title>
        <title xml:id="name229-2" xml:lang="fr-x-bhs" source="#bib229-1">Ḥabīb</title>
        <title xml:id="name229-3" xml:lang="fr" source="#bib229-1">Habib (texte)</title>
        <title xml:id="name229-4" xml:lang="en" source="#bib229-1" srophe:tags="#syriaca-headword">Ḥabib (text)</title>
        <author ref="http://syriaca.org/person/42" source="#bib229-1" xml:lang="en">Jacob of Serugh — <foreign xml:lang="syr">ܝܥܩܘܒ ܕܣܪܘܓ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/229</idno>
        <idno type="number" subtype="BHS">8</idno>
        <idno type="number" subtype="BHO">368</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib229-1">ܚܒܝܒ ܣܗܕܐ ܠܒܝܫ ܓܘܙܠܬܐ ܩܪܢܝ ܡܢ ܢܘܪܐ: ܕܐܦ ܠܗ ܐܨܘܪ ܨܠܡܐ ܕܫܘܦܪ̈ܐ ܥܡ ܢܨܝ̈ܚܐ܀</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib229-1">Le martyr Habîb revêtu de flammes m’a appelé depuis le feu, pour que je peigne pour lui aussi l’image des beautés avec les glorieux.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib229-1">ܘܒܝܩܕܢܗ ܐܬܕܟܝ ܗܘ̣ܐ ܐܬܪܐ ܟܠܗ: ܒܪܝܟ ܗ̣ܘ ܕܝܗ̣ܒ ܠܗ ܟܠܝܠܐ ܘܫܘܒܚܐ ܘܫܡܐ ܛܒܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib229-1">Et tout l’endroit a été purifié par sa mort par le feu; béni soit celui qui lui a donné la couronne, la gloire et le bon nom.</quote>
          </note>
        </noteGrp>
