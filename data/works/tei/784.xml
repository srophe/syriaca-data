            <bibl xml:id="work-784" ana="#syriaca-hagiographic">
        <title xml:id="name784-1" xml:lang="syr" source="#bib784-1" srophe:tags="#syriaca-headword">ܘܐܝܓܢܐܛܝܘܣ ܒܣܝܠܝܘܣ ܘܓܪܝܓܘܪܝܘܣ</title>
        <title xml:id="name784-2" xml:lang="fr-x-bhs" source="#bib784-1">Bāsīlīyōs wa-Órīǥōrīyōs w-ʾĪǥnāṭīyōs</title>
        <title xml:id="name784-3" xml:lang="fr" source="#bib784-1">Basile, Grégoire et Ignace (texte)</title>
        <title xml:id="name784-4" xml:lang="en" source="#bib784-1" srophe:tags="#syriaca-headword">Basil, Gregory, and Ignatius (text)</title>
        <author xml:lang="fr" source="#bib784-1" ref="http://syriaca.org/person/51">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Severus</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/10">Antioch</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܣܘܝܪܝܘܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܢܛܝܘܟܝܐ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Sévère</forename>
                        <addName type="untagged-title">d’Antioche</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/784</idno>
        <idno type="number" subtype="BHS">574</idno>
        <idno type="number" subtype="CPG">7035</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib784-1">Que personne, en regardant la loi des éloges, ne pense de moi que c’est dans cette pensée que je me suis avancé en public, comme celle qu’ont ceux qui prononcent des discours festifs et composent avec art des éloges.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib784-1">ܗܿܢܘܢ ܕܒܬܟܫ̈ܦܬܗܘܢ ܢܬܠ ܡܫܝܚܐ ܐܠܗܐ ܘܡܠܬܐ: ܗܿܘ ܕܒܪܐ ܘܗܦܟ ܡܢ ܕܪܝܫ ܒܪܐ ܠܚܝܘܬܐ ܡܠܝܠܬܐ ܒܪܢܫܐ̣. ܕܟܕ ܕܠܐ ܥܩܬܐ ܘܐܝܟܢܐ ܕܠܗ ܪܚܝܡ ܢܦܩܝܢܢ ܠܗܘܢ ܠܚ̈ܝܐ ܗܠܝܢ ܕܗܪܟܐ̣. ܢܚܕܐ ܘܢܬܒܣܡ ܥܡ ܩܕܝܫ̈ܐ ܐܦ ܒܡܠܟܘܬܐ ܕܫܡܝܐ. ܠܫܘܒܚܐ ܕܝܠܗ ܟܝܬ ܘܕܐܒܐ ܘܕܪܘܚܐ ܩܕܝܫܐ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib784-1">Que par leurs intercessions le Christ Dieu et Verbe, celui qui a créé et recréé une seconde fois l’homme, animal raisonnable, nous donne, en ayant passé la vie d’ici-bas sans affliction et comme il lui plait, d’être nous aussi joyeux et heureux avec les saints dans le royaume des cieux, pour sa gloire et celle du Père et de l’Esprit Saint… Amen.</quote>
          </note>
        </noteGrp>
