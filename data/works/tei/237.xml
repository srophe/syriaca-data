        <title xml:id="name237-1" xml:lang="syr" source="#bib237-1" srophe:tags="#syriaca-headword">ܐܓܦܝܘܣ ܘܬܪܝܢ ܐܠܟܣܢܕܪ̈ܝܐ ܘܬܪܝܢ ܕܝܘܢܣ̈ܝܐ ܘܛܝܡܬܐܘܣ ܘܪܘܡܘܠܘܣ ܘܦܠܣܝܣ</title>
        <title xml:id="name237-2" xml:lang="fr-x-bhs" source="#bib237-1">Ālōsis</title>
        <title xml:id="name237-3" xml:lang="fr" source="#bib237-1">Aidésios (texte)</title>
        <title xml:id="name237-4" xml:lang="en" source="#bib237-1" srophe:tags="#syriaca-headword">Alosis (text)</title>
        <author ref="http://syriaca.org/person/480" source="#bib237-1" xml:lang="en">Eusebius of Caesarea — <foreign xml:lang="syr">ܐܘܣܒܝܣ ܕܩܣܪܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/237</idno>
        <idno type="number" subtype="BHS">16</idno>
        <idno type="number" subtype="BHO">27</idno>
        <idno type="number" subtype="CPG">3490</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib237-1">ܐܟܘܬܗܝܢ ܕܝܢ ܕܗܠܝܢ ܕܗܘܝ̈ ܒܐܦܝܦܢܣ ܣܗܕܐ ܩܕܝܫܐ ܡܢ ܒܬܪ ܙܒܢ ܩܠܝܠ ܐܦ ܐܚܘܗܝ ܒܪ ܐܒܘܗܝ ܘܒܪ ܐܡܗ: ܕܫܡܗ ܗܘ̣ܐ ܐܠܘܣܣ: ܚܫ ܗܘ̣ܐ ܒܣܗܕܘܬܐ ܕܥܠ ܐܦ̈ܝ ܡܫܝܚܐ ̈ܘܐܬܢܨܚ..</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib237-1">Le même sort que celui du saint martyr Apphien fut réservé un peu plus tard aussi à son frère, fils de son père et de sa mère, dont le nom était Alôsis: il souffrit le martyre pour le Christ et triompha.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib237-1">ܣܗܕܐ ܕܝܢ ܐܚܪܢܐ ܕܒܦܠܣܛܝܢܐ: ܒܬܪ ܐܦܝܦܢܣ: ܐܓܦܝܣ ܠܐܓܘܢܐ ܕܣܗܕܘܬܐ ܐܬܩܪܝ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib237-1">Et l’autre martyr qui fut appelé au combat du martyre en Palestine après Épiphane fut Agapios.</quote>
          </note>
        </noteGrp>
