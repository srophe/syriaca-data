        <title xml:id="name1032-1" xml:lang="syr" source="#bib1032-1" srophe:tags="#syriaca-headword">ܝܫܘܥܣܒܪܢ</title>
        <title xml:id="name1032-2" xml:lang="fr-x-bhs" source="#bib1032-1">Īšōʿsabran</title>
        <title xml:id="name1032-3" xml:lang="fr" source="#bib1032-1">Isho‘sabran (texte)</title>
        <title xml:id="name1032-4" xml:lang="en" source="#bib1032-1" srophe:tags="#syriaca-headword">Ishoʿsabran (text)</title>
        <author ref="http://syriaca.org/person/561" source="#bib1032-1" xml:lang="en">Ishoʿyahb III of Adiabene — <foreign xml:lang="syr">ܝܫܘܥܝܗܒ ܚܕܝܒܝܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1032</idno>
        <idno type="number" subtype="BHS">847</idno>
        <idno type="number" subtype="BHO">451</idno>
        <noteGrp type="prologue">
          <desc xml:lang="en">Prologue</desc>
          <note xml:lang="fr" type="prologue">
            <quote source="#bib1032-1">Même si, pendant tout le temps qui a passé, des éléments adverses ont pu passablement détourner le zèle de ma volonté de fixer par écrit l’image vénérable de l’histoire de la vie du bienheureux Ishô‘sabran…</quote>
          </note>
          <note xml:lang="syr" type="prologue">
            <quote source="#bib1032-1">ܐܦܢ ܣܦܩܐܝܬ ܐܬܡܨܝܘ ܣܩܘܒ̈ܠܐ ܕܥܨܪܘ ܕܝܬܗܘܢ ܠܚܦܝܛܘܬܐ ܕܨܒܝܢܝ ܙܒܢܐ ܗܿܘ ܟܠܗ ܕܥ̣ܒܪ: ܡܢ ܕܠܡܩܒܥ ܒܟܬܒܐ ܨܠܡܐ ܢܟܦܐ ܕܬܫܥܝܬ ܕܘܒܪ̈ܘܗܝ ܕܛܘܒܢܐ ܝܫܘܥܣܒܪܢ...</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1032-1">ܛܘܒܢܐ ܗܟܝܠ ܝܫܘܥܣܒܪܢ ܕܒܡܫܝܚܐ: ܗܿܘ ܕܡܢ ܩܕܝܡ ܡܗܐܢܘܫ ܡܬܩܪܐ ܗܘܐ̣. ܐܝܬܘܗܝ ܗܘܐ ܡܢ ܩܘܪ ܩܪܝܬܐ ܕܒܛܘܪܐ ܕܚܕܝܒ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1032-1">Le bienheureux Ishô‘sabran dans le Christ, qui auparavant s’appelait Mahânoush, était du village de Qour dans la montagne d’Adiabène.</quote>
          </note>
        </noteGrp>
