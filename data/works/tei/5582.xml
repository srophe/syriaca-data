      <bibl xml:id="work-5582" type="lawd:ConceptualWork">
        <title xml:id="name5582-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Discourse 37</title>
        <title xml:id="name5582-3" xml:lang="en" source="#bib5582-2">On the things the exact use of which I have learnt by the knowledge of discernment</title>
        <title xml:id="name5582-2" xml:lang="syr" source="#bib5582-1"><foreign xml:lang="syr">ܥܠ ܐܝܠܝܢ ܕܒܝܕܥܬܐ ܕܦܘܪܫܢܐ ܐܬܝܠܦܬ ܚܬܝܬܘܬܐ ܕܚܫ̈ܚܬܗܝܢ</foreign></title>
        <author ref="http://syriaca.org/person/550" source="#bib5582-1" xml:lang="en">Isaac of Nineveh — <foreign xml:lang="syr">ܐܝܣܚܩ
            ܕܢܝܢܘܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5582</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib5582-1"><foreign xml:lang="syr">ܟܕ ܓܝܪ ܙܒ̈ܢܬܐ ܣܓܝ̈ܐܬܐ ܐܬܢܣܝܬ ܒܕܝܡܝܢܐ ܘܒܕܣܡܠܐ܆</foreign></quote>
          </note>
          <note xml:lang="en" type="incipit">
            <quote source="#bib5582-2">Having been tested many times by things of the right and by things of the left,</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib5582-1"><foreign xml:lang="syr">ܦܝܠܣܘܦܐ ܕܒܝܬ ܐܠܗܐ ܒܣܝܠܣ ܐܡܪ܆ ܐܝܠܝܢ ܕܡܛܠܬܗܝܢ ܨܒܐ ܐܢܬ ܕܬܚܐ܆ ܡܛܠܬܗܝܢ ܕܗܠܝܢ ܠܡܡܬ ܠܐ ܬܬܩܛܥ ܠܟ.</foreign></quote>
          </note>
          <note xml:lang="en" type="explicit">
            <quote source="#bib5582-2">The divine philosopher Basilius says: he that is weak in small things, do not believe that he will be trustworthy in great ones. Do not shrink from dying for the sake of those things for which thou wilt live.</quote>
          </note>
        </noteGrp>
