      <bibl xml:id="work-5524" type="lawd:ConceptualWork">
        <title xml:id="name5524-1" xml:lang="en" srophe:tags="#syriaca-headword" resp="http://syriaca.org">Chronicle</title>
        <title xml:id="name5524-2" xml:lang="en" source="#bib5524-1">A History of the Time of Affliction at Urhai and Amid and Throughout All Mesopotamia</title>
        <title xml:id="name5524-3" xml:lang="syr" source="#bib5524-1">ܡܟܬܒܢܘܬܐ ܕܬܫܥܝܬܐ ܕܙܒܢܐ ܕܐܘܠܨܢܐ ܕܗܘܐ ܒܐܘܪܗܝ ܘܒܐܡܕ ܘܒܟܠܗ ܒܝܬ ܢܗܪܝܢ</title>
        <author ref="http://syriaca.org/person/40" source="#bib5524-1" xml:lang="en">Joshua the Stylite — <foreign xml:lang="syr">ܝܫܘܥ ܐܣܛܘܢܪܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/5524</idno>
        <textLang mainLang="syr"/>
        <date type="original-composition" notBefore="0506" notAfter="0521" source="#bib5524-1">ca. 507</date>
                <noteGrp type="abstract">
          <desc xml:lang="en">Abstract</desc>
          <note type="abstract" xml:lang="en" corresp="http://syriaca.org/nhsl" resp="http://syriaca.org">A chronicle of the period between 494–506 CE in northern <placeName ref="http://syriaca.org/place/1452">Mesopotamia</placeName> (especially <placeName ref="http://syriaca.org/place/78">Urhai/Edessa</placeName> and <placeName ref="http://syriaca.org/place/707">Amid</placeName>), including a description of plague, famine, and the Anastasian War between the Byzantine and Sasanian Empires. It is among the earliest surviving works of Syriac historiography and an important source for the period. Its authorship, possibly pseudonymous, was attributed to <persName ref="http://syriaca.org/person/40">Joshua the Stylite</persName>, thus frequently cited as Pseudo-Joshua. Composed shortly after 506, the Chronicle survives only as a section of the larger and later Chronicle of Zuqnin (ca. 775/6).</note>
          </noteGrp>
        <listBibl type="modernTranslations">
          <head>Modern Translations</head>
          <desc xml:lang="en">This is not a comprehensive list of modern translations related to this work. Further citations may be available through <ref target="http://syriaca.org/cbss">The Comprehensive Bibliography on Syriac Studies</ref>.</desc>
          <bibl xml:id="bib5524-1" type="syriaca:ModernTranslation">
            <title xml:lang="en">The Chronicle of Joshua the Stylite Composed in Syriac A.D. 507</title>
            <ptr target="http://syriaca.org/cbss/E3TUW92I"/>
            <citedRange unit="p">1</citedRange>
            <textLang mainLang="en"/>
          </bibl>
        </listBibl>
      </bibl>
