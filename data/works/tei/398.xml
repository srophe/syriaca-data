            <bibl xml:id="work-398" ana="#syriaca-hagiographic">
        <title xml:id="name398-1" xml:lang="syr" source="#bib398-1" srophe:tags="#syriaca-headword">ܕܘܡܛ</title>
        <title xml:id="name398-2" xml:lang="fr-x-bhs" source="#bib398-1">Dōmeṭ</title>
        <title xml:id="name398-3" xml:lang="fr" source="#bib398-1">Domèce (texte)</title>
        <title xml:id="name398-4" xml:lang="en" source="#bib398-1" srophe:tags="#syriaca-headword">Domitius (text)</title>
        <idno type="URI">http://syriaca.org/work/398</idno>
        <idno type="number" subtype="BHS">178</idno>
        <idno type="number" subtype="BHO">263</idno>
        <noteGrp type="prologue">
          <desc xml:lang="en">Prologue</desc>
          <note xml:lang="fr" type="prologue">
            <quote source="#bib398-1">Histoire de la vie valeureuse de l’homme admirable, Domèce le médecin; comment il s’est converti du paganisme et de l’adoration des idoles à la connaissance de la vérité…</quote>
          </note>
          <note xml:lang="syr" type="prologue">
            <quote source="#bib398-1">ܬܫܥܝܬܐ ܕܕܘܒܪ̈ܐ ܡܝܬܪ̈ܐ ܕܓܒܪܐ ܕܬܕܡܘܪܬܐ ܡܪܝ ܕܘܡܛ ܐܣܝܐ: ܕܐܝܟܢܐ ܡܢ ܚܢܦܘܬܐ ܘܡܢ ܣܓܕܬ ܦܬܟܪ̈ܐ ܠܝܕܥܬܐ ܕܫܪܪܐ ܦܢܐ...</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib398-1">ܒܝܘܡܝ̈ ܗܟܝܠ ܡܕܒܪܢܘܬܗ ܕܘܠܝܣ ܡܠܟܐ: ܟܕ ܕܚ̈ܠܬܐ ܘܦܬܟܪ̈ܐ ܒܟܠܗܝܢ ܡܕܝ̈ܢܬܐ ܕܪ̈ܗܘܡܝܐ ܣܓܝܐܝܢ ܗܘ̣ܘ: ܘܐܦ ܘܠܝܣ ܡܠܟܐ ܥܕܟܝܠ ܒܚܢܦܘܬܐ ܗܘ̣ܐ...</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib398-1">Aux jours du règne de l’empereur Valens, alors que les idoles et les faux dieux se multipliaient dans toutes les villes romaines et que l’empereur Valens était encore dans le paganisme…</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib398-1">ܐܝܠܝܢ ܕܐܟܘܬܗ ܡܪܝܘ ܒܕܘܒܪ̈ܘܗܝ ܫܒܝ̈ܚܐ: ܘܡܢܥܘ ܠܡܠܟܘܬܗ ܕܐܠܗܐ: ܘܒܟܠܙܒܢ ܒܥܿܝܢ ܥܠܝܢ ܪ̈ܚܡܐ ܡܢ ܐܠܗܐ ܡܪܟܠ: ܕܠܗ... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib398-1">Ceux qui comme lui ont imité sa vie glorieuse et son parvenus au royaume de Dieu en tout temps implorent pour nous la miséricorde de Dieu Seigneur de tout; à lui… Amen.</quote>
          </note>
        </noteGrp>
        <listRelation>
          <relation ref="syriaca:commemorates" active="http://syriaca.org/work/398" source="#bib398-1" passive="http://syriaca.org/person/1213">
