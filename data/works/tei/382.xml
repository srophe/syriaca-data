        <title xml:id="name382-3" xml:lang="fr" source="#bib382-1">Basile le Grand (texte)</title>
        <title xml:id="name382-4" xml:lang="en" source="#bib382-1" srophe:tags="#syriaca-headword">Basil the Great (text)</title>
              <author ref="http://syriaca.org/person/2784" source="#bib382-1" role="attributed" xml:lang="en">Amphilochios of Ikonion — <foreign xml:lang="syr">ܐܡܦܝܠܝܟܝܘܣ ܕ ܐܝܩܘܢܝܘܢ</foreign>
        </author>
