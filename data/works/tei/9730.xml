        <idno type="number" subtype="Bekker">24a10–70b38</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib9730-1">ܩܕܡܝܐܝܬ ܢܐܡܪ ܡܛܠ ܡܘܢ ܘܕܡܿܢ ܐܝܬܝܗܿ ܡܬܚܫܒܢܘܬܐ. ܡܛܠ ܡܚܘܝܢܘܬܐ ܘܕܝܕܥܬܐ ܡܚܘܝܢܝܬܐ</quote>
          </note>
          <note xml:lang="grc" type="incipit">
            <quote source="#bib9730-3">Πρῶτον εἰπεῖν περὶ τί καὶ τίνος ἐστὶν ἡ σκέψις, ὅτι περὶ ἀπόδειξιν καὶ ἐπιστήμης ἀποδεικτικῆς</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib9730-1">ܠܗܿܘ ܕܝܢ ܕܒܝܬ ܐܠܦ ܒܟܠ ܡܕܡ܆ ܘܠܝܬ ܠܝܬܝܪ̈ܐ܆ ܐܠܐ ܗܦܟܐ. ܐܢܕܝܢ ܠܐ܆ ܠܐ ܐܝܬܘܗܝ ܫܘܘܕܥܐ ܚܕ ܕܚܕ</quote>
          </note>
          <note xml:lang="grc" type="explicit">
            <quote source="#bib9730-3">ᾧ δὲ τὸ Β, τὸ Α παντὶ καὶ οὐ πλείοσιν, ἀλλ’ ἀντιστρέφει· εἰ δὲ μή, οὐκ ἔσται ἓν ἑνὸς σημεῖον.</quote>
          </note>
        </noteGrp>
