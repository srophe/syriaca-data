            <bibl xml:id="work-809" ana="#syriaca-hagiographic">
        <title xml:id="name809-1" xml:lang="syr" source="#bib809-1" srophe:tags="#syriaca-headword">ܡܣܟܢܐ</title>
        <title xml:id="name809-2" xml:lang="fr-x-bhs" source="#bib809-1">mesḵēnā´</title>
        <title xml:id="name809-3" xml:lang="fr" source="#bib809-1">Pauvre (texte)</title>
        <title xml:id="name809-4" xml:lang="en" source="#bib809-1" srophe:tags="#syriaca-headword">A Poor One (text)</title>
        <author ref="http://syriaca.org/person/74" source="#bib809-1" xml:lang="en">John of Ephesus — <foreign xml:lang="syr">ܝܘܚܢܢ ܕܐܦܣܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/809</idno>
        <idno type="number" subtype="BHS">600</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib809-1">ܟܕ ܗܟܝܠ ܒܡܬܚܬܝܘܬܐ ܕܙܒ̈ܢܝܢ ܘܒܕܘܘܕܐ ܕܝܡ̈ܡܬܢ ܡܬܒܩܐ ܐܢܐ̣. ܛܒ ܬܡܝܗ ܐܢܐ. ܕܐܝܟܢܐ ܠܐ ܣܠܩܐ ܥܠ ܪܥܝܢܢ. ܡܠܬܐ ܢܒܝܝܬܐ ܗܢܘ ܕܝܢ ܐܠܗܝܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib809-1">Considérant la bassesse de nos temps et la perturbation de nos jours, je m’étonne de ce que ne monte pas à notre esprit la parole prophétique, c’est-à-dire divine.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib809-1">ܘܗܟܢܐ ܫܢܝ ܘܐܙܠ ܒܬܪ ܬܪ̈ܝܢ ܝܘܡ̈ܝܢ̣. ܟܕ ܠܐ ܫܡܗ ܘܠܐ ܥܠ ܕܘܒܪ̈ܐ ܐܚܪ̈ܢܐ ܐܬܛܦܝܣ ܕܢܘܕܥܢ. ܘܦܫܬ ܟܕ ܥܕܡܐ ܠܗܫܐ̣. ܒܟܘܠ ܥܕܢ ܬܗܝܪ ܒܓܒܪܐ ܕܐܠܗܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib809-1">Et ainsi il s’en alla et partit après deux jours, sans s’être laissé persuader de nous faire savoir son nom ou d’autres modes de vie. Et je restai jusqu’à maintenant dans l’admiration pour cet homme de Dieu à tout moment.</quote>
          </note>
        </noteGrp>
