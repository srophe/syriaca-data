            <bibl xml:id="work-315" ana="#syriaca-hagiographic" type="lawd:ConceptualWork">
        <title xml:id="name315-1" xml:lang="syr" source="#bib315-1" srophe:tags="#syriaca-headword">ܐܦܪܝܡ</title>
        <title xml:id="name315-2" xml:lang="fr-x-bhs" source="#bib315-1">ʾAfrēm</title>
        <title xml:id="name315-3" xml:lang="fr" source="#bib315-1">Éphrem (texte)</title>
        <title xml:id="name315-4" xml:lang="en" source="#bib315-1" srophe:tags="#syriaca-headword">Ephrem (text)</title>
        <idno type="URI">http://syriaca.org/work/315</idno>
        <idno type="number" subtype="BHS">95</idno>
        <idno type="number" subtype="BHO">269</idno>
        <textLang mainLang="syr"/>
        <noteGrp type="prolog">
          <desc xml:lang="en">Prolog</desc>
          <note xml:lang="fr" type="prolog">
            <quote source="#bib315-1">Avec confiance dans la force de notre Seigneur Jésus-Christ et dans l’appui et le secours de ses prières, nous commençons l’histoire de la vie de saint Mâr Éphrem, depuis le début jusqu’à la fin de sa vie dans la ville d’Édesse en Mésopotamie.</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib315-1">ܗܘ ܕܝܢ ܩܕܝܫܐ ܡܪܝ ܐܦܪܝܡ ܐܝܬܘܗܝ ܗܘ̣ܐ ܒܓܢܣܗ ܣܘܪܝܝܐ. ܐܒܘܗܝ ܕܝܢ ܐܝܬܘܗܝ ܗܘ̣ܐ ܡܢ ܢܨܝܒܝܢ ܕܒܝܬ ܬܚܘ̈ܡܐ: ܥܕܟܝܠ ܓܝܪ ܠܐ ܫܩܝܠܐ ܗܘ̣ܬ ܠܦܪ̈ܣܝܐ: ܐܡܗ ܕܝܢ ܐܝܬܝܗܿ ܗܘ̣ܬ ܡܢ ܐܡܕ ܡܕܝܢܬܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib315-1">Saint Mar Éphrem était par sa famille Syrien. Son père provenait de Nisibe aux confins du pays, non encore prise par les Perses; sa mère provenait de la ville d’Amid.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib315-1">ܘܡܢ ܕܐܬܬܣܝܡ ܩܠܝܠ ܙܒܢܐ: ܐܦܩܘܗܝ ܒܢܝ̈ ܡܕܝܢܬܐ: ܘܣܡܘܗܝ ܒܡܥܪܬܐ: ܐܝܟܐ ܕܐܦܣܩ̈ܘܦܐ ܕܡܕܝܢܬܐ ܣܝܡܝܢ ܗܘ̣ܘ: ܘܗܐ ܡܬܝܩܪ ܘܡܣܬܓܕ ܡܢ ܟܠܗܘܢ ܒܢܝ̈ܢܫܐ ܬܡܢ. ܕܒܨ̈ܠܘܬܗ ܕܩܕܝܫܐ ܡܪܝ ܐܦܪܝܡ: ܥܡ ܕܩܕܝܫܐ ܡܪܝ ܒܣܠܝܘܣ: ܘܕܟܠܗܘܢ.... ܐܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib315-1">Peu de temps après qu’il y eut été placé, ses concitoyens l’en retirèrent et le placèrent dans la caverne où reposaient les évêques de la ville; et voilà qu’il est honoré et révéré par tous les gens de là-bas. Que par les prières de saint Mar Éphrem et de saint Basile et de tous… Amen.</quote>
          </note>
        </noteGrp>
