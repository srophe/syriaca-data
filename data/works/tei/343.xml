        <title xml:id="name343-1" xml:lang="syr" source="#bib343-1" srophe:tags="#syriaca-headword">ܝܥܩܘܒ</title>
        <title xml:id="name343-2" xml:lang="fr-x-bhs" source="#bib343-1">Yaʿqōḇ</title>
        <title xml:id="name343-3" xml:lang="fr" source="#bib343-1">Jacques de Nisibe (texte)</title>
        <title xml:id="name343-4" xml:lang="en" source="#bib343-1" srophe:tags="#syriaca-headword">Jacob of Nisibis (text)</title>
        <author ref="http://syriaca.org/person/781" source="#bib343-1" xml:lang="en">Theodoret of Cyrrhus — <foreign xml:lang="syr">ܬܐܕܘܪܝܛܘܣ ܕܩܘܪܘܣ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/343</idno>
        <idno type="number" subtype="BHS">123</idno>
        <idno type="number" subtype="BHO">406</idno>
        <noteGrp type="prolog">
          <desc xml:lang="en">Prolog</desc>
          <note xml:lang="fr" type="prolog">
            <quote source="#bib343-1">Moïse, législateur de Dieu, celui qui a découvert le fond de la mer, qui a inondé la terre aride, et qui a accompli beaucoup d’autres choses admirables, a aussi écrit les vies des saints qui furent dans les premiers temps.</quote>
          </note>
        </noteGrp>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib343-1">ܢܨܝܒܝܢ ܡܕܝܢܬܐ ܐܝܬܝܗܿ ܒܝܬ ܬܚܘ̈ܡܐ ܕܡܠܟܘܬܐ ܕܪ̈ܗܘܡܝܐ ܘܕܦܪ̈ܣܝܐ: ܗܝܿ ܕܡܢ ܩܕܝܡ ܡܕܐܬܐ ܠܪ̈ܗܘܡܝܐ ܡܣܩܐ ܗܘ̣ܬ: ܘܬܚܝܬ ܫܘܠܛܢܗܘܢ ܐܝܬܝܗܿ ܗܘ̣ܬ. ܡܢܗܿ ܕܗܕܐ ܐܝܬܘܗܝ ܗܘ̣ܐ ܛܘܒܢܐ ܝܥܩܘܒ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib343-1">Nisibe est une ville aux confins des Empires romain et perse, qui auparavant payait tribut aux Romains et se trouvait sous leur pouvoir. De cette ville était le bienheureux Jacques.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib343-1">Et avec une grande gloire il sortit de ce monde et partit vers Dieu. Telle fut la vie de l’illustre et bienheureux Jacques, plein de toutes les grâces, et par elles il reçut la couronne de la victoire de notre Seigneur Jésus-Christ qu’il aima et dont il garda les commandements; à lui gloire… Amen.</quote>
          </note>
        </noteGrp>
