        <title xml:id="name562-1" xml:lang="syr" source="#bib562-1" srophe:tags="#syriaca-headword">ܐܝܣܚܩ ܘܕܕܐ</title>
        <title xml:id="name562-2" xml:lang="fr-x-bhs" source="#bib562-1">ʾĪsḥāq w-Dāḏā</title>
        <title xml:id="name562-3" xml:lang="fr" source="#bib562-1">Isaac et Dada (texte)</title>
        <title xml:id="name562-4" xml:lang="en" source="#bib562-1" srophe:tags="#syriaca-headword">Isaac and Dada (text)</title>
        <author ref="http://syriaca.org/person/58" source="#bib562-1" xml:lang="en">Zechariah Rhetor — <foreign xml:lang="syr">ܙܟܪܝܐ ܡܠܝܠܐ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/562</idno>
        <idno type="number" subtype="BHS">342</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib562-1">ܐܝܣܚܩ ܡܠܦܢܐ ܕܒܝܬ ܣܘܪ̈ܝܐܐ ܐܬܚܙܝ̣. ܕܐܝܬܘܗܝ ܗܘܐ ܡܢ ܚܕ ܡܢ ܥܘ̈ܡܪܐ. ܕܕܝܪܐ ܕܡܥ̈ܪܒܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib562-1">Apparut Isaac, docteur de Syrie, qui provenait d’un des couvents, le monastère des Occidentaux.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib562-1">ܘܐܝܬ ܠܗ ܐܦ ܠܗܢܐ ܕܚܙܐ ܠܢ. ܝܬܝܪ ܚܣܝܪ ܬܠܬܡܐܐ ܫܪ̈ܒܐ ܫܠ ܟܘܠ ܨܒܘ ܡܢ ܟ̈ܬܒܐ ܐ̈ܠܗܝܐ ܘܥܠ ܩ̈ܕܝܫܐ ܘܡܕܪ̈ܫܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib562-1">Et à lui sont aussi plus ou moins trois cent livres sur toutes les choses de livres divins, sur les saints et sur les madraché.</quote>
          </note>
        </noteGrp>
