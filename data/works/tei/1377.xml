        <author ref="http://syriaca.org/person/494" source="#bib1377-1" xml:lang="en">Gabriel Qamsa — <foreign xml:lang="syr">ܓܒܪܝܠ</foreign>
        </author>
        <idno type="URI">http://syriaca.org/work/1377</idno>
        <idno type="number" subtype="BHS">1242</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1377-1">ܣܓܕܝܢܢ ܠܚܕܐ ܐܘܣܝܐ. ܒܐܝܘܦܣܛܣܝܘܣ ܚܕ ܘܕܝܐ. ܕܐܩܠܣܝܐ ܡܠܓܩܐ ܐܪܬܕܘܟܣܝܐ. ܐܝܟ ܦܘܓܪܦܐ ܕܒܐܘܢܓܠܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1377-1">Nous adorons l’unique essence en une hypostase divine de l’Église ??? orthodoxe selon ce qui est écrit dans l’Évangile.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1377-1">ܕܘܟܣܐ ܠܐܒܐ ܐܬܐܘܣ. ܫܘܒܚܐ ܠܒܪܐ ܗܘܡܐܣܝܘܣ. ܬܘܕܝ ܠܪܘܚܐ ܐܓܝܘܣ. ܘܥܠ ܟܢܫܢ ܚܢܢܗ ܢܦܪܘܣ. ܠܥܠܡ ܥܠܡܝܢ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1377-1">Gloire au Père Dieu, gloire au Fils consubstantiel et action de grâce à l’Esprit Saint; et sur notre assemblée qu’il répande sa tendresse pour les siècles des siècles.</quote>
          </note>
        </noteGrp>
