        <title xml:id="name826-1" xml:lang="syr" source="#bib826-1" srophe:tags="#syriaca-headword">ܫܡܥܘܢ ܟܬܘܒܐ</title>
        <title xml:id="name826-2" xml:lang="fr-x-bhs" source="#bib826-1">Šemʿōn ḵāṯōḇā</title>
        <title xml:id="name826-3" xml:lang="fr" source="#bib826-1">Syméon le Scribe (texte)</title>
        <title xml:id="name826-4" xml:lang="en" source="#bib826-1" srophe:tags="#syriaca-headword">Simeon the Scribe (text)</title>
        <author xml:lang="fr" source="#bib826-1" ref="http://syriaca.org/person/74">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Yuḥanon</forename>
                        <addName type="untagged-title" sort="2">of <placeName ref="http://syriaca.org/place/623">Ephesus</placeName>
                        </addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܝܘܚܢܢ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܦܣܘܣ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Jean</forename>
                        <addName type="untagged-title">d’Éphèse</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/826</idno>
        <idno type="number" subtype="BHS">617</idno>
        <idno type="number" subtype="BHO">870</idno>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib826-1">ܘܦܩܕ ܕܢܙܕܒܢ ܟܠ ܕܐܝܬ ܠܗ ܘܢܬܝܗܒ ܠܡ̈ܣܟܢܐ. ܘܗܟܢܐ ܗܘܬ. ܘܢܦܩ ܡܢ ܥܠܡܐ ܗܢܐ ܐܝܟ ܦܘܩܕܢܗ ܕܐܠܗܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib826-1">Et il ordonna de vendre tout ce qu’il avait et de le donner aux pauvres et ce fut fait. Et il sortit de ce monde selon l’ordre de Dieu.</quote>
          </note>
        </noteGrp>
