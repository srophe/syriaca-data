        <title xml:id="name325-1" xml:lang="syr" source="#bib325-1" srophe:tags="#syriaca-headword">ܚܢܢܝܐ</title>
        <title xml:id="name325-2" xml:lang="fr-x-bhs" source="#bib325-1">Ḥananyā</title>
        <title xml:id="name325-3" xml:lang="fr" source="#bib325-1">Ananie d’Arbèles (texte)</title>
        <title xml:id="name325-4" xml:lang="en" source="#bib325-1" srophe:tags="#syriaca-headword">Ananias of Arbela (text)</title>
        <idno type="URI">http://syriaca.org/work/325</idno>
        <idno type="number" subtype="BHS">105</idno>
        <idno type="number" subtype="BHO">372</idno>
        <idno type="number" subtype="CPG">0</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib325-1">ܒܫܢܬ ܫܬ ܕܪܕܘܦܝܢ: ܐܬܬܚܕ ܗܘ̣ܐ ܚܢܢܝܐ: ܓܒܪܐ ܒܪ ܥܠܡܐ ܡܢ ܐܝܕܝ̈ ܐܕܘܪܫܓ ܡܘܗܦܛܐ: ܘܢܦܠ ܗܘ̣ܐ ܒܬܫܢܝ̈ܕܐ ܣܓܝ̈ܐܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib325-1">En la sixième année de notre persécution, le laïc Hananie fut pris par le chef des mages Adôrshag, et il fut soumis à de nombreux supplices.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib325-1">ܘܟܕ ܐܡܪ ܗܠܝܢ ܛܘܒܢܐ: ܢܦܫܗ ܫܢܝܬ ܡܢܗ. ܐܬܟܠܠ ܕܝܢ ܛܘܒܢܐ ܒܬܪܥܣܪܐ ܒܟܢܘܢ ܒܕܣܗܪܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib325-1">Et quand le bien heureux eut dit cela, son âme le quitta. Le bienheureux fut couronné le douze du mois lunaire de Kanôn.</quote>
          </note>
        </noteGrp>
