            <bibl xml:id="work-1244" ana="#syriaca-hagiographic">
        <title xml:id="name1244-1" xml:lang="syr" source="#bib1244-1" srophe:tags="#syriaca-headword">ܬܐܘܡܐ</title>
        <title xml:id="name1244-2" xml:lang="fr-x-bhs" source="#bib1244-1">Tōmā</title>
        <title xml:id="name1244-3" xml:lang="fr" source="#bib1244-1">Thomas apôtre (texte)</title>
        <title xml:id="name1244-4" xml:lang="en" source="#bib1244-1" srophe:tags="#syriaca-headword">Thomas the Apostle (text)</title>
        <author xml:lang="fr" source="#bib1244-1" ref="http://syriaca.org/person/1050">
                    <persName xml:lang="en-x-gedsh">
                        <forename sort="1">Gewargis</forename>
                        <addName type="untagged-title" sort="2">of Alqosh</addName>
                    </persName> — <persName xml:lang="syr">
                        <forename sort="1">ܓܝܘܪܓܝܣ</forename>
                        <addName type="untagged-title" sort="2">ܕܐܠܩܘܫ</addName>
                    </persName> (<persName xml:lang="fr">
                        <forename>Georges</forename>
                        <addName type="untagged-title">d’Alqosh</addName>
                    </persName>)</author>
        <idno type="URI">http://syriaca.org/work/1244</idno>
        <idno type="number" subtype="BHS">1086</idno>
        <idno type="number" subtype="BHO">1222</idno>
        <noteGrp type="incipit">
          <desc xml:lang="en">Incipit</desc>
          <note xml:lang="syr" type="incipit">
            <quote source="#bib1244-1">ܛܘܒܝܟ ܫܠܝܚܐ ܩܕܝܫܐ: ܐܘ ܡܪܝ ܬܐܘܡܐ ܢܨܝܚܐ. ܕܙܟܝܬܝܗܝ ܒܚܝܠܟ ܠܒܝܫܐ: ܘܢܨܚܬ ܒܫܡ ܡܪܝܐ ܡܫܝܚܐ.</quote>
          </note>
          <note xml:lang="fr" type="incipit">
            <quote source="#bib1244-1">Heureux es-tu, saint apôtre, Mâr Thomas le vaillant, toi qui as vaincu le Mauvais par ta force et a triomphé au nom du Seigneur le Christ.</quote>
          </note>
        </noteGrp>
        <noteGrp type="explicit">
          <desc xml:lang="en">Explicit</desc>
          <note xml:lang="syr" type="explicit">
            <quote source="#bib1244-1">ܒܨܠܘܬܟ ܫܠܝܚܐ ܙܗܝܐ: ܢܬܦܪܩ ܡܢ ܝܕ ܫܒܝܐ. ܣܛܢܐ ܣܢܐ ܕܟܝ̈ܐ: ܘܢܫܬܘܐ ܒܛܝܒܘ ܕܝܠܗ ܡܪܝܐ. ܠܒܘܣܡ ܥܠܡܐ ܥܬܝܕܝܐ.</quote>
          </note>
          <note xml:lang="fr" type="explicit">
            <quote source="#bib1244-1">À ta prière, glorieux apôtre, puissions-nous être sauvés de la main du voleur Satan, ennemi des purs, et être jugés dignes par la grâce du Seigneur de la douceur du monde à venir.</quote>
          </note>
        </noteGrp>
        <listRelation>
                    <relation ref="syriaca:commemorates" active="http://syriaca.org/work/1244" passive="http://syriaca.org/person/2123" source="#bib1244-1"/>
                </listRelation>
